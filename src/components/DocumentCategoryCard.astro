---
import ArchiveFilterBar from './ArchiveFilterBar.astro';
import type { DocumentItem } from '../lib/documents';

interface Props {
  id: string;
  name: string;
  badge: string;
  items: DocumentItem[];
  latestIds: string[];
  defaultOpen?: boolean;
  revealClass?: string;
  hasYearFilter?: boolean;
  hasMonthFilter?: boolean;
  yearOptions?: { value: string; label: string }[];
  monthOptions?: { value: string; label: string }[];
  perPage?: number;
}

const {
  id,
  name,
  badge,
  items,
  latestIds,
  defaultOpen = false,
  revealClass = '',
  hasYearFilter = false,
  hasMonthFilter = false,
  yearOptions = [],
  monthOptions = [],
  perPage = 10,
} = Astro.props;

const showPagination = id === 'ktp-inleng' && items.length > perPage;
---

<div class={`doc-cat-card reveal ${revealClass} ${defaultOpen ? 'is-open' : ''}`} id={`cat-${id}`} data-doc-category={id}>
  <div class="bg-navy border border-gold/20 rounded overflow-hidden">

    <button
      type="button"
      class="doc-cat-header w-full flex items-center justify-between px-5 py-4 border-b border-gold/10 text-left"
      aria-expanded={defaultOpen}
      aria-controls={`body-${id}`}
      data-doc-cat-toggle={id}
    >
      <div class="flex items-center gap-2 min-w-0">
        <svg class="doc-cat-chevron w-4 h-4 text-gold/50 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
        <div class="min-w-0">
          <h2 class="font-display text-gold-light font-semibold text-base">{name}</h2>
          <p class="font-body text-[0.6rem] text-gold-pale/40 tracking-widest uppercase mt-0.5">{badge}</p>
        </div>
      </div>
      <span class="font-body text-[0.6rem] tracking-widest uppercase text-gold/40 flex-shrink-0 ml-3 doc-cat-count" data-count-for={id}>
        {items.length} files
      </span>
    </button>

    <div class="doc-cat-body" id={`body-${id}`} hidden={!defaultOpen}>
      {(hasYearFilter || hasMonthFilter) && (
        <div class="archive-filters-row px-5 pt-4 pb-0 doc-cat-filters" data-filters-for={id}>
          {hasYearFilter && yearOptions.length > 0 && (
            <ArchiveFilterBar
              id={`${id}-year-filter`}
              label="Year"
              options={yearOptions}
              class="doc-cat-year-filter"
            />
          )}
          {hasMonthFilter && monthOptions.length > 0 && (
            <ArchiveFilterBar
              id={`${id}-month-filter`}
              label="Month"
              allLabel="All months"
              options={monthOptions}
              class="doc-cat-month-filter"
            />
          )}
        </div>
      )}

      <div class="px-5 py-3 doc-cat-items" id={`items-${id}`} data-per-page={perPage}>
        {items.slice(0, perPage).map((item) => (
          <div
            class="doc-item group doc-row"
            data-doc-id={item.id}
            data-year={item.year ?? ''}
            data-month={item.month ?? ''}
            data-pinned={item.pinned ? '1' : '0'}
            data-name={item.name.toLowerCase()}
            data-date={item.date}
          >
            <div class="flex items-center gap-2.5 min-w-0 flex-1">
              <svg class="w-4 h-4 text-gold/40 flex-shrink-0 group-hover:text-gold/70 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <div class="min-w-0">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="font-body text-gold-pale/80 text-sm truncate max-w-full">{item.name}</span>
                  {item.pinned && (
                    <span class="doc-badge doc-badge-pinned">Pinned</span>
                  )}
                  {latestIds.includes(item.id) && !item.pinned && (
                    <span class="doc-badge doc-badge-new">New</span>
                  )}
                </div>
                <span class="font-body text-[0.6rem] text-gold-pale/30 tracking-wide">{item.date}</span>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0 ml-2">
              <a
                href={item.url}
                target="_blank"
                rel="noopener"
                class="doc-action-btn"
                title="Preview PDF"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <span class="hidden sm:inline">Preview</span>
              </a>
              <a
                href={item.url}
                download
                class="doc-action-btn"
                title="Download PDF"
              >
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                <span class="hidden sm:inline">Download</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="px-5 pb-3">
        <p class="hidden font-body text-xs text-gold-pale/40 text-center py-2 doc-cat-empty" data-empty-for={id}>
          No documents match your filters.
        </p>
      </div>

      {showPagination && (
        <div class="px-5 pb-4 doc-cat-pagination-wrap" data-pagination-wrap={id}>
          <div class="flex items-center justify-between">
            <span class="font-body text-[0.65rem] text-gold-pale/30 tracking-wide">
              Page <span class="doc-current-page" data-cat={id}>1</span> of <span class="doc-total-pages" data-cat={id}>1</span>
            </span>
            <div class="flex gap-1.5 doc-pagination" data-pagination={id}></div>
          </div>
        </div>
      )}
    </div>

  </div>
</div>
