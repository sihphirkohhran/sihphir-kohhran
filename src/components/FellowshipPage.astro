---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ownedBy } from '../lib/content-ownership';
import { buildOwnerAlbums, buildOwnerDocuments } from '../lib/owner-archives';
import FellowshipCommitteeArchive from './FellowshipCommitteeArchive.astro';
import FellowshipGalleryArchive from './FellowshipGalleryArchive.astro';
import FellowshipDocumentArchive from './FellowshipDocumentArchive.astro';
import type { FellowshipGroupPhoto } from '../lib/fellowship';
import { getPageSettings } from '../lib/page-settings';

interface Props {
  ownerSlug: string;
  name: string;
  abbr: string;
  subtitle: string;
  history: string;
  historyFull?: string;
  logo?: string;
  groupPhotos?: FellowshipGroupPhoto[];
  officeBearers: { role: string; name: string; photo?: string; phone?: string; email?: string }[];
  committeeMembers: { name: string; role?: string; photo?: string; notes?: string }[];
  relatedPhotos?: { src: string; caption?: string }[];
  relatedDocuments?: { name: string; url: string; category?: string }[];
  accentColor?: string;
  variant?: 'ktp' | 'default';
}

const {
  ownerSlug,
  name,
  abbr,
  subtitle,
  history,
  historyFull = '',
  logo,
  groupPhotos = [],
  officeBearers,
  committeeMembers,
  relatedPhotos = [],
  relatedDocuments = [],
  accentColor = 'from-navy to-navy-light',
  variant = 'default',
} = Astro.props;

const defaultGroupYear = groupPhotos[0]?.year;
const isKtp = variant === 'ktp';
const [galleryEntries, documentEntries] = await Promise.all([getCollection('gallery'), getCollection('documents')]);
const albums = buildOwnerAlbums(ownedBy(galleryEntries, ownerSlug), ownerSlug);
const documents = buildOwnerDocuments(ownedBy(documentEntries, ownerSlug), ownerSlug);
const ui=await getPageSettings('fellowship',{hero_caption:'Sihphir Presbyterian Kohhran',hero_title:name,hero_subtitle:subtitle,history_title:'History',office_bearers_title:'Office Bearers',members_title:'Committee Members',gallery_title:'Gallery',documents_title:'Documents',search_placeholder:'Search fellowships…',empty_message:'No fellowships found',back_button:'All Fellowships'});
---

<BaseLayout title={`${name} — Sihphir Presbyterian Kohhran`} activePage="fellowship">

  <!-- Hero -->
  <div class={`fellowship-hero ${isKtp ? 'fellowship-hero-ktp' : 'bg-navy border-b-2 border-gold'} px-4 pt-8 pb-6 relative overflow-hidden`}>
    <div class={`absolute inset-0 ${isKtp ? 'opacity-[0.10]' : 'opacity-[0.04]'}`}
      style="background-image: repeating-linear-gradient(45deg, #b8953f 0px, #b8953f 1px, transparent 1px, transparent 28px);">
    </div>
    <div class="relative z-10 max-w-2xl mx-auto">
      <a href="/fellowship" class={`inline-flex items-center gap-1 font-body text-[0.65rem] tracking-widest uppercase transition-colors mb-4 ${isKtp ? 'text-[#173B53] hover:underline' : 'text-gold/50 hover:text-gold'}`}>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        {ui.back_button}
      </a>
      <div class="flex items-center gap-4">
        <div class={`w-14 h-14 rounded-full border-2 flex items-center justify-center flex-shrink-0 overflow-hidden ${isKtp ? 'border-[#173B53]/40 bg-white/40' : 'border-gold/60 bg-gold/[0.07]'}`}>
          {logo ? (
            <img src={logo} alt={`${name} logo`} class="w-full h-full object-cover" loading="lazy" />
          ) : (
            <span class={`font-display font-bold text-xl ${isKtp ? 'text-[#173B53]' : 'text-gold-light'}`}>{abbr}</span>
          )}
        </div>
        <div>
          <h1 class={`font-display text-xl sm:text-2xl font-semibold ${isKtp ? 'text-[#173B53]' : 'text-white'}`}>{name}</h1>
          <p class={`font-body text-xs tracking-widest uppercase mt-0.5 ${isKtp ? 'text-[#173B53]' : 'text-gold-pale/50'}`}>{ui.hero_subtitle}</p>
        </div>
      </div>
    </div>
  </div>

  <div class={`fellowship-tab-shell ${isKtp ? 'fellowship-tabs-ktp' : ''}`}>
    <div class="max-w-6xl mx-auto px-4">
      <div class="fellowship-tablist" role="tablist" aria-label={`${name} sections`}>
        {(['history','committee','gallery','documents'] as const).map((tab, index) => (
          <button type="button" role="tab" id={`fellowship-tab-${tab}`} aria-controls={`fellowship-panel-${tab}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-fellowship-tab={tab}>
            {tab === 'history' ? 'About Us' : tab === 'committee' ? 'Committee' : tab === 'gallery' ? 'Gallery' : 'Documents'}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8" style={isKtp ? '--owner-focus:#29B9F2' : undefined}>
    <section id="fellowship-panel-history" role="tabpanel" aria-labelledby="fellowship-tab-history" tabindex="0" class="space-y-8" data-fellowship-panel="history">

    <!-- History -->
    {(history?.trim() || historyFull?.trim()) && <div class="reveal">
      <div class="gold-divider mb-4"><h2>About Us</h2></div>
      <div class="fellowship-about-copy border-l-4 border-gold rounded-r bg-ivory pl-5 pr-4 py-4">
        {history?.trim() && <p class="font-body text-base text-gray-700 leading-relaxed mb-3">{history}</p>}
        {historyFull && (
          <>
            <div id="history-full" class="content-page-body font-body text-sm text-gray-700 leading-relaxed mb-3 hidden">
              <Fragment set:html={historyFull} />
            </div>
            <button id="history-btn" class="font-body text-[0.7rem] tracking-[0.1em] uppercase text-navy border-b border-navy/40 hover:border-navy transition-colors pb-0.5">
              Read More →
            </button>
          </>
        )}
      </div>
    </div>}
    {groupPhotos.length > 0 && (
      <section class="reveal fellowship-group-section" data-fellowship-name={name}>
        <div class="fellowship-group-panel">
          {groupPhotos.length > 1 && (
            <div class="fellowship-group-controls">
              <label class="font-body text-[0.65rem] tracking-widest uppercase text-gray-500 block mb-1.5" for="fellowship-year-select">
                Year
              </label>
              <select
                id="fellowship-year-select"
                class="archive-filter-select w-full sm:w-auto min-w-[140px] border border-navy/20 rounded px-3 py-2.5 font-body text-sm text-navy bg-ivory focus:outline-none focus:border-navy/60 transition-colors"
              >
                {groupPhotos.map((g) => (
                  <option value={String(g.year)} selected={g.year === defaultGroupYear}>{g.year}</option>
                ))}
              </select>
            </div>
          )}
          <figure class="fellowship-group-figure">
            {groupPhotos.map((g) => (
              <img
                src={g.photo}
                alt={`${name} group photo ${g.year}`}
                class={`fellowship-group-photo ${g.year === defaultGroupYear ? '' : 'hidden'}`}
                data-fellowship-year={g.year}
                loading="eager"
                data-lightbox
                data-lightbox-src={g.photo}
              />
            ))}
          </figure>
        </div>
      </section>
    )}
    </section>
    <section id="fellowship-panel-committee" role="tabpanel" aria-labelledby="fellowship-tab-committee" tabindex="0" data-fellowship-panel="committee" hidden>
      <FellowshipCommitteeArchive fellowshipSlug={ownerSlug} />
    </section>
    <section id="fellowship-panel-gallery" role="tabpanel" aria-labelledby="fellowship-tab-gallery" tabindex="0" data-fellowship-panel="gallery" hidden>
      <FellowshipGalleryArchive albums={albums} fellowshipSlug={ownerSlug} />
    </section>
    <section id="fellowship-panel-documents" role="tabpanel" aria-labelledby="fellowship-tab-documents" tabindex="0" data-fellowship-panel="documents" hidden>
      <FellowshipDocumentArchive documents={documents} fellowshipSlug={ownerSlug} />
    </section>
  </div>

  <div class="fellowship-lightbox" id="fellowship-lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer"><button type="button" aria-label="Close photo viewer">×</button><img src="" alt="" /></div>

</BaseLayout>

<script>
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-fellowship-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-fellowship-panel]'));
  const validTabs = new Set(['history', 'committee', 'gallery', 'documents']);
  const tabFromUrl = () => { const params = new URL(window.location.href).searchParams; const value = params.get('tab'); if (value !== null) return validTabs.has(value) ? value : 'history'; if (params.has('album')) return 'gallery'; if (params.has('document')) return 'documents'; return 'history'; };
  const selectTab = (tab: string, updateHistory = false, focus = false) => {
    const selected = validTabs.has(tab) ? tab : 'history';
    tabButtons.forEach(button => {
      const active = button.dataset.fellowshipTab === selected;
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
      if (active && focus) button.focus();
    });
    panels.forEach(panel => { panel.hidden = panel.dataset.fellowshipPanel !== selected; });
    if (updateHistory && tabFromUrl() !== selected) {
      const url = new URL(window.location.href);
      if (selected === 'history') url.searchParams.delete('tab');
      else url.searchParams.set('tab', selected);
      if (selected !== 'committee') { url.searchParams.delete('committeeId'); url.searchParams.delete('committeeYear'); }
      if (selected !== 'gallery') url.searchParams.delete('album');
      if (selected !== 'documents') url.searchParams.delete('document');
      window.history.pushState({ fellowshipTab: selected }, '', url);
    }
    if (updateHistory) window.dispatchEvent(new Event('fellowship:location'));
  };
  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => selectTab(button.dataset.fellowshipTab || 'history', true));
    button.addEventListener('keydown', event => {
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % tabButtons.length;
      else if (event.key === 'ArrowLeft') next = (index - 1 + tabButtons.length) % tabButtons.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabButtons.length - 1;
      else return;
      event.preventDefault();
      selectTab(tabButtons[next].dataset.fellowshipTab || 'history', true, true);
    });
  });
  window.addEventListener('popstate', () => selectTab(tabFromUrl()));
  selectTab(tabFromUrl());

  const btn = document.getElementById('history-btn');
  const full = document.getElementById('history-full');
  let open = false;
  btn?.addEventListener('click', () => {
    open = !open;
    full?.classList.toggle('hidden', !open);
    if (btn) btn.textContent = open ? '← Read Less' : 'Read More →';
  });

  const yearSelect = document.getElementById('fellowship-year-select');

  yearSelect?.addEventListener('change', () => {
    const year = yearSelect.value;
    document.querySelectorAll('[data-fellowship-year]').forEach((img) => {
      const el = img as HTMLElement;
      el.classList.toggle('hidden', el.dataset.fellowshipYear !== year);
    });
  });

  const lightbox = document.getElementById('fellowship-lightbox');
  const lightboxImage = lightbox?.querySelector('img');
  const closeLightbox = () => { if (lightbox) lightbox.hidden = true; document.body.style.overflow = ''; };
  document.querySelectorAll('[data-lightbox-src]').forEach((trigger) => trigger.addEventListener('click', () => {
    const src = (trigger as HTMLElement).dataset.lightboxSrc;
    if (!src || !lightbox || !lightboxImage) return;
    lightboxImage.src = src; lightbox.hidden = false; document.body.style.overflow = 'hidden';
  }));
  lightbox?.querySelector('button')?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeLightbox(); });
</script>

<style>
  .fellowship-about-copy{max-width:75ch}.fellowship-group-photo{max-height:640px;width:100%;height:auto;object-fit:contain}.fellowship-group-photo.hidden{display:none}

  .fellowship-hero-ktp{background:#29B9F2;border-bottom:2px solid #173B53}.fellowship-tab-shell{background:#fffdf8;border-bottom:1px solid rgba(23,41,65,.18)}.fellowship-tablist{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.25rem}.fellowship-tablist button{font-family:Poppins,sans-serif;font-size:.76rem;font-weight:600;color:#34465c;padding:1rem .4rem;border-bottom:3px solid transparent;transition:color .15s,border-color .15s}.fellowship-tablist button[aria-selected="true"]{color:#172941;border-bottom-color:#b8953f}.fellowship-tabs-ktp .fellowship-tablist button[aria-selected="true"]{color:#173B53;border-bottom-color:#29B9F2}.fellowship-tablist button:focus-visible{outline:3px solid #173B53;outline-offset:-3px}.fellowship-empty-state{border:1px solid rgba(23,41,65,.15);border-radius:.5rem;background:#fffdf8;text-align:center;padding:3rem 1.5rem}.fellowship-empty-state h2{font-family:Poppins,sans-serif;font-weight:600;color:#172941;font-size:1.2rem}.fellowship-empty-state p{font-family:EB Garamond,serif;color:#4b5563;margin-top:.75rem;font-size:1rem}[data-fellowship-panel][hidden]{display:none!important}@media(max-width:390px){.fellowship-tablist button{font-size:.68rem;padding:.9rem .15rem}}
  .fellowship-person-lightbox{width:42px;height:42px;flex:0 0 auto;overflow:hidden;border:1px solid rgba(184,149,63,.35);border-radius:50%;padding:0;background:#162844}.fellowship-person-lightbox img{width:100%;height:100%;object-fit:cover}.fellowship-related-gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem}.fellowship-related-gallery button{aspect-ratio:1;border:0;border-radius:.35rem;overflow:hidden;padding:0;background:#162844}.fellowship-related-gallery img{width:100%;height:100%;object-fit:cover;transition:transform .25s}.fellowship-related-gallery button:hover img{transform:scale(1.04)}.fellowship-related-documents{display:grid;gap:.55rem}.fellowship-related-documents a{display:grid;grid-template-columns:90px minmax(0,1fr) auto;gap:.8rem;align-items:center;padding:.85rem 1rem;border:1px solid rgba(184,149,63,.2);border-radius:.35rem;background:#10243f;text-decoration:none}.fellowship-related-documents span,.fellowship-related-documents i{color:rgba(244,227,181,.48);font-size:.62rem;font-style:normal;text-transform:uppercase}.fellowship-related-documents b{color:#f4e3b5;font-size:.8rem}.fellowship-lightbox[hidden]{display:none}.fellowship-lightbox{position:fixed;z-index:100;inset:0;display:grid;place-items:center;padding:4rem 1.5rem 1.5rem;background:rgba(5,13,25,.94)}.fellowship-lightbox>button{position:absolute;top:1rem;right:1.25rem;border:0;background:transparent;color:#fff;font-size:2.2rem}.fellowship-lightbox>img{max-width:min(1100px,94vw);max-height:86vh;object-fit:contain}@media(max-width:640px){.fellowship-related-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.fellowship-related-documents a{grid-template-columns:1fr auto}.fellowship-related-documents span{grid-column:1/-1}}
</style>
