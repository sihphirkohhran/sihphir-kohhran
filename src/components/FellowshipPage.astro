---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { FellowshipGroupPhoto } from '../lib/fellowship';
import { getPageSettings } from '../lib/page-settings';

interface Props {
  name: string;
  abbr: string;
  subtitle: string;
  history: string;
  historyFull?: string;
  logo?: string;
  groupPhotos?: FellowshipGroupPhoto[];
  officeBearers: { role: string; name: string; photo?: string; phone?: string; email?: string }[];
  committeeMembers: { name: string; role?: string; photo?: string; notes?: string }[];
  relatedPhotos?: { src: string; caption?: string }[];
  relatedDocuments?: { name: string; url: string; category?: string }[];
  accentColor?: string;
}

const {
  name,
  abbr,
  subtitle,
  history,
  historyFull = '',
  logo,
  groupPhotos = [],
  officeBearers,
  committeeMembers,
  relatedPhotos = [],
  relatedDocuments = [],
  accentColor = 'from-navy to-navy-light',
} = Astro.props;

const defaultGroupYear = groupPhotos[0]?.year;
const ui=await getPageSettings('fellowship',{hero_caption:'Sihphir Presbyterian Kohhran',hero_title:name,hero_subtitle:subtitle,history_title:'History',office_bearers_title:'Office Bearers',members_title:'Committee Members',gallery_title:'Gallery',documents_title:'Documents',search_placeholder:'Search fellowships…',empty_message:'No fellowships found',back_button:'All Fellowships'});
---

<BaseLayout title={`${name} — Sihphir Presbyterian Kohhran`} activePage="fellowship">

  <!-- Hero -->
  <div class="bg-navy border-b-2 border-gold px-4 pt-8 pb-6 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]"
      style="background-image: repeating-linear-gradient(45deg, #b8953f 0px, #b8953f 1px, transparent 1px, transparent 28px);">
    </div>
    <div class="relative z-10 max-w-2xl mx-auto">
      <a href="/fellowship" class="inline-flex items-center gap-1 font-body text-[0.65rem] tracking-widest uppercase text-gold/50 hover:text-gold transition-colors mb-4">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        {ui.back_button}
      </a>
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-full border-2 border-gold/60 flex items-center justify-center bg-gold/[0.07] flex-shrink-0 overflow-hidden">
          {logo ? (
            <img src={logo} alt={`${name} logo`} class="w-full h-full object-cover" loading="lazy" />
          ) : (
            <span class="font-display text-gold-light font-bold text-xl">{abbr}</span>
          )}
        </div>
        <div>
          <h1 class="font-display text-white text-xl sm:text-2xl font-semibold">{name}</h1>
          <p class="font-body text-gold-pale/50 text-xs tracking-widest uppercase mt-0.5">{ui.hero_subtitle}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-2xl mx-auto px-4 py-8 space-y-8">

    <!-- History -->
    <div class="reveal">
      <div class="gold-divider mb-4"><h2>{ui.history_title}</h2></div>
      <div class="border-l-4 border-gold rounded-r bg-ivory pl-5 pr-4 py-4">
        <p class="font-body text-sm text-gray-700 leading-relaxed mb-3">{history}</p>
        {historyFull && (
          <>
            <div id="history-full" class="content-page-body font-body text-sm text-gray-700 leading-relaxed mb-3 hidden">
              <Fragment set:html={historyFull} />
            </div>
            <button id="history-btn" class="font-body text-[0.7rem] tracking-[0.1em] uppercase text-navy border-b border-navy/40 hover:border-navy transition-colors pb-0.5">
              Read More →
            </button>
          </>
        )}
      </div>
    </div>

    <!-- Office Bearers -->
    <div class="reveal">
      <div class="gold-divider mb-4"><h2>{ui.office_bearers_title}</h2></div>
      <div class="bg-navy border border-gold/20 rounded overflow-hidden">
        {officeBearers.map((ob, i) => (
          <div class={`flex items-center justify-between gap-4 px-5 py-3 ${i < officeBearers.length - 1 ? 'border-b border-gold/[0.08]' : ''}`}>
            <div class="flex items-center gap-3 min-w-0">
              {ob.photo && <button class="fellowship-person-lightbox" data-lightbox-src={ob.photo} aria-label={`View ${ob.name} photo`}><img src={ob.photo} alt={ob.name} loading="lazy" /></button>}
              <div><span class="font-body text-[0.65rem] tracking-widest uppercase text-gold/55 block">{ob.role}</span><span class="font-display text-gold-pale font-semibold text-sm">{ob.name}</span></div>
            </div>
            {(ob.phone || ob.email) && <span class="font-body text-[0.6rem] text-gold-pale/40 text-right">{ob.phone || ob.email}</span>}
          </div>
        ))}
      </div>
    </div>

    <!-- Committee Members -->
    <div class="reveal">
      <div class="gold-divider mb-4"><h2>{ui.members_title}</h2></div>
      <div class="bg-navy border border-gold/20 rounded overflow-hidden">
        <table class="w-full">
          <thead>
            <tr>
              <th class="text-left px-4 py-2.5 font-body text-[0.6rem] tracking-widest uppercase text-gold-pale/40 bg-navy-light border-b border-gold/10 w-8">#</th>
              <th class="text-left px-4 py-2.5 font-body text-[0.6rem] tracking-widest uppercase text-gold-pale/40 bg-navy-light border-b border-gold/10">Hming</th>
              <th class="text-left px-4 py-2.5 font-body text-[0.6rem] tracking-widest uppercase text-gold-pale/40 bg-navy-light border-b border-gold/10">Role</th>
            </tr>
          </thead>
          <tbody>
            {committeeMembers.map((m, i) => (
              <tr>
                <td class="px-4 py-2.5 font-body text-xs text-gold-pale/25 border-b border-gold/[0.06]">{i + 1}</td>
                <td class="px-4 py-2.5 font-body text-sm text-gold-pale/80 border-b border-gold/[0.06]"><div class="flex items-center gap-3">{m.photo && <button class="fellowship-person-lightbox" data-lightbox-src={m.photo} aria-label={`View ${m.name} photo`}><img src={m.photo} alt={m.name} loading="lazy" /></button>}<span>{m.name}</span></div></td>
                <td class="px-4 py-2.5 border-b border-gold/[0.06]">
                  <span class="font-body text-[0.6rem] tracking-wide text-gold-pale/40">{m.role || 'Member'}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    {groupPhotos.length > 0 && (
      <section class="reveal fellowship-group-section" data-fellowship-name={name}>
        <div class="fellowship-group-panel">
          {groupPhotos.length > 1 && (
            <div class="fellowship-group-controls">
              <label class="font-body text-[0.65rem] tracking-widest uppercase text-gray-500 block mb-1.5" for="fellowship-year-select">
                Year
              </label>
              <select
                id="fellowship-year-select"
                class="archive-filter-select w-full sm:w-auto min-w-[140px] border border-navy/20 rounded px-3 py-2.5 font-body text-sm text-navy bg-ivory focus:outline-none focus:border-navy/60 transition-colors"
              >
                {groupPhotos.map((g) => (
                  <option value={String(g.year)} selected={g.year === defaultGroupYear}>{g.year}</option>
                ))}
              </select>
            </div>
          )}
          <figure class="fellowship-group-figure">
            {groupPhotos.map((g) => (
              <img
                src={g.photo}
                alt={`${name} group photo ${g.year}`}
                class={`fellowship-group-photo ${g.year === defaultGroupYear ? '' : 'hidden'}`}
                data-fellowship-year={g.year}
                loading="eager"
                data-lightbox
                data-lightbox-src={g.photo}
              />
            ))}
          </figure>
        </div>
      </section>
    )}
    {relatedPhotos.length > 0 && (
      <section class="reveal fellowship-related-section">
        <div class="gold-divider mb-4"><h2>{ui.gallery_title}</h2></div>
        <div class="fellowship-related-gallery">{relatedPhotos.map((photo) => <button data-lightbox-src={photo.src} aria-label="View gallery photo"><img src={photo.src} alt={photo.caption || name} loading="lazy" /></button>)}</div>
      </section>
    )}
    {relatedDocuments.length > 0 && (
      <section class="reveal fellowship-related-section">
        <div class="gold-divider mb-4"><h2>{ui.documents_title}</h2></div>
        <div class="fellowship-related-documents">{relatedDocuments.map((document) => <a href={document.url} target="_blank" rel="noopener"><span>{document.category}</span><b>{document.name}</b><i>Open ↗</i></a>)}</div>
      </section>
    )}
  </div>

  <div class="fellowship-lightbox" id="fellowship-lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer"><button type="button" aria-label="Close photo viewer">×</button><img src="" alt="" /></div>

</BaseLayout>

<script>
  const btn = document.getElementById('history-btn');
  const full = document.getElementById('history-full');
  let open = false;
  btn?.addEventListener('click', () => {
    open = !open;
    full?.classList.toggle('hidden', !open);
    if (btn) btn.textContent = open ? '← Read Less' : 'Read More →';
  });

  const yearSelect = document.getElementById('fellowship-year-select');

  yearSelect?.addEventListener('change', () => {
    const year = yearSelect.value;
    document.querySelectorAll('[data-fellowship-year]').forEach((img) => {
      const el = img as HTMLElement;
      el.classList.toggle('hidden', el.dataset.fellowshipYear !== year);
    });
  });

  const lightbox = document.getElementById('fellowship-lightbox');
  const lightboxImage = lightbox?.querySelector('img');
  const closeLightbox = () => { if (lightbox) lightbox.hidden = true; document.body.style.overflow = ''; };
  document.querySelectorAll('[data-lightbox-src]').forEach((trigger) => trigger.addEventListener('click', () => {
    const src = (trigger as HTMLElement).dataset.lightboxSrc;
    if (!src || !lightbox || !lightboxImage) return;
    lightboxImage.src = src; lightbox.hidden = false; document.body.style.overflow = 'hidden';
  }));
  lightbox?.querySelector('button')?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeLightbox(); });
</script>

<style>
  .fellowship-person-lightbox{width:42px;height:42px;flex:0 0 auto;overflow:hidden;border:1px solid rgba(184,149,63,.35);border-radius:50%;padding:0;background:#162844}.fellowship-person-lightbox img{width:100%;height:100%;object-fit:cover}.fellowship-related-gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem}.fellowship-related-gallery button{aspect-ratio:1;border:0;border-radius:.35rem;overflow:hidden;padding:0;background:#162844}.fellowship-related-gallery img{width:100%;height:100%;object-fit:cover;transition:transform .25s}.fellowship-related-gallery button:hover img{transform:scale(1.04)}.fellowship-related-documents{display:grid;gap:.55rem}.fellowship-related-documents a{display:grid;grid-template-columns:90px minmax(0,1fr) auto;gap:.8rem;align-items:center;padding:.85rem 1rem;border:1px solid rgba(184,149,63,.2);border-radius:.35rem;background:#10243f;text-decoration:none}.fellowship-related-documents span,.fellowship-related-documents i{color:rgba(244,227,181,.48);font-size:.62rem;font-style:normal;text-transform:uppercase}.fellowship-related-documents b{color:#f4e3b5;font-size:.8rem}.fellowship-lightbox[hidden]{display:none}.fellowship-lightbox{position:fixed;z-index:100;inset:0;display:grid;place-items:center;padding:4rem 1.5rem 1.5rem;background:rgba(5,13,25,.94)}.fellowship-lightbox>button{position:absolute;top:1rem;right:1.25rem;border:0;background:transparent;color:#fff;font-size:2.2rem}.fellowship-lightbox>img{max-width:min(1100px,94vw);max-height:86vh;object-fit:contain}@media(max-width:640px){.fellowship-related-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.fellowship-related-documents a{grid-template-columns:1fr auto}.fellowship-related-documents span{grid-column:1/-1}}
</style>
