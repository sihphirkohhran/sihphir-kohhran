---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileExtras from './MinistryProfileExtras.astro';

export type MinistryProfile = { id:string; name:string; photo:string; designation:string; period:string; year:number; status:string; description:string; biographyHtml:string; featured:boolean; current:boolean; gallery:{src:string;caption:string}[]; documents:string[]; bibleVerse?:string; messageHtml?:string; missionField?:string };
interface Props { title:string; subtitle:string; activePage:string; currentLabel:string; historyLabel:string; profiles:MinistryProfile[]; pastor?:boolean }
const { title, subtitle, activePage, currentLabel, historyLabel, profiles, pastor=false } = Astro.props;
const current = profiles.filter((profile) => profile.current);
const history = profiles.filter((profile) => !profile.current).sort((a,b)=>b.year-a.year);
const years = Array.from(new Set(profiles.map((profile)=>profile.year))).sort((a,b)=>b-a);
const defaultPhoto='/images/pastor.jpg';
---
<BaseLayout title={`${title} — Sihphir Presbyterian Kohhran`} activePage={activePage}>
  <header class="ministry-hero"><div><p>Sihphir Presbyterian Kohhran</p><h1>{title}</h1><div class="hero-subtitle">{subtitle}</div><span>{profiles.length} profile{profiles.length===1?'':'s'} in the archive</span></div></header>
  <main class="ministry-page max-w-6xl mx-auto px-4 py-8 sm:py-10">
    <section class="ministry-toolbar reveal"><label><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg><span class="sr-only">Search profiles</span><input id="ministry-search" type="search" placeholder="Search name, designation or description…" /></label><div><label><span>Year</span><select id="ministry-year"><option value="all">All years</option>{years.map(year=><option value={year}>{year}</option>)}</select></label><label><span>Sort</span><select id="ministry-sort"><option value="newest">Newest</option><option value="oldest">Oldest</option><option value="az">A–Z</option><option value="featured">Featured</option></select></label></div><p id="ministry-count">{profiles.length} profiles</p></section>
    {current.length>0&&<section class="ministry-section current-section"><header><div><span>Serving today</span><h2>{currentLabel}</h2></div><p>Current leadership and ministry profiles.</p></header><div class="current-grid" data-profile-grid>{current.map(profile=><article class="current-card reveal" data-profile data-name={profile.name.toLowerCase()} data-text={`${profile.designation} ${profile.description} ${profile.missionField||''}`.toLowerCase()} data-year={profile.year} data-featured={String(profile.featured)}><button class="portrait" type="button" data-lightbox-src={profile.photo||defaultPhoto} data-lightbox-caption={profile.name}><img src={profile.photo||defaultPhoto} alt={profile.name} loading="lazy" /><span>View photo</span></button><div class="current-copy"><div class="badges">{profile.featured&&<span>Featured</span>}<span>{profile.designation}</span><span>{profile.period}</span></div><h2>{profile.name}</h2>{profile.missionField&&<p class="mission-field">{profile.missionField}</p>}{pastor&&profile.bibleVerse&&<blockquote>{profile.bibleVerse}</blockquote>}<p>{profile.description}</p>{profile.biographyHtml&&<div class="prose" set:html={profile.biographyHtml}></div>}{pastor&&profile.messageHtml&&<div class="pastor-message"><span>Pastor’s Message</span><div class="prose" set:html={profile.messageHtml}></div></div>}<ProfileExtras profile={profile} /></div></article>)}</div></section>}
    {history.length>0&&<section class="ministry-section history-section"><header><div><span>Church record</span><h2>{historyLabel}</h2></div><p>Preserving faithful service, newest first.</p></header><div class="timeline" data-profile-grid>{history.map(profile=><article class="timeline-card reveal" data-profile data-name={profile.name.toLowerCase()} data-text={`${profile.designation} ${profile.description} ${profile.missionField||''}`.toLowerCase()} data-year={profile.year} data-featured={String(profile.featured)}><i></i><button class="timeline-photo" type="button" data-lightbox-src={profile.photo||defaultPhoto} data-lightbox-caption={profile.name}><img src={profile.photo||defaultPhoto} alt={profile.name} loading="lazy" /></button><div><div class="badges">{profile.featured&&<span>Featured</span>}<span>{profile.period}</span></div><h3>{profile.name}</h3><strong>{profile.designation}</strong>{profile.missionField&&<p class="mission-field">{profile.missionField}</p>}<p>{profile.description}</p>{profile.biographyHtml&&<div class="prose" set:html={profile.biographyHtml}></div>}<ProfileExtras profile={profile} /></div></article>)}</div></section>}
    <section class="ministry-empty" id="ministry-empty" hidden><h2>No profiles found</h2><p>Try another search or clear the year filter.</p><button type="button" id="ministry-clear">Clear filters</button></section>
  </main>
  <dialog class="ministry-lightbox" id="ministry-lightbox"><div><span id="lightbox-count"></span><small id="lightbox-caption"></small><a id="lightbox-download" download>Download</a><button data-lightbox-close aria-label="Close">×</button></div><button class="previous" data-lightbox-previous aria-label="Previous">‹</button><img src="" alt="" /><button class="next" data-lightbox-next aria-label="Next">›</button><button class="zoom" data-lightbox-zoom>Zoom</button></dialog>
</BaseLayout>

<script>
  const search=document.querySelector<HTMLInputElement>('#ministry-search'),year=document.querySelector<HTMLSelectElement>('#ministry-year'),sort=document.querySelector<HTMLSelectElement>('#ministry-sort'),count=document.querySelector('#ministry-count'),empty=document.querySelector<HTMLElement>('#ministry-empty');function filter(){const q=search?.value.trim().toLowerCase()||'',y=year?.value||'all';let visible=0;document.querySelectorAll<HTMLElement>('[data-profile]').forEach(card=>{const show=(!q||`${card.dataset.name} ${card.dataset.text}`.includes(q))&&(y==='all'||card.dataset.year===y);card.hidden=!show;if(show)visible++;});document.querySelectorAll<HTMLElement>('[data-profile-grid]').forEach(grid=>[...grid.querySelectorAll<HTMLElement>('[data-profile]')].sort((a,b)=>{if(sort?.value==='az')return(a.dataset.name||'').localeCompare(b.dataset.name||'');if(sort?.value==='featured')return Number(b.dataset.featured==='true')-Number(a.dataset.featured==='true');const result=Number(b.dataset.year)-Number(a.dataset.year);return sort?.value==='oldest'?-result:result;}).forEach(card=>grid.append(card)));document.querySelectorAll<HTMLElement>('.ministry-section').forEach(section=>section.hidden=!section.querySelector('[data-profile]:not([hidden])'));if(empty)empty.hidden=visible>0;if(count)count.textContent=`${visible} profile${visible===1?'':'s'}`;}[search,year].forEach(control=>control?.addEventListener(control===search?'input':'change',filter));sort?.addEventListener('change',filter);document.querySelector('#ministry-clear')?.addEventListener('click',()=>{if(search)search.value='';if(year)year.value='all';filter();search?.focus();});
  const lightbox=document.querySelector<HTMLDialogElement>('#ministry-lightbox'),image=lightbox?.querySelector<HTMLImageElement>('img'),caption=document.querySelector('#lightbox-caption'),counter=document.querySelector('#lightbox-count'),download=document.querySelector<HTMLAnchorElement>('#lightbox-download');let photos:HTMLButtonElement[]=[],index=0,zoom=false,touch=0;function show(next:number){if(!photos.length||!image)return;index=(next+photos.length)%photos.length;const item=photos[index],src=item.dataset.lightboxSrc||'';image.src=src;image.alt=item.dataset.lightboxCaption||'';if(caption)caption.textContent=item.dataset.lightboxCaption||'';if(counter)counter.textContent=`${index+1} / ${photos.length}`;if(download)download.href=src;zoom=false;image.classList.remove('zoomed');}document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]').forEach(button=>button.addEventListener('click',()=>{photos=[...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]')].filter(item=>!item.closest<HTMLElement>('[data-profile]')?.hidden);index=photos.indexOf(button);show(index);lightbox?.showModal();}));document.querySelector('[data-lightbox-close]')?.addEventListener('click',()=>lightbox?.close());document.querySelector('[data-lightbox-previous]')?.addEventListener('click',()=>show(index-1));document.querySelector('[data-lightbox-next]')?.addEventListener('click',()=>show(index+1));document.querySelector('[data-lightbox-zoom]')?.addEventListener('click',()=>{zoom=!zoom;image?.classList.toggle('zoomed',zoom);});lightbox?.addEventListener('click',event=>{if(event.target===lightbox)lightbox.close();});lightbox?.addEventListener('touchstart',event=>touch=event.changedTouches[0].clientX,{passive:true});lightbox?.addEventListener('touchend',event=>{const delta=event.changedTouches[0].clientX-touch;if(Math.abs(delta)>55)show(index+(delta<0?1:-1));},{passive:true});document.addEventListener('keydown',event=>{if(!lightbox?.open)return;if(event.key==='ArrowLeft')show(index-1);if(event.key==='ArrowRight')show(index+1);});filter();
</script>

<style>
  .ministry-hero{padding:42px 16px;border-bottom:2px solid #b8953f;background:#142740;color:white;text-align:center}.ministry-hero>div{max-width:760px;margin:auto}.ministry-hero p{margin:0 0 8px;color:#d9c78f;font-size:.6rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.ministry-hero h1{margin:0;font-family:var(--font-display,serif);font-size:clamp(2rem,5vw,2.65rem)}.hero-subtitle{margin:12px 0;color:#d8ccaa;font-size:.88rem;line-height:1.6}.ministry-hero span{color:#9eabc0;font-size:.63rem;text-transform:uppercase}.ministry-page{color:#172941}.ministry-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;padding:18px;border:1px solid #1427401c;border-radius:14px;background:#fffdf8;box-shadow:0 12px 35px #14243a12}.ministry-toolbar>label{grid-column:1/-1;display:flex;align-items:center;gap:10px;border:1px solid #1427402b;border-radius:9px;padding:0 13px;background:white}.ministry-toolbar svg{width:18px;fill:none;stroke:#9a772b;stroke-width:1.7}.ministry-toolbar input{width:100%;border:0;outline:0;padding:12px 0}.ministry-toolbar>div{display:flex;gap:10px}.ministry-toolbar>div label{display:grid;gap:5px}.ministry-toolbar label span{color:#7c8390;font-size:.56rem;font-weight:700;text-transform:uppercase}.ministry-toolbar select{min-width:145px;border:1px solid #14274029;border-radius:8px;padding:9px;background:white}.ministry-toolbar>p{align-self:end;margin:0 0 9px;color:#7e8590;font-size:.7rem}.ministry-section{margin-top:42px}.ministry-section>header{display:flex;justify-content:space-between;align-items:end;margin-bottom:18px}.ministry-section>header span,.photo-heading span{color:#9c7628;font-size:.57rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.ministry-section>header h2{margin:4px 0 0;font-family:var(--font-display,serif);font-size:1.55rem}.ministry-section>header p{margin:0;color:#7b828d;font-size:.75rem}.current-grid{display:grid;gap:22px}.current-card{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(0,1.25fr);overflow:hidden;border:1px solid #14274019;border-radius:17px;background:white;box-shadow:0 14px 40px #17263b16}.portrait{position:relative;min-height:470px;overflow:hidden;border:0;padding:0;background:#e9ecee}.portrait img{width:100%;height:100%;object-fit:cover;transition:.5s}.portrait:hover img{transform:scale(1.04)}.portrait span{position:absolute;right:14px;bottom:14px;border-radius:999px;padding:6px 9px;background:#142740dd;color:white;font-size:.6rem}.current-copy{padding:34px}.badges{display:flex;flex-wrap:wrap;gap:6px}.badges span{border:1px solid #b8953f38;border-radius:999px;padding:4px 7px;background:#fdf8eb;color:#8e6a25;font-size:.53rem;font-weight:700;text-transform:uppercase}.current-copy h2,.timeline-card h3{margin:14px 0 7px;font-family:var(--font-display,serif);font-size:1.8rem}.current-copy>p,.timeline-card>div>p{color:#707987;font-size:.78rem;line-height:1.65}.mission-field{color:#9a7429!important;font-weight:700}.current-copy blockquote{margin:18px 0;padding:14px 18px;border-left:3px solid #b8953f;background:#fdf9ee;color:#526178;font-family:var(--font-display,serif)}.prose{color:#4d5b6e;font-size:.8rem;line-height:1.75}.pastor-message{margin-top:24px;padding:20px;border-radius:11px;background:#f8f4e9}.pastor-message>span,.profile-gallery h4,.related-documents h4{color:#987126;font-size:.6rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.timeline{position:relative;display:grid;gap:18px;padding-left:34px}.timeline:before{content:'';position:absolute;top:0;bottom:0;left:10px;width:1px;background:#b8953f55}.timeline-card{position:relative;display:grid;grid-template-columns:190px minmax(0,1fr);gap:22px;padding:16px;border:1px solid #14274016;border-radius:14px;background:white;box-shadow:0 7px 24px #17263b10}.timeline-card>i{position:absolute;top:31px;left:-29px;width:11px;height:11px;border:3px solid white;border-radius:50%;background:#b8953f;box-shadow:0 0 0 1px #b8953f}.timeline-photo{height:210px;overflow:hidden;border:0;border-radius:10px;padding:0}.timeline-photo img{width:100%;height:100%;object-fit:cover;transition:.4s}.timeline-photo:hover img{transform:scale(1.05)}.timeline-card h3{font-size:1.25rem}.timeline-card strong{color:#9a7429;font-size:.68rem}.profile-gallery,.related-documents{margin-top:24px;padding-top:17px;border-top:1px solid #14274014}.profile-gallery>div{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.profile-gallery button{aspect-ratio:1;border:0;border-radius:8px;padding:0;overflow:hidden}.profile-gallery img{width:100%;height:100%;object-fit:cover;transition:.35s}.profile-gallery button:hover img{transform:scale(1.08)}.related-documents>div{display:grid;gap:7px}.related-documents a{display:grid;grid-template-columns:44px minmax(0,1fr) auto;align-items:center;gap:10px;padding:9px;border:1px solid #14274016;border-radius:8px;color:#30445e;text-decoration:none}.related-documents a span{font-size:.55rem;font-weight:800}.related-documents a b{overflow:hidden;font-size:.68rem;text-overflow:ellipsis;white-space:nowrap}.related-documents a i{color:#9a7429;font-size:.6rem;font-style:normal}.ministry-empty{display:grid;justify-items:center;margin-top:35px;padding:60px;border:1px solid #14274018;border-radius:14px;background:#fffdf8;text-align:center}.ministry-empty h2{font-family:var(--font-display,serif)}.ministry-empty p{color:#7b828d;font-size:.76rem}.ministry-empty button{border:0;border-radius:8px;padding:9px 12px;background:#142740;color:white}.ministry-section[hidden],.ministry-empty[hidden],[data-profile][hidden]{display:none}.ministry-lightbox{width:100vw;max-width:none;height:100vh;max-height:none;border:0;padding:62px;background:#050d18f5}.ministry-lightbox::backdrop{background:#050d18f5}.ministry-lightbox>img{width:100%;height:100%;object-fit:contain;transition:.25s}.ministry-lightbox>img.zoomed{transform:scale(1.7)}.ministry-lightbox>div{position:fixed;z-index:2;top:0;right:0;left:0;display:flex;align-items:center;gap:12px;padding:12px 18px;background:#081525;color:white}.ministry-lightbox>div small{flex:1;color:#ffffffa8}.ministry-lightbox a,.ministry-lightbox button{border:1px solid #ffffff38;border-radius:7px;padding:7px 10px;background:#0b1a2ddd;color:white;text-decoration:none}.ministry-lightbox>.previous,.ministry-lightbox>.next{position:fixed;z-index:2;top:50%;font-size:1.8rem}.ministry-lightbox>.previous{left:10px}.ministry-lightbox>.next{right:10px}.ministry-lightbox>.zoom{position:fixed;right:18px;bottom:14px}
  @media(max-width:800px){.ministry-toolbar{grid-template-columns:1fr}.ministry-toolbar>p{margin:0}.current-card{grid-template-columns:1fr}.portrait{min-height:380px}.timeline-card{grid-template-columns:150px minmax(0,1fr)}.profile-gallery>div{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:560px){.ministry-toolbar{padding:13px}.ministry-toolbar>div{display:grid;grid-template-columns:1fr 1fr}.ministry-toolbar select{width:100%;min-width:0}.ministry-section>header{display:block}.ministry-section>header p{margin-top:6px}.current-copy{padding:21px}.portrait{min-height:330px}.timeline{padding-left:25px}.timeline:before{left:7px}.timeline-card{grid-template-columns:1fr}.timeline-card>i{left:-23px}.timeline-photo{height:250px}.profile-gallery>div{grid-template-columns:repeat(2,1fr)}.ministry-lightbox{padding:58px 8px 12px}.ministry-lightbox a{display:none}}
</style>
