---
import BaseLayout from '../layouts/BaseLayout.astro';
import MinistryProfileExtras from './MinistryProfileExtras.astro';
import type { MinistryProfile } from '../lib/ministry-profile';
interface Props { title:string; activePage:string; basePath:string; profile:MinistryProfile }
const {title,activePage,basePath,profile}=Astro.props;
const photos=[{src:profile.photo||'/images/pastor.jpg',caption:profile.name},...profile.gallery].filter((photo,index,list)=>list.findIndex(item=>item.src===photo.src)===index);
---
<BaseLayout title={`${profile.name} — ${title}`} activePage={activePage}>
  <main class="detail-page max-w-6xl mx-auto px-4 py-7 sm:py-10"><a class="back" href={basePath}>← Back to {title}</a><article class="profile-hero"><button type="button" data-photo-index="0"><img src={profile.photo||'/images/pastor.jpg'} alt={profile.name} /></button><div><div class="badges"><span>{profile.designation}</span><span>{profile.period}</span></div><h1>{profile.name}</h1>{profile.missionField&&<strong>{profile.missionField}</strong>}<p>{profile.description}</p>{profile.bibleVerse&&<blockquote>{profile.bibleVerse}</blockquote>}</div></article>{profile.biographyHtml&&<section class="detail-section biography"><header><span>Profile</span><h2>Biography</h2></header><div class="prose" set:html={profile.biographyHtml}></div></section>}{profile.messageHtml&&<section class="detail-section message"><header><span>From the pastor</span><h2>Pastor’s Message</h2></header><div class="prose" set:html={profile.messageHtml}></div></section>}<div class="extras"><MinistryProfileExtras profile={profile} /></div></main>
  <dialog class="detail-lightbox" id="detail-lightbox"><div><span id="photo-counter"></span><small id="photo-caption"></small><a id="photo-download" download>Download</a><button data-close aria-label="Close">×</button></div><button class="previous" data-previous>‹</button><img src="" alt="" /><button class="next" data-next>›</button><button class="zoom" data-zoom>Zoom</button></dialog>
</BaseLayout>
<script define:vars={{photos}}>
  const dialog=document.querySelector('#detail-lightbox'),image=dialog?.querySelector('img'),caption=document.querySelector('#photo-caption'),counter=document.querySelector('#photo-counter'),download=document.querySelector('#photo-download');let index=0,zoom=false,touch=0;function show(next){index=(next+photos.length)%photos.length;const photo=photos[index];image.src=photo.src;image.alt=photo.caption;if(caption)caption.textContent=photo.caption;if(counter)counter.textContent=`${index+1} / ${photos.length}`;if(download)download.href=photo.src;zoom=false;image.classList.remove('zoomed')}document.querySelectorAll('[data-photo-index]').forEach(button=>button.addEventListener('click',()=>{show(Number(button.dataset.photoIndex));dialog.showModal()}));document.querySelectorAll('.profile-gallery button').forEach((button,photoIndex)=>button.addEventListener('click',()=>{show(photoIndex+1);dialog.showModal()}));dialog?.querySelector('[data-close]')?.addEventListener('click',()=>dialog.close());dialog?.querySelector('[data-previous]')?.addEventListener('click',()=>show(index-1));dialog?.querySelector('[data-next]')?.addEventListener('click',()=>show(index+1));dialog?.querySelector('[data-zoom]')?.addEventListener('click',()=>{zoom=!zoom;image.classList.toggle('zoomed',zoom)});dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});dialog?.addEventListener('touchstart',event=>touch=event.changedTouches[0].clientX,{passive:true});dialog?.addEventListener('touchend',event=>{const delta=event.changedTouches[0].clientX-touch;if(Math.abs(delta)>55)show(index+(delta<0?1:-1))},{passive:true});document.addEventListener('keydown',event=>{if(!dialog?.open)return;if(event.key==='ArrowLeft')show(index-1);if(event.key==='ArrowRight')show(index+1)});
</script>
<style>
  .detail-page{color:#172941}.back{display:inline-block;margin-bottom:18px;border:1px solid #14274024;border-radius:8px;padding:9px 11px;background:white;color:#31445e;text-decoration:none;font-size:.68rem;font-weight:700}.profile-hero{display:grid;grid-template-columns:minmax(270px,.78fr) minmax(0,1.22fr);min-height:490px;overflow:hidden;border-radius:17px;background:#142740;color:white;box-shadow:0 16px 42px #11223826}.profile-hero>button{overflow:hidden;border:0;padding:0;background:#e9ecee;cursor:zoom-in}.profile-hero img{width:100%;height:100%;object-fit:cover;transition:.45s}.profile-hero button:hover img{transform:scale(1.035)}.profile-hero>div{display:grid;align-content:center;padding:38px}.badges{display:flex;flex-wrap:wrap;gap:6px}.badges span{border:1px solid #d6bc7266;border-radius:999px;padding:5px 8px;background:#ffffff0d;color:#e7cf8c;font-size:.54rem;font-weight:700;text-transform:uppercase}.profile-hero h1{margin:15px 0 7px;color:white;font-family:var(--font-display,serif);font-size:clamp(2rem,4vw,2.7rem)}.profile-hero strong{color:#dec77f;font-size:.72rem}.profile-hero p{color:#c7d0dc;font-size:.8rem;line-height:1.65}.profile-hero blockquote{margin:18px 0 0;padding:15px 18px;border-left:3px solid #b8953f;background:#ffffff0b;color:#e4d7b2;font-family:var(--font-display,serif)}.detail-section{max-width:850px;margin:36px auto 0}.detail-section header span{color:#9c7628;font-size:.57rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.detail-section h2{margin:4px 0 15px;font-family:var(--font-display,serif);font-size:1.5rem}.prose{color:#4d5b6e;font-size:.84rem;line-height:1.8}.message{padding:24px;border-radius:13px;background:#f8f4e9}.extras{max-width:1000px;margin:35px auto}.extras :global(.profile-gallery),.extras :global(.related-documents){margin-top:28px;padding-top:18px;border-top:1px solid #14274017}.extras :global(h4){color:#987126;font-size:.62rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.extras :global(.profile-gallery>div){display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.extras :global(.profile-gallery button){aspect-ratio:4/3;overflow:hidden;border:0;border-radius:9px;padding:0;cursor:zoom-in}.extras :global(.profile-gallery img){width:100%;height:100%;object-fit:cover;transition:.4s}.extras :global(.profile-gallery button:hover img){transform:scale(1.06)}.extras :global(.related-documents>div){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.extras :global(.related-documents a){display:grid;grid-template-columns:45px minmax(0,1fr) auto;align-items:center;gap:10px;padding:11px;border:1px solid #14274017;border-radius:9px;color:#30445e;text-decoration:none}.extras :global(.related-documents span){font-size:.55rem;font-weight:800}.extras :global(.related-documents b){overflow:hidden;font-size:.68rem;text-overflow:ellipsis;white-space:nowrap}.extras :global(.related-documents i){color:#9a7429;font-size:.6rem;font-style:normal}.detail-lightbox{width:100vw;max-width:none;height:100vh;max-height:none;border:0;padding:62px;background:#050d18f5}.detail-lightbox::backdrop{background:#050d18f5}.detail-lightbox>img{width:100%;height:100%;object-fit:contain;transition:.25s}.detail-lightbox>img.zoomed{transform:scale(1.7)}.detail-lightbox>div{position:fixed;z-index:2;top:0;right:0;left:0;display:flex;align-items:center;gap:12px;padding:12px 18px;background:#081525;color:white}.detail-lightbox>div small{flex:1;color:#ffffffa8}.detail-lightbox a,.detail-lightbox button{border:1px solid #ffffff38;border-radius:7px;padding:7px 10px;background:#0b1a2ddd;color:white;text-decoration:none}.detail-lightbox>.previous,.detail-lightbox>.next{position:fixed;z-index:2;top:50%;font-size:1.8rem}.detail-lightbox>.previous{left:10px}.detail-lightbox>.next{right:10px}.detail-lightbox>.zoom{position:fixed;right:18px;bottom:14px}
  @media(max-width:750px){.profile-hero{grid-template-columns:1fr;min-height:0}.profile-hero>button{height:390px}.profile-hero>div{padding:24px}.extras :global(.profile-gallery>div){grid-template-columns:repeat(2,1fr)}.extras :global(.related-documents>div){grid-template-columns:1fr}}
  @media(max-width:480px){.profile-hero>button{height:330px}.detail-lightbox{padding:58px 8px 12px}.detail-lightbox a{display:none}}
</style>
