---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { MinistryProfile } from '../lib/ministry-profile';
import { getPageSettings } from '../lib/page-settings';
interface Props { title:string; subtitle:string; activePage:string; basePath:string; profiles:MinistryProfile[]; multipleCurrent?:boolean }
const {title,subtitle,activePage,basePath,profiles}=Astro.props;
const sorted=[...profiles].sort((a,b)=>b.year-a.year||a.order-b.order||a.name.localeCompare(b.name));
const currentProfiles=sorted.filter(profile=>profile.current);
const former=sorted.filter(profile=>!profile.current);
const settingsKey=activePage==='bialtu-pastor'?'pastors':activePage==='pro-pastor'?'probationary-pastors':activePage==='kohhran-upa'?'elders':'missionaries';
const ui=await getPageSettings(settingsKey,{hero_caption:'Sihphir Presbyterian Kohhran',hero_title:title,hero_subtitle:subtitle,current_title:`Current ${title}`,former_title:`Former ${title}`,search_placeholder:`Search ${title.toLowerCase()} archive…`,view_profile:'View Profile',empty_message:'No profiles found',sort_label:'Sort',filter_label:'Year',results_label:'profile',back_button:`Back to ${title}`});
---
<BaseLayout title={`${title} — Sihphir Presbyterian Kohhran`} activePage={activePage}>
  <header class="section-hero"><div><p>{ui.hero_caption}</p><h1>{ui.hero_title}</h1><span>{ui.hero_subtitle}</span></div></header>
  <main class="section-page max-w-6xl mx-auto px-4 py-8 sm:py-10">
    <section class="archive-toolbar" data-results-label={ui.results_label}><label><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg><input id="profile-search" type="search" placeholder={ui.search_placeholder} aria-label={ui.search_placeholder} /></label><label><span>{ui.filter_label}</span><select id="profile-year"><option value="all">All years</option>{Array.from(new Set(sorted.map(profile=>profile.year))).sort((a,b)=>b-a).map(year=><option value={year}>{year}</option>)}</select></label><label><span>{ui.sort_label}</span><select id="profile-sort"><option value="newest">Newest</option><option value="oldest">Oldest</option></select></label><p id="profile-count">{profiles.length} {ui.results_label}{profiles.length===1?'':'s'}</p></section>
    <section class="profile-section current-section"><header><div><span>Serving today</span><h2>{ui.current_title}</h2></div></header>{currentProfiles.length?<div class="profile-grid" data-profile-grid>{currentProfiles.map(profile=><article class="profile-card" data-profile data-name={`${profile.name} ${profile.designation} ${profile.description}`.toLowerCase()} data-year={profile.year}><a class="card-photo" href={`${basePath}/${profile.id}`}><img src={profile.photo||'/images/profile-placeholder.svg'} alt={profile.photo?profile.name:''} loading="lazy" /></a><div><h3>{profile.name}</h3><p>{profile.designation}</p>{profile.period&&<span class="service-years">{profile.period}</span>}<a href={`${basePath}/${profile.id}`}>{ui.view_profile} <span>→</span></a></div></article>)}</div>:<div class="no-current"><h3>{ui.empty_message}</h3><p>The former archive remains available below.</p></div>}</section>
    <section class="profile-section former-section"><header><div><span>Service archive</span><h2>{ui.former_title}</h2></div><p>Preserving a record of faithful service.</p></header>{former.length===0&&<div class="no-current"><h3>{ui.empty_message}</h3><p>Historical records will appear here when available.</p></div>}<div class="profile-grid" id="profile-grid">{former.map(profile=><article class="profile-card" data-profile data-name={`${profile.name} ${profile.designation} ${profile.description}`.toLowerCase()} data-year={profile.year}><a class="card-photo" href={`${basePath}/${profile.id}`}><img src={profile.photo||'/images/profile-placeholder.svg'} alt={profile.photo?profile.name:''} loading="lazy" /></a><div><h3>{profile.name}</h3><p>{profile.designation}</p>{profile.period&&<span class="service-years">{profile.period}</span>}<a href={`${basePath}/${profile.id}`}>{ui.view_profile} <span>→</span></a></div></article>)}</div></section>
    <section class="archive-empty" id="archive-empty" hidden><h2>{ui.empty_message}</h2><p>Try another search or clear the year filter.</p><button id="archive-clear">Clear filters</button></section>
  </main>
</BaseLayout>
<script>
  const search=document.querySelector<HTMLInputElement>('#profile-search'),year=document.querySelector<HTMLSelectElement>('#profile-year'),sort=document.querySelector<HTMLSelectElement>('#profile-sort'),count=document.querySelector('#profile-count'),empty=document.querySelector<HTMLElement>('#archive-empty'),toolbar=document.querySelector<HTMLElement>('.archive-toolbar'),resultsLabel=toolbar?.dataset.resultsLabel||'profile',cards=[...document.querySelectorAll<HTMLElement>('[data-profile]')];function filter(){const q=search?.value.trim().toLowerCase()||'',y=year?.value||'all';let visible=0;cards.forEach(card=>{const show=(!q||(card.dataset.name||'').includes(q))&&(y==='all'||card.dataset.year===y);card.hidden=!show;if(show)visible++});document.querySelectorAll<HTMLElement>('.profile-grid').forEach(grid=>[...grid.querySelectorAll<HTMLElement>('[data-profile]')].sort((a,b)=>(sort?.value==='oldest'?1:-1)*(Number(a.dataset.year)-Number(b.dataset.year))).forEach(card=>grid.append(card)));document.querySelectorAll<HTMLElement>('.profile-section').forEach(section=>{const sectionCards=[...section.querySelectorAll<HTMLElement>('[data-profile]')];if(sectionCards.length)section.hidden=!sectionCards.some(card=>!card.hidden)});if(empty)empty.hidden=cards.length===0||visible>0;if(count)count.textContent=`${visible} ${resultsLabel}${visible===1?'':'s'}`;}[search,year].forEach(control=>control?.addEventListener(control===search?'input':'change',filter));sort?.addEventListener('change',filter);document.querySelector('#archive-clear')?.addEventListener('click',()=>{if(search)search.value='';if(year)year.value='all';if(sort)sort.value='newest';filter();search?.focus()});filter();
</script>
<style>
  .section-hero{padding:42px 16px;border-bottom:2px solid #b8953f;background:#142740;color:white;text-align:center}.section-hero>div{max-width:720px;margin:auto}.section-hero p{margin:0 0 8px;color:#d9c78f;font-size:.6rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.section-hero h1{margin:0;font-family:var(--font-display,serif);font-size:clamp(2rem,5vw,2.6rem)}.section-hero span{display:block;margin-top:12px;color:#d8ccaa;font-size:.85rem;line-height:1.6}.section-page{color:#172941}.archive-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:13px;padding:17px;border:1px solid #1427401c;border-radius:14px;background:#fffdf8;box-shadow:0 12px 35px #14243a12}.archive-toolbar>label:first-child{display:flex;align-items:center;gap:10px;border:1px solid #1427402b;border-radius:9px;padding:0 13px;background:white}.archive-toolbar svg{width:18px;fill:none;stroke:#9a772b;stroke-width:1.7}.archive-toolbar input{width:100%;border:0;outline:0;padding:12px 0}.archive-toolbar>label:nth-child(2){display:grid;gap:5px}.archive-toolbar label>span{color:#7c8390;font-size:.56rem;font-weight:700;text-transform:uppercase}.archive-toolbar select{min-width:150px;border:1px solid #14274029;border-radius:8px;padding:9px;background:white}.archive-toolbar>p{grid-column:1/-1;margin:0;color:#7e8590;font-size:.68rem}.profile-section{margin-top:38px}.profile-section>header{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.profile-section>header span{color:#9c7628;font-size:.57rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.profile-section>header h2{margin:4px 0 0;font-family:var(--font-display,serif);font-size:1.5rem}.profile-section>header p{margin:0;color:#7b828d;font-size:.72rem}.current-profile{display:grid;grid-template-columns:minmax(240px,.72fr) minmax(0,1.28fr);min-height:370px;overflow:hidden;border:1px solid #b8953f38;border-radius:16px;background:white;box-shadow:0 14px 38px #17263b17}.current-profile>img{width:100%;height:100%;max-height:480px;object-fit:cover}.current-profile>div{display:grid;align-content:center;padding:32px}.badges{display:flex;flex-wrap:wrap;gap:6px}.badges span{border:1px solid #b8953f38;border-radius:999px;padding:4px 7px;background:#fdf8eb;color:#8e6a25;font-size:.52rem;font-weight:700;text-transform:uppercase}.current-profile h2{margin:13px 0 7px;font-family:var(--font-display,serif);font-size:1.8rem}.current-profile strong{color:#9a7429;font-size:.7rem}.current-profile p{color:#747b87;font-size:.76rem;line-height:1.6}.current-profile blockquote{margin:12px 0;padding:11px 14px;border-left:3px solid #b8953f;background:#fdf9ee;color:#526178;font-family:var(--font-display,serif)}.current-profile a,.profile-card>div>a{justify-self:start;margin-top:13px;border-radius:7px;padding:9px 11px;background:#142740;color:white;text-decoration:none;font-size:.64rem;font-weight:700}.current-profile a span,.profile-card a span{margin-left:7px;color:#e2ca85}.no-current{padding:30px;border:1px solid #14274016;border-radius:13px;background:#fffdf8}.no-current h3{margin:0;font-family:var(--font-display,serif)}.no-current p{color:#7b828d;font-size:.74rem}.profile-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.profile-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid #14274017;border-radius:13px;background:white;box-shadow:0 6px 21px #17263b10;transition:.22s}.profile-card:hover{transform:translateY(-3px);border-color:#b8953f61;box-shadow:0 13px 28px #17263b18}.profile-card[hidden],.profile-section[hidden],.archive-empty[hidden]{display:none}.card-photo{height:190px;overflow:hidden;background:#e9ecee}.card-photo img{width:100%;height:100%;object-fit:cover;transition:.45s}.profile-card:hover .card-photo img{transform:scale(1.055)}.profile-card>div{display:flex;flex:1;flex-direction:column;padding:14px}.profile-card h3{margin:10px 0 4px;font-family:var(--font-display,serif);font-size:1rem}.profile-card>div>p{margin:0;color:#8c6a27;font-size:.62rem;font-weight:700}.profile-card>div>a{margin-top:14px;align-self:flex-start;padding:7px 9px}.archive-empty{display:grid;justify-items:center;margin-top:28px;padding:55px;border:1px solid #14274017;border-radius:14px;background:#fffdf8;text-align:center}.archive-empty h2{margin:0;font-family:var(--font-display,serif)}.archive-empty p{color:#7b828d;font-size:.74rem}.archive-empty button{border:0;border-radius:7px;padding:9px 11px;background:#142740;color:white}
  @media(max-width:900px){.profile-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:650px){.archive-toolbar{grid-template-columns:1fr}.archive-toolbar select{width:100%}.current-profile{grid-template-columns:1fr}.current-profile>img{height:340px}.current-profile>div{padding:21px}.profile-section>header{display:block}.profile-section>header p{margin-top:5px}.profile-grid{grid-template-columns:1fr}.card-photo{height:260px}}
  .archive-toolbar{grid-template-columns:minmax(0,1fr) auto auto}.archive-toolbar>label:nth-child(3){display:grid;gap:5px}.profile-grid{grid-template-columns:repeat(4,minmax(0,180px));justify-content:start;gap:16px}.profile-card{width:100%;max-width:180px;border-radius:11px;box-shadow:0 4px 15px #17263b0d}.profile-card:hover{transform:translateY(-2px);box-shadow:0 9px 21px #17263b14}.card-photo{width:100%;height:220px;aspect-ratio:4/5}.card-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top}.profile-card>div{gap:0;padding:10px}.profile-card h3{margin:0 0 3px;font-size:.86rem;line-height:1.25}.profile-card>div>p{min-height:0;color:#6f7884;font-size:.57rem;font-weight:500;line-height:1.3}.service-years{display:block;margin-top:4px;color:#8b929a;font-size:.52rem;line-height:1.25}.profile-card>div>a{margin-top:8px;padding:5px 7px;font-size:.54rem}
  @media(min-width:1400px){.profile-grid{grid-template-columns:repeat(5,minmax(0,180px))}}
  @media(max-width:1023px){.profile-grid{grid-template-columns:repeat(3,minmax(0,180px))}}
  @media(max-width:650px){.archive-toolbar{grid-template-columns:1fr 1fr}.archive-toolbar>label:first-child{grid-column:1/-1}.archive-toolbar>p{grid-column:1/-1}.profile-grid{grid-template-columns:repeat(2,minmax(0,180px));gap:16px}.profile-card h3{font-size:.8rem}.profile-card>div>a{width:100%;justify-self:stretch;text-align:center}.card-photo{height:auto;aspect-ratio:4/5}}
</style>
