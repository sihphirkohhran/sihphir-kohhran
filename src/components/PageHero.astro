---
interface Props { title: string; subtitle?: string; image?: string; eyebrow?: string; }
const { title, subtitle = '', image = '', eyebrow = 'Sihphir Presbyterian Kohhran' } = Astro.props;
---
<header class="page-hero bg-navy border-b-2 border-gold px-4 py-10 sm:py-12 text-center relative overflow-hidden" style={image ? `background-image:linear-gradient(rgba(13,30,53,.82),rgba(13,30,53,.88)),url('${image}')` : undefined}>
  <div class="absolute inset-0 opacity-[0.04]" style="background-image:repeating-linear-gradient(45deg,#b8953f 0,#b8953f 1px,transparent 1px,transparent 28px)"></div>
  <div class="relative z-10 max-w-3xl mx-auto"><p>{eyebrow}</p><h1>{title}</h1>{subtitle && <div>{subtitle}</div>}<span></span></div>
</header>
<style>
  .page-hero{background-position:center;background-size:cover}.page-hero p{margin:0 0 8px;color:rgba(242,221,163,.58);font-size:.6rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase}.page-hero h1{margin:0;color:#fff;font-family:var(--font-display,serif);font-size:clamp(2rem,5vw,2.55rem);font-weight:600}.page-hero div>div{margin:12px auto 0;color:rgba(242,221,163,.7);font-size:.88rem}.page-hero span{display:block;width:4rem;height:1px;margin:20px auto 0;background:rgba(184,149,63,.5)}
</style>
