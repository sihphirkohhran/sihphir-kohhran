---
interface QuickLink {
  label: string;
  description?: string;
  href: string;
  action?: string;
  visible?: boolean;
  enabled?: boolean;
  order?: number;
  icon?: string;
  open_in_new_tab?: boolean;
  new_tab?: boolean;
  target?: string;
}

interface Props {
  links: QuickLink[];
  heading?: string;
  subtitle?: string;
}

const { links, heading = 'Quick Links', subtitle = '' } = Astro.props;
const visibleLinks = links
  .filter((link) => link.visible !== false && link.enabled !== false)
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

const iconPaths: Record<string, string> = {
  'tab-weekly': 'M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v13H3V6a2 2 0 0 1 2-2Zm2 10h3m-3 4h6',
  'tab-monthly': 'M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v13H3V6a2 2 0 0 1 2-2Zm3 10h2m4 0h2m-8 4h2m4 0h2',
  'tab-notices': 'M4 4h16v16H4zM8 8h8M8 12h8M8 16h5',
};
const fallbackIcon = 'M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4m-7-7h7v7m0-7L10 17';
---

{visibleLinks.length > 0 && (
  <section class="border-b border-gold/15 bg-cream px-4 py-5 sm:py-6" id="quick-links">
    <div class="mx-auto max-w-4xl">
      <div class="gold-divider mb-4">
        <h2>{heading}</h2>
        {subtitle && <p>{subtitle}</p>}
      </div>

      <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
        {visibleLinks.map((link) => {
          const opensNewTab = link.open_in_new_tab || link.new_tab || link.target === '_blank';
          const iconPath = iconPaths[link.action ?? ''] ?? fallbackIcon;
          return (
            <a
              href={link.href}
              class="quick-link-card group flex h-full min-h-[4.25rem] min-w-0 items-center gap-3 rounded border border-gold/25 bg-ivory px-3 py-2.5 transition-colors duration-150 hover:border-gold/60 hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
              data-quick-action={link.action ?? ''}
              target={opensNewTab ? '_blank' : undefined}
              rel={opensNewTab ? 'noopener noreferrer' : undefined}
            >
              {link.icon ? (
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded border border-gold/20 bg-cream text-base text-navy">
                  {link.icon}
                </span>
              ) : (
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded border border-gold/20 bg-cream text-navy">
                  <svg class="h-[1.05rem] w-[1.05rem]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d={iconPath} />
                  </svg>
                </span>
              )}
              <span class="min-w-0 flex-1">
                <span class="block break-words font-body text-sm font-semibold leading-snug text-navy transition-colors group-hover:text-navy-light">
                  {link.label}
                </span>
                {link.description && (
                  <span class="mt-0.5 block break-words font-body text-xs leading-snug text-navy/65">
                    {link.description}
                  </span>
                )}
              </span>
              <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-gold/75 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}
