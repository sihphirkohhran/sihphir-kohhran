---
interface Props {channel:string;home?:boolean}
const {channel,home=false}=Astro.props;
---
<section class:list={["yt-gallery bg-ivory py-8 px-4", home && "yt-home"]} data-youtube-gallery data-home={String(home)} aria-label={home ? "Kohhran Videos" : undefined}>
 <div class:list={["mx-auto", home ? "max-w-5xl" : "max-w-6xl"]}>
 {home ? (
 <div class="yt-home-head">
  <div class="gold-divider"><h2>Kohhran Videos</h2></div>
 </div>
 ) : (
 <>
  <p class="yt-eyebrow">WATCH &amp; LISTEN</p>
  <h2 class="font-display text-navy text-2xl font-bold">Kohhran Videos</h2>
 </>
 )}
 {!home && (
 <div class="yt-controls"><a href={channel} target="_blank" rel="noopener noreferrer">Visit YouTube Channel ↗</a></div>
 )}
 <p data-status role="status">Loading videos…</p>
 <div class:list={['yt-list',home?'yt-carousel':'yt-grid']} data-list aria-label={home ? "Latest YouTube videos" : undefined}></div>
 {home && (
 <div class="yt-home-actions">
  <div class="yt-home-nav" aria-label="Video carousel navigation">
   <div class="yt-nav-buttons">
    <button type="button" data-prev aria-label="Previous videos" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
    <button type="button" data-next aria-label="Next videos" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
   </div>
  </div>
  <a class="yt-channel" href={channel} target="_blank" rel="noopener noreferrer">Visit YouTube Channel <span aria-hidden="true">↗</span></a>
 </div>
 )}
 {!home&&<button type="button" data-more hidden>Load More</button>}
 <noscript>Visit the official YouTube channel to watch videos.</noscript>
 <dialog data-player aria-label="Video player"><button type="button" data-close autofocus aria-label="Close video">Close ×</button><div data-frame></div><a data-watch target="_blank" rel="noopener noreferrer">Open on YouTube ↗</a></dialog>
 </div>
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-youtube-gallery]').forEach(root=>{
 const list=root.querySelector<HTMLElement>('[data-list]')!, status=root.querySelector<HTMLElement>('[data-status]')!, more=root.querySelector<HTMLButtonElement>('[data-more]'), dialog=root.querySelector<HTMLDialogElement>('[data-player]')!, frame=root.querySelector<HTMLElement>('[data-frame]')!, watch=root.querySelector<HTMLAnchorElement>('[data-watch]')!;
 const home=root.dataset.home==='true';const previous=root.querySelector<HTMLButtonElement>('[data-prev]');const next=root.querySelector<HTMLButtonElement>('[data-next]');
 const updateNavigation=()=>{if(!home)return;const max=Math.max(0,list.scrollWidth-list.clientWidth);const atStart=list.scrollLeft<=2;const atEnd=list.scrollLeft>=max-2; if(previous)previous.disabled=atStart;if(next)next.disabled=atEnd;};
 list.addEventListener('scroll',updateNavigation,{passive:true});if(home&&typeof ResizeObserver!=='undefined'){const observer=new ResizeObserver(updateNavigation);observer.observe(list);root.addEventListener('astro:before-swap',()=>observer.disconnect(),{once:true});}else if(home)window.addEventListener('resize',updateNavigation);
 let page='',busy=false;let opener:HTMLButtonElement|null=null;const close=root.querySelector<HTMLButtonElement>('[data-close]')!;const cursors=new Set<string>();const seen=new Set<string>();
 async function load(){
 if(busy)return;busy=true;status.textContent='Loading videos…';if(more)more.disabled=true;
 try{
 const response=await fetch('/api/videos'+(page?'?page='+encodeURIComponent(page):''));if(!response.ok)throw Error();
 const data=await response.json();const before=seen.size;cursors.add(page);
 for(const video of (home?data.videos.slice(0,6):data.videos)){
 if(!/^[A-Za-z0-9_-]{11}$/.test(video.id)||seen.has(video.id))continue;seen.add(video.id);
 const card=document.createElement('article'), button=document.createElement('button'), image=document.createElement('img'), play=document.createElement('span'), title=document.createElement('h3');
 button.type='button';button.className='yt-thumb';button.setAttribute('aria-label','Play '+video.title);
 image.src='https://i.ytimg.com/vi/'+video.id+'/hqdefault.jpg';image.alt='';image.loading='lazy';image.onerror=()=>{image.hidden=true;};
 play.className='yt-play';play.textContent='▶';button.append(image,play);title.textContent=video.title;
 button.onclick=()=>{const url='https://www.youtube.com/watch?v='+video.id;if(!video.embeddable){window.open(url,'_blank','noopener,noreferrer');return;}const iframe=document.createElement('iframe');iframe.src='https://www.youtube-nocookie.com/embed/'+video.id+'?autoplay=1';iframe.title=video.title;iframe.allow='autoplay; encrypted-media; picture-in-picture';iframe.allowFullscreen=true;frame.replaceChildren(iframe);watch.href=url;opener=button;dialog.showModal();close.focus();};
 if(home){card.className='yt-home-card';const body=document.createElement('div');body.className='yt-card-body';body.append(title);card.append(button,body);}else{card.append(button,title);}
 if(!home&&video.date){const date=document.createElement('p');const d=new Date(video.date);if(Number.isFinite(d.getTime())){date.textContent=d.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});card.append(date);}}
 list.append(card);
 }
 if(home)requestAnimationFrame(updateNavigation);
 page=typeof data.nextPage==='string'&&!cursors.has(data.nextPage)?data.nextPage:'';if(more){more.hidden=!page;more.textContent='Load More';}status.textContent=seen.size===before?(page?'No additional public videos in this batch. Select Load More to continue.':seen.size?'All available videos loaded.':'No public videos available yet.'):'';if(home)status.textContent=seen.size?'':page?'More uploads may be available in the video gallery.':'No public videos available yet.';
 }catch{status.textContent='Videos are temporarily unavailable. Please visit our YouTube channel.';if(more){more.hidden=false;more.textContent='Retry';}}finally{busy=false;if(more)more.disabled=false;}
 }
 more?.addEventListener('click',load);
 previous?.addEventListener('click',()=>list.scrollBy({left:-list.clientWidth,behavior:'smooth'}));
 next?.addEventListener('click',()=>list.scrollBy({left:list.clientWidth,behavior:'smooth'}));
 close.addEventListener('click',()=>dialog.close());dialog.addEventListener('cancel',event=>{event.preventDefault();dialog.close();});dialog.addEventListener('close',()=>{frame.replaceChildren();opener?.focus();opener=null;});load();
 });
</script>
<style>
 .yt-gallery{overflow:hidden}
 .yt-eyebrow{color:#806326;letter-spacing:.12em;font-size:.75rem}
 .yt-controls{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:12px 0;color:#172941}
 .yt-controls a{text-decoration:underline}
 [data-more],[data-close]{min-height:44px;padding:8px 16px;background:#172941;color:white;border-radius:5px}
 .yt-list{gap:14px;min-width:0}
 .yt-carousel{display:flex;overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x mandatory;scrollbar-width:none;-ms-overflow-style:none;scroll-padding-inline:1px}
 .yt-carousel::-webkit-scrollbar{display:none}
 .yt-carousel :global(article){flex:0 0 calc((100% - 42px)/4);min-width:0;scroll-snap-align:start}
 .yt-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
 .yt-list :global(.yt-thumb){position:relative;display:block;width:100%;aspect-ratio:16/9;background:#172941;border-radius:6px;overflow:hidden}
 .yt-list :global(img){width:100%;height:100%;object-fit:cover}
 .yt-list :global(.yt-play){position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#c90000;color:white;padding:8px 18px;border-radius:9px}
 .yt-list :global(h3){font-weight:600;color:#172941;margin:8px 0;overflow-wrap:anywhere}
 .yt-list :global(p){font-size:.85rem;color:#596474}
 .yt-home-head{text-align:center}
 .yt-home .gold-divider{margin-bottom:12px}
 .yt-home .gold-divider h2{font-family:'EB Garamond',serif;font-weight:600}
 .yt-home-nav{display:flex;align-items:center;justify-content:flex-start}
 .yt-nav-buttons{display:flex;gap:8px}
 .yt-nav-buttons button{display:grid;place-items:center;width:40px;height:40px;border:1px solid rgba(15,31,61,.18);border-radius:50%;color:var(--navy);background:#fffdf8;transition:background-color .18s,border-color .18s,opacity .18s}
 .yt-nav-buttons svg{width:16px;height:16px}
 .yt-nav-buttons button:hover:not(:disabled){background:var(--navy);color:#fff;border-color:var(--navy)}
 .yt-nav-buttons button:disabled{opacity:.3;cursor:not-allowed}
 .yt-home .yt-carousel{gap:12px;padding:4px 4px 7px;margin:-4px -4px -7px}
 .yt-home .yt-carousel :global(article){flex-basis:calc((100% - 24px)/3)}
 .yt-home .yt-carousel :global(.yt-home-card){display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(18,35,59,.1);border-radius:8px;background:white;box-shadow:0 2px 8px rgba(23,38,59,.05);transition:border-color .18s ease,box-shadow .18s ease}
 .yt-home .yt-carousel :global(.yt-home-card:hover){border-color:rgba(184,149,63,.48);box-shadow:0 4px 12px rgba(23,38,59,.09)}
 .yt-home .yt-carousel :global(.yt-home-card:focus-within){outline:2px solid var(--gold);outline-offset:2px}
 .yt-home .yt-carousel :global(.yt-thumb){border-radius:0;border:0;flex-shrink:0}
 .yt-home .yt-carousel :global(.yt-thumb:focus-visible){outline:2px solid var(--gold);outline-offset:-3px}
 .yt-home .yt-carousel :global(.yt-card-body){flex:1;padding:9px 10px 10px}
 .yt-home .yt-carousel :global(.yt-play){display:grid;place-items:center;width:36px;height:26px;padding:0;border-radius:6px;font-size:.8rem;box-shadow:0 2px 9px rgba(0,0,0,.23)}
 .yt-home .yt-carousel :global(h3){font-family:'Poppins',sans-serif;font-size:.75rem;line-height:1.4;font-weight:700;margin:0;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2;overflow:hidden;min-height:2.8em}
 .yt-home [data-status]{line-height:1.1rem;font-size:.65rem;color:#596474;margin-bottom:.35rem}
 .yt-home [data-status]:empty{margin:0}
 .yt-home-actions{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 16px;margin-top:12px}
 .yt-home-actions a{display:inline-flex;align-items:center;gap:7px;font-family:'Poppins',sans-serif;font-size:.71rem;font-weight:600;min-height:44px;text-decoration:none}
 .yt-home-actions .yt-channel{color:var(--navy);border-bottom:1px solid rgba(15,31,61,.35)}
 .yt-home-actions .yt-channel:hover{border-bottom-color:var(--navy)}
 .yt-home-actions a:focus-visible,.yt-nav-buttons button:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
 dialog{width:min(92vw,850px);padding:16px;background:#fffdf8;border-radius:8px;margin:auto}
 dialog::backdrop{background:#000b}
 [data-frame]{aspect-ratio:16/9;margin:10px 0}
 [data-frame] :global(iframe){width:100%;height:100%;border:0}
 @media(max-width:900px){.yt-carousel :global(article){flex-basis:calc((100% - 28px)/3)}.yt-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.yt-home .yt-carousel :global(article){flex-basis:calc((100% - 12px)/2)}}
 @media(max-width:600px){.yt-home .yt-home-nav{display:none}.yt-home-actions{justify-content:flex-end}.yt-carousel :global(article){flex-basis:75%}.yt-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.yt-home .yt-carousel :global(article){flex-basis:78%}}
 @media(max-width:360px){.yt-grid{grid-template-columns:1fr}.yt-home .yt-carousel :global(article){flex-basis:82%}}
 @media(prefers-reduced-motion:reduce){.yt-home .yt-carousel :global(.yt-home-card),.yt-nav-buttons button{transition:none}}
</style>
