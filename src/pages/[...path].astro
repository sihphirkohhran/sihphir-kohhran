---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import DynamicPage from '../components/DynamicPage.astro';
import { getCollection } from 'astro:content';
import { isPublicPage, pageUrlPath } from '../lib/pages';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter(isPublicPage)
    .map((page) => {
      const urlPath = pageUrlPath(page.slug, page.data.path).replace(/^\//, '').replace(/\/$/, '');
      return {
        params: { path: urlPath },
        props: { page },
      };
    });
}

const { page } = Astro.props;
if (page.data.page_type === 'redirect' && page.data.redirect_url) {
  return Astro.redirect(page.data.redirect_url, 302);
}
const { Content } = await page.render();
const activeKey = page.data.nav_key || page.slug;
const managed = Boolean(page.data.page_type || page.data.status || page.data.updated_at);
---

{managed ? <DynamicPage page={page} Content={Content} /> : <ContentPageLayout
  title={page.data.title}
  description={page.data.description}
  activeKey={activeKey}
>
  <Content />
</ContentPageLayout>}
