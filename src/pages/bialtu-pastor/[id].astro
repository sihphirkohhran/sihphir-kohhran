---
import {getCollection} from 'astro:content';import PastorDetail from '../../components/PastorDetail.astro';import {normalizeMinistryProfile} from '../../lib/ministry-profile';
export async function getStaticPaths(){const profiles=(await getCollection('pastoral')).map(entry=>normalizeMinistryProfile(entry,'pastor')).filter((profile):profile is NonNullable<typeof profile>=>Boolean(profile));return profiles.map(profile=>({params:{id:profile.id},props:{profile}}))}
const {profile}=Astro.props;
---
<PastorDetail profile={profile}/>
