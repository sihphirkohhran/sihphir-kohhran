---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveFilterBar from '../components/ArchiveFilterBar.astro';
import { getCollection, getEntry } from 'astro:content';
import {
  buildYearsByCommittee,
  committeeKey,
  resolveCommitteePhoto,
  type CommitteeRecord,
} from '../lib/committee';

const committeeRegistry = await getEntry('settings', 'committees');
const committees = committeeRegistry?.data.committees ?? [];

const committeeEntries = await getCollection('committee');
const committeeByKey: Record<string, CommitteeRecord> = Object.fromEntries(
  committeeEntries.map((entry) => [committeeKey(entry.data.committee_id, entry.data.year), entry.data]),
);
const yearsByCommittee = buildYearsByCommittee(committeeEntries);

const defaultCommittee = committees.find((c) => c.is_main) ?? committees[0];
const defaultId = defaultCommittee?.id ?? 'kohhran';
const defaultYears = yearsByCommittee[defaultId] ?? [];
const defaultYear =
  committeeEntries.find((e) => e.data.committee_id === defaultId)?.data.year
  ?? defaultYears[0]
  ?? new Date().getFullYear();

const defaultData = defaultYear
  ? committeeByKey[committeeKey(defaultId, defaultYear)]
  : undefined;

const defaultMembers = defaultData?.members ?? [];
const defaultPhoto = resolveCommitteePhoto(defaultData?.group_photo);
---

<BaseLayout title="Committee — Sihphir Presbyterian Kohhran" activePage="committee">

  <div class="bg-navy border-b-2 border-gold px-4 py-8 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]"
      style="background-image: repeating-linear-gradient(45deg, #b8953f 0px, #b8953f 1px, transparent 1px, transparent 28px);">
    </div>
    <div class="relative z-10">
      <p class="font-body text-[0.6rem] tracking-[0.14em] uppercase text-gold-pale/50 mb-2">Sihphir Presbyterian Kohhran</p>
      <h1 class="font-display text-white text-2xl sm:text-3xl font-semibold">Committee Members</h1>
      <div class="w-16 h-px bg-gold/40 mx-auto mt-3"></div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-8">

    <div class="archive-filters-row reveal">
      <div class="flex-1 min-w-[200px]">
        <label class="font-body text-[0.65rem] tracking-widest uppercase text-gray-400 block mb-1.5">Select Committee</label>
        <select id="committee-select"
          class="archive-filter-select w-full border border-navy/20 rounded px-3 py-2.5 font-body text-sm text-navy bg-ivory focus:outline-none focus:border-navy/60 transition-colors">
          {committees.map((c) => (
            <option value={c.id} selected={c.id === defaultId}>{c.name}</option>
          ))}
        </select>
      </div>
      <ArchiveFilterBar
        id="year-select"
        label="Year"
        showAll={false}
        options={(defaultYears.length ? defaultYears : [defaultYear]).map((y) => ({
          value: String(y),
          label: String(y),
        }))}
      />
    </div>

    <div id="committee-card" class="reveal committee-panel">
      <div class="committee-panel-header">
        <h2 id="committee-title" class="committee-panel-title">
          {defaultData?.committee_name ?? defaultCommittee?.name}
        </h2>
        <p class="committee-panel-year" id="committee-year-label">Year: {defaultYear}</p>
      </div>

      <div class="committee-leaders" id="leaders-section">
        <dl class="committee-leader-block">
          <dt>Chairman</dt>
          <dd id="chairman-name">{defaultData?.chairman ?? '—'}</dd>
        </dl>
        <dl class="committee-leader-block">
          <dt>Secretary</dt>
          <dd id="secretary-name">{defaultData?.secretary ?? '—'}</dd>
        </dl>
      </div>

      <div id="members-section">
        <h3 class="committee-members-heading">Members</h3>

        <div class="committee-members-desktop">
          <table class="committee-table w-full" id="members-table">
            <thead>
              <tr>
                <th class="w-10">#</th>
                <th>Name</th>
                <th>Role</th>
              </tr>
            </thead>
            <tbody id="members-tbody">
              {defaultMembers.map((m, i) => (
                <tr>
                  <td>{i + 1}</td>
                  <td>{m.name}</td>
                  <td class="committee-role">{m.role ?? 'Member'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="committee-members-mobile" id="members-mobile">
          {defaultMembers.map((m, i) => (
            <div class="committee-member-card">
              <span class="num">{i + 1}</span>
              <div>
                <div class="font-display text-navy font-semibold text-base leading-snug">{m.name}</div>
                <div class="font-body text-sm text-gray-600 mt-0.5">{m.role ?? 'Member'}</div>
              </div>
            </div>
          ))}
        </div>

        <p id="no-members-msg" class={`font-body text-sm text-gray-500 py-6 text-center px-4 ${defaultMembers.length ? 'hidden' : ''}`}>
          No committee record for this year. Add one in Admin → Committee Members.
        </p>
      </div>

      <div class="px-4 sm:px-6 py-4 border-t border-navy/10" id="group-photo-section">
        <div id="group-photo-wrap" class={defaultPhoto ? '' : 'hidden'} style={defaultPhoto ? '' : 'display:none;'}>
          <img
            id="group-photo"
            src={defaultPhoto}
            alt="Committee group photo"
            class="committee-group-photo"
            loading="lazy"
            data-lightbox
            data-lightbox-src={defaultPhoto}
            data-lightbox-caption={`${defaultData?.committee_name ?? defaultCommittee?.name} : ${defaultYear}`}
          />
          <p id="group-photo-caption" class="committee-group-caption">
            {defaultData?.committee_name ?? defaultCommittee?.name} : {defaultYear}
          </p>
        </div>
        <div id="group-photo-placeholder" class="committee-group-photo-placeholder" style={defaultPhoto ? 'display:none;' : ''}>
          No group photo for this year. Upload in Admin → Committee Members.
        </div>
      </div>
    </div>

    <div class="mt-8 reveal">
      <div class="gold-divider mb-4">
        <h3 style="font-size:1rem">All Committees</h3>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {committees.map((c) => (
          <button
            type="button"
            class={`committee-quick-btn ${c.id === defaultId ? 'is-active' : ''} ${c.is_main ? 'is-main' : ''}`}
            data-committee={c.id}
          >
            {c.is_main && (
              <span class="text-[0.6rem] tracking-widest uppercase text-gold/80 block mb-0.5">Main</span>
            )}
            {c.name}
          </button>
        ))}
      </div>
    </div>

  </div>

</BaseLayout>

<script define:vars={{ committeeByKey, committees, yearsByCommittee }}>
  function resolvePhoto(photo) {
    if (!photo?.trim()) return '';
    const s = photo.trim();
    if (s.startsWith('http://') || s.startsWith('https://')) return s;
    if (s.startsWith('/')) return s;
    return '/' + s.replace(/^\.?\//, '');
  }

  const select = document.getElementById('committee-select');
  const yearSelect = document.getElementById('year-select');
  const titleEl = document.getElementById('committee-title');
  const yearLabel = document.getElementById('committee-year-label');
  const chairmanEl = document.getElementById('chairman-name');
  const secretaryEl = document.getElementById('secretary-name');
  const tbody = document.getElementById('members-tbody');
  const mobileList = document.getElementById('members-mobile');
  const noMsg = document.getElementById('no-members-msg');
  const membersSection = document.getElementById('members-section');
  const photoWrap = document.getElementById('group-photo-wrap');
  const photoPlaceholder = document.getElementById('group-photo-placeholder');
  const photoEl = document.getElementById('group-photo');
  const captionEl = document.getElementById('group-photo-caption');
  const quickBtns = document.querySelectorAll('.committee-quick-btn');

  function syncYearOptions(committeeId, preferredYear) {
    if (!yearSelect) return;
    const years = yearsByCommittee[committeeId] ?? [];
    const list = years.length ? years : [new Date().getFullYear()];
    const prev = preferredYear || yearSelect.value;
    yearSelect.innerHTML = list
      .map((y) => `<option value="${y}">${y}</option>`)
      .join('');
    const pick = list.includes(Number(prev)) ? prev : String(list[0]);
    yearSelect.value = pick;
  }

  function setQuickActive(id) {
    quickBtns.forEach((btn) => {
      btn.classList.toggle('is-active', btn.dataset.committee === id);
    });
  }

  function renderMembers(data, committeeMeta, year) {
    const members = data?.members ?? [];
    const hasRecord = Boolean(data);
    const hasMembers = members.length > 0;

    if (chairmanEl) chairmanEl.textContent = data?.chairman?.trim() || '—';
    if (secretaryEl) secretaryEl.textContent = data?.secretary?.trim() || '—';
    if (captionEl) {
      captionEl.textContent = `${data?.committee_name ?? committeeMeta?.name ?? 'Committee'} : ${year}`;
    }

    const photo = resolvePhoto(data?.group_photo);
    if (photo && photoEl && photoWrap && photoPlaceholder) {
      photoEl.src = photo;
      photoEl.dataset.lightboxSrc = photo;
      photoEl.dataset.lightboxCaption = `${data?.committee_name ?? committeeMeta?.name ?? 'Committee'} : ${year}`;

      photoEl.onload = () => {
        photoWrap.style.display = '';
        photoPlaceholder.style.display = 'none';
      };
      photoEl.onerror = () => {
        photoWrap.style.display = 'none';
        photoPlaceholder.style.display = 'block';
        photoPlaceholder.textContent = 'Group photo could not be loaded.';
      };
      photoWrap.style.display = '';
      photoPlaceholder.style.display = 'none';
    } else {
      if (photoWrap) photoWrap.style.display = 'none';
      if (photoPlaceholder) {
        photoPlaceholder.style.display = 'block';
        photoPlaceholder.textContent = hasRecord
          ? 'No group photo for this year. Upload in Admin → Committee Members.'
          : 'No committee record for this year.';
      }
    }

    if (!hasRecord || !hasMembers) {
      tbody && (tbody.innerHTML = '');
      mobileList && (mobileList.innerHTML = '');
      noMsg?.classList.remove('hidden');
      membersSection?.querySelector('.committee-members-heading')?.classList.add('hidden');
      membersSection?.querySelector('.committee-members-desktop')?.classList.add('hidden');
      membersSection?.querySelector('.committee-members-mobile')?.classList.add('hidden');
      if (!hasRecord && noMsg) {
        noMsg.textContent = 'No committee record for this year. Add one in Admin → Committee Members.';
      } else if (noMsg) {
        noMsg.textContent = 'No members listed for this committee year.';
        noMsg.classList.remove('hidden');
      }
      return;
    }

    noMsg?.classList.add('hidden');
    membersSection?.querySelector('.committee-members-heading')?.classList.remove('hidden');
    membersSection?.querySelector('.committee-members-desktop')?.classList.remove('hidden');
    membersSection?.querySelector('.committee-members-mobile')?.classList.remove('hidden');

    const rows = members
      .map(
        (m, i) => `
        <tr>
          <td>${i + 1}</td>
          <td>${escapeHtml(m.name)}</td>
          <td class="committee-role">${escapeHtml(m.role || 'Member')}</td>
        </tr>`,
      )
      .join('');
    if (tbody) tbody.innerHTML = rows;

    if (mobileList) {
      mobileList.innerHTML = members
        .map(
          (m, i) => `
          <div class="committee-member-card">
            <span class="num">${i + 1}</span>
            <div>
              <div class="font-display text-navy font-semibold text-base leading-snug">${escapeHtml(m.name)}</div>
              <div class="font-body text-sm text-gray-600 mt-0.5">${escapeHtml(m.role || 'Member')}</div>
            </div>
          </div>`,
        )
        .join('');
    }
  }

  function escapeHtml(text) {
    return String(text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function updateDisplay() {
    const id = select?.value;
    const year = yearSelect?.value;
    if (!id) return;
    const committeeMeta = committees.find((c) => c.id === id);
    const data = committeeByKey[`${id}-${year}`];
    if (titleEl) titleEl.textContent = data?.committee_name ?? committeeMeta?.name ?? '';
    if (yearLabel) yearLabel.textContent = `Year: ${year}`;
    renderMembers(data, committeeMeta, year);
    setQuickActive(id);
  }

  select?.addEventListener('change', () => {
    syncYearOptions(select.value);
    updateDisplay();
  });
  yearSelect?.addEventListener('change', updateDisplay);

  quickBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (select) select.value = btn.dataset.committee || '';
      syncYearOptions(select.value);
      updateDisplay();
      document.getElementById('committee-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  updateDisplay();
</script>
