---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { resolveCommitteePhoto } from '../lib/committee';
import { renderMarkdown } from '../lib/markdown';
import { getPageSettings } from '../lib/page-settings';

const ui=await getPageSettings('committee',{hero_caption:'Sihphir Presbyterian Kohhran',hero_title:'Church Committees',hero_subtitle:'Meet the committees serving the church across its ministries and responsibilities.',history_title:'History',office_bearers_title:'Office Bearers',members_title:'Committee Members',gallery_title:'Gallery',documents_title:'Documents',search_placeholder:'Search committees…',empty_message:'No committees found',back_button:'Back to committees',view_button:'View Committee'});

const masterEntry = await getEntry('settings', 'committees');
const committeeMaster = new Map((masterEntry?.data.committees ?? []).map((item) => [item.id, item.name]));
const entries = (await getCollection('committee'))
  .filter((entry) => entry.data.status !== 'archived' && entry.data.published !== false)
  .sort((a, b) => b.data.year - a.data.year || (a.data.display_order ?? 999) - (b.data.display_order ?? 999));

const committees = entries.map((entry) => {
  const data = entry.data;
  const members = [...data.members]
    .map((member, index) => ({
      name: member.name,
      designation: member.designation || member.role || 'Member',
      photo: resolveCommitteePhoto(member.photo),
      phone: member.phone || '',
      email: member.email || '',
      address: member.address || '',
      bio: member.bio || member.notes || '',
      order: member.display_order ?? index,
    }))
    .sort((a, b) => a.order - b.order);
  const addLegacyLeader = (name: string, designation: string) => {
    if (name?.trim() && !members.some((member) => member.name.toLowerCase() === name.toLowerCase())) members.unshift({ name, designation, photo: '', phone: '', email: '', address: '', bio: '', order: -1 });
  };
  addLegacyLeader(data.secretary, 'Secretary');
  addLegacyLeader(data.chairman, 'Chairman');
  const officeRole = /^(chairman|chairperson|vice chairman|vice chairperson|president|vice president|secretary|joint secretary|assistant secretary|treasurer|financial secretary|finance secretary|adviser|advisor|coordinator)$/i;
  const officeOrder = ['chairman', 'chairperson', 'president', 'vice chairman', 'vice chairperson', 'vice president', 'secretary', 'joint secretary', 'assistant secretary', 'treasurer', 'financial secretary', 'finance secretary', 'adviser', 'advisor', 'coordinator'];
  const officeBearers = members
    .filter((member) => officeRole.test(member.designation.trim()))
    .sort((a, b) => officeOrder.indexOf(a.designation.toLowerCase()) - officeOrder.indexOf(b.designation.toLowerCase()));
  const directoryMembers = members.filter((member) => !officeRole.test(member.designation.trim()));
  const body = entry.body?.trim() || data.description || '';
  return {
    id: entry.id.replace(/[^a-z0-9]+/gi, '-'),
    committeeId: data.committee_id,
    name: committeeMaster.get(data.committee_id) || data.committee_name,
    year: data.year,
    photo: resolveCommitteePhoto(data.group_photo),
    description: data.description || body.replace(/<[^>]*>/g, ' ').replace(/[#*_>`]/g, '').trim(),
    descriptionHtml: renderMarkdown(body),
    memberCount: members.length,
    officeBearers,
    members: directoryMembers,
    featured: Boolean(data.featured),
  };
});

const featured = committees.filter((committee) => committee.featured);
const archive = committees.filter((committee) => !committee.featured);
const years = Array.from(new Set(committees.map((committee) => committee.year))).sort((a, b) => b - a);
const currentYear = new Date().getFullYear();
const defaultYear = years.includes(currentYear) ? currentYear : years[0];
const defaultCount = committees.filter((committee) => committee.year === defaultYear).length;
const yearsByCommittee = new Map<string, number[]>();
for (const committee of committees) {
  const available = yearsByCommittee.get(committee.committeeId) ?? [];
  if (!available.includes(committee.year)) available.push(committee.year);
  yearsByCommittee.set(committee.committeeId, available.sort((a, b) => b - a));
}
const defaultCommitteePhoto = '/images/church.jpg';
const defaultMemberPhoto = '/images/pastor.jpg';
---

<BaseLayout title="Committees — Sihphir Presbyterian Kohhran" activePage="committee">
  <div class="committee-hero bg-navy border-b-2 border-gold px-4 py-10 sm:py-12 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image:repeating-linear-gradient(45deg,#b8953f 0,#b8953f 1px,transparent 1px,transparent 28px)"></div>
    <div class="relative z-10 max-w-2xl mx-auto">
      <p class="font-body text-[0.6rem] tracking-[0.16em] uppercase text-gold-pale/55 mb-2">{ui.hero_caption}</p>
      <h1 class="font-display text-white text-3xl sm:text-4xl font-semibold">{ui.hero_title}</h1>
      <p class="font-body text-gold-pale/60 text-sm mt-3">{ui.hero_subtitle}</p>
      <div class="w-16 h-px bg-gold/50 mx-auto mt-5"></div>
    </div>
  </div>

  <main class="committee-public max-w-6xl mx-auto px-4 py-8 sm:py-10" data-view-label={ui.view_button}>
    <section class="committee-filters reveal" aria-label="Committee filters">
      <label class="committee-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg><span class="sr-only">{ui.search_placeholder}</span><input type="search" id="committee-search" placeholder={ui.search_placeholder} autocomplete="off"></label>
      <div><label><span>Year</span><select id="committee-year">{years.map((year) => <option value={year} selected={year === defaultYear}>{year === currentYear ? `${year} — This Year` : year}</option>)}</select></label></div>
      <p id="committee-count">{defaultCount} committee{defaultCount === 1 ? '' : 's'}</p>
    </section>

    {featured.length > 0 && <section class="committee-section" id="featured-committees"><header class="section-heading reveal"><div><span>Serving the church</span><h2>Featured Committees</h2></div><p>Highlighted committees and their current members.</p></header><div class="committee-grid featured-grid">{featured.map((committee, index) => <article class={`committee-card featured reveal reveal-delay-${index % 3 + 1}`} data-committee-card data-name={committee.name.toLowerCase()} data-year={committee.year}><div class="committee-cover"><img src={committee.photo || defaultCommitteePhoto} alt={`${committee.name} committee`} loading="lazy" data-fallback={defaultCommitteePhoto} /><span>Featured</span></div><div class="committee-card-body"><div class="badges"><span>{committee.year}</span></div><h3>{committee.name}</h3><p>{committee.description || 'A committee serving Sihphir Presbyterian Kohhran.'}</p><footer><span>{committee.memberCount} members</span><button type="button" data-view-committee={committee.id}>View Committee</button></footer></div></article>)}</div></section>}

    <section class="committee-section archive-section"><div class="committee-grid archive-grid">{archive.map((committee, index) => <article class={`committee-card reveal reveal-delay-${index % 3 + 1}`} data-committee-card data-name={committee.name.toLowerCase()} data-year={committee.year}><div class="committee-cover"><img src={committee.photo || defaultCommitteePhoto} alt={`${committee.name} committee`} loading="lazy" data-fallback={defaultCommitteePhoto} /></div><div class="committee-card-body"><div class="badges"><span>{committee.year}</span></div><h3>{committee.name}</h3><p>{committee.description || 'A committee serving Sihphir Presbyterian Kohhran.'}</p><footer><span>{committee.memberCount} members</span><button type="button" data-view-committee={committee.id}>View Committee</button></footer></div></article>)}</div></section>

    <section class="committee-empty" id="committee-empty" hidden><h2>{ui.empty_message}</h2><p>Try another search or clear the selected filters.</p><button type="button" id="committee-clear">Clear filters</button></section>

    {committees.map((committee) => <section class="committee-detail" id={`committee-detail-${committee.id}`} data-committee-detail data-committee-id={committee.committeeId} data-year={committee.year} hidden>
      <button type="button" class="detail-back" data-close-committee>← {ui.back_button}</button>
      <div class="detail-hero"><button type="button" class="detail-photo" data-lightbox-src={committee.photo || defaultCommitteePhoto} data-lightbox-alt={`${committee.name} committee group photo`} aria-label={`View ${committee.name} group photo fullscreen`}><img src={committee.photo || defaultCommitteePhoto} alt={`${committee.name} committee`} loading="lazy" data-fallback={defaultCommitteePhoto} /></button><div class="detail-hero-caption"><div class="badges"><span>{committee.year}</span></div><h2>{committee.name}</h2><p>{committee.memberCount} committee members</p></div></div>
      <label class="committee-year-switcher"><span>Year</span><select data-committee-year-switch>{yearsByCommittee.get(committee.committeeId)?.map((year) => <option value={year} selected={year === committee.year}>{year}</option>)}</select></label>
      {committee.descriptionHtml && <div class="detail-description prose" set:html={committee.descriptionHtml}></div>}
      {committee.officeBearers.length > 0 && <section class="directory-section office-section"><div class="members-heading"><h3>{ui.office_bearers_title}</h3></div><div class="office-directory">{committee.officeBearers.map((member) => <article class="office-entry"><img src={member.photo || defaultMemberPhoto} alt="" loading="lazy" data-fallback={defaultMemberPhoto} /><div><p>{member.designation}</p><h4>{member.name}</h4>{(member.phone || member.email) && <address>{member.phone && <a href={`tel:${member.phone}`}>{member.phone}</a>}{member.email && <a href={`mailto:${member.email}`}>{member.email}</a>}</address>}</div></article>)}</div></section>}
      <section class="directory-section member-section"><div class="members-heading"><h3>{ui.members_title}</h3></div>{committee.members.length > 0 ? <div class="member-directory">{committee.members.map((member) => <article class="member-entry"><img src={member.photo || defaultMemberPhoto} alt="" loading="lazy" data-fallback={defaultMemberPhoto} /><div><h4>{member.name}</h4>{member.designation !== 'Member' && <p>{member.designation}</p>}</div></article>)}</div> : <p class="directory-empty">{ui.empty_message}</p>}</section>
    </section>)}
  </main>
  <dialog class="committee-lightbox" id="committee-lightbox" aria-label="Committee group photo"><button type="button" aria-label="Close fullscreen photo" data-close-lightbox>×</button><img src="" alt="" /></dialog>
</BaseLayout>

<script>
  const search=document.querySelector<HTMLInputElement>('#committee-search'),year=document.querySelector<HTMLSelectElement>('#committee-year'),count=document.querySelector<HTMLElement>('#committee-count'),empty=document.querySelector<HTMLElement>('#committee-empty');
  const viewLabel=document.querySelector<HTMLElement>('.committee-public')?.dataset.viewLabel;document.querySelectorAll('[data-view-committee]').forEach(button=>{if(viewLabel)button.textContent=viewLabel;});
  function filter(){const query=search?.value.trim().toLowerCase()||'',yr=year?.value||'';let visible=0;document.querySelectorAll<HTMLElement>('[data-committee-card]').forEach(card=>{const show=(!query||(card.dataset.name||'').includes(query))&&card.dataset.year===yr;card.hidden=!show;if(show)visible++;});document.querySelector<HTMLElement>('#featured-committees')?.toggleAttribute('hidden',!document.querySelector('#featured-committees [data-committee-card]:not([hidden])'));document.querySelector<HTMLElement>('.archive-section')?.toggleAttribute('hidden',!document.querySelector('.archive-section [data-committee-card]:not([hidden])'));if(empty)empty.hidden=visible>0;if(count)count.textContent=`${visible} committee${visible===1?'':'s'}`;}
  [search,year].forEach(control=>control?.addEventListener(control===search?'input':'change',filter));document.querySelector('#committee-clear')?.addEventListener('click',()=>{if(search)search.value='';if(year)year.selectedIndex=0;filter();search?.focus();});
  document.querySelectorAll<HTMLElement>('[data-view-committee]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLElement>('.committee-section,.committee-filters,.committee-empty').forEach(element=>element.hidden=true);const detail=document.querySelector<HTMLElement>(`#committee-detail-${button.dataset.viewCommittee}`);if(detail){detail.hidden=false;detail.scrollIntoView({behavior:'smooth',block:'start'});}}));document.querySelectorAll('[data-close-committee]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLElement>('.committee-detail').forEach(detail=>detail.hidden=true);document.querySelector<HTMLElement>('.committee-filters')!.hidden=false;document.querySelectorAll<HTMLElement>('.committee-section').forEach(section=>section.hidden=false);filter();document.querySelector('.committee-filters')?.scrollIntoView({behavior:'smooth'});}));filter();
  document.querySelectorAll<HTMLSelectElement>('[data-committee-year-switch]').forEach(select=>select.addEventListener('change',()=>{const current=select.closest<HTMLElement>('[data-committee-detail]'),target=[...document.querySelectorAll<HTMLElement>('[data-committee-detail]')].find(detail=>detail.dataset.committeeId===current?.dataset.committeeId&&detail.dataset.year===select.value);if(current&&target){current.hidden=true;target.hidden=false;target.scrollIntoView({behavior:'smooth',block:'start'});}}));
  document.querySelectorAll<HTMLImageElement>('img[data-fallback]').forEach(image=>image.addEventListener('error',()=>{const fallback=image.dataset.fallback;if(fallback&&image.src!==new URL(fallback,location.href).href)image.src=fallback;}));
  const lightbox=document.querySelector<HTMLDialogElement>('#committee-lightbox'),lightboxImage=lightbox?.querySelector<HTMLImageElement>('img');
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]').forEach(button=>button.addEventListener('click',()=>{if(!lightbox||!lightboxImage)return;lightboxImage.src=button.querySelector<HTMLImageElement>('img')?.currentSrc||button.dataset.lightboxSrc||'';lightboxImage.alt=button.dataset.lightboxAlt||'';lightbox.showModal();}));
  lightbox?.querySelector('[data-close-lightbox]')?.addEventListener('click',()=>lightbox.close());
  lightbox?.addEventListener('click',event=>{if(event.target===lightbox)lightbox.close();});
</script>

<style>
  .committee-public{color:#172941}.committee-filters{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;padding:18px;border:1px solid rgba(18,35,59,.11);border-radius:14px;background:#fffdf8;box-shadow:0 12px 35px rgba(20,36,58,.07)}.committee-search{grid-column:1/-1;display:flex;align-items:center;gap:10px;border:1px solid rgba(18,35,59,.17);border-radius:9px;padding:0 13px;background:white}.committee-search svg{width:18px;fill:none;stroke:#9a772b;stroke-width:1.7}.committee-search input{width:100%;border:0;outline:0;padding:12px 0;background:transparent;font-size:.85rem}.committee-filters>div{display:flex;gap:10px}.committee-filters label:not(.committee-search){display:grid;gap:5px}.committee-filters label>span{color:#7c8390;font-size:.56rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.committee-filters select{min-width:165px;border:1px solid rgba(18,35,59,.16);border-radius:8px;padding:9px;background:white;color:#263851;font-size:.75rem}.committee-filters>p{align-self:end;margin:0 0 9px;color:#7e8590;font-size:.7rem}.committee-section{margin-top:42px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.section-heading span,.members-heading span{color:#9c7628;font-size:.56rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.section-heading h2,.members-heading h3{margin:4px 0 0;font-family:var(--font-display,serif);font-size:1.55rem}.section-heading>p{max-width:330px;margin:0;color:#7b828d;font-size:.75rem;text-align:right}.committee-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.committee-card{overflow:hidden;border:1px solid rgba(18,35,59,.1);border-radius:14px;background:white;box-shadow:0 7px 25px rgba(23,38,59,.07);transition:.2s}.committee-card:hover{transform:translateY(-3px);border-color:rgba(184,149,63,.38);box-shadow:0 15px 35px rgba(23,38,59,.12)}.committee-card[hidden],.committee-section[hidden],.committee-detail[hidden],.committee-filters[hidden],.committee-empty[hidden]{display:none}.committee-cover{position:relative;height:190px;background:linear-gradient(145deg,#e8ebed,#f8f4e9)}.committee-cover img{width:100%;height:100%;object-fit:cover}.committee-cover>span{position:absolute;top:12px;right:12px;border-radius:999px;padding:5px 8px;background:#b8953f;color:white;font-size:.52rem;font-weight:800;text-transform:uppercase}.committee-card-body{padding:17px}.badges{display:flex;flex-wrap:wrap;gap:6px}.badges span{border:1px solid rgba(184,149,63,.22);border-radius:999px;padding:4px 7px;background:#fdf8eb;color:#8e6a25;font-size:.52rem;font-weight:700;text-transform:uppercase}.committee-card h3{margin:11px 0 7px;font-family:var(--font-display,serif);font-size:1.08rem}.committee-card-body>p{display:-webkit-box;min-height:3.5em;margin:0;overflow:hidden;color:#747b87;font-size:.72rem;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:3}.committee-card footer{display:flex;justify-content:space-between;align-items:center;margin-top:15px;padding-top:12px;border-top:1px solid rgba(18,35,59,.08)}.committee-card footer>span{color:#848b95;font-size:.62rem}.committee-card footer button,.committee-empty button,.detail-back{border:0;border-radius:7px;padding:8px 10px;background:#142740;color:white;font-size:.62rem;font-weight:700}.committee-empty{display:grid;justify-items:center;padding:70px 20px;text-align:center}.committee-empty h2{margin:14px 0 4px;font-family:var(--font-display,serif)}.committee-empty p{margin:0 0 16px;color:#7b828d;font-size:.76rem}.committee-detail{padding-top:4px}.detail-back{margin-bottom:18px;background:white;color:#31445e;border:1px solid rgba(18,35,59,.14)}.detail-hero{position:relative;min-height:350px;overflow:hidden;border-radius:16px;background:#142740;color:white;box-shadow:0 15px 40px rgba(17,34,56,.15)}.detail-photo{display:block;width:100%;height:clamp(350px,52vw,560px);border:0;padding:0;background:#142740;cursor:zoom-in}.detail-photo img{display:block;width:100%;height:100%;object-fit:cover}.detail-hero-caption{position:absolute;right:0;bottom:0;left:0;padding:70px 35px 28px;background:linear-gradient(transparent,rgba(10,24,42,.9));pointer-events:none}.detail-hero h2{margin:14px 0 8px;font-family:var(--font-display,serif);font-size:2rem;color:#fff}.detail-hero p{margin:0;color:#e3d5ab;font-size:.78rem}.detail-description{max-width:800px;margin:30px auto;color:#46556b;font-size:.86rem;line-height:1.75}.detail-description :global(h2),.detail-description :global(h3){font-family:var(--font-display,serif);color:#172941}.members-heading{margin:40px 0 16px}.member-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.member-card{overflow:hidden;border:1px solid rgba(18,35,59,.1);border-radius:13px;background:white;box-shadow:0 6px 20px rgba(23,38,59,.06)}.member-card>img{width:100%;aspect-ratio:4/3;object-fit:cover}.member-card>div{padding:15px}.member-card h4{margin:0;font-family:var(--font-display,serif);font-size:1rem}.designation{margin:4px 0 0;color:#9a7429;font-size:.65rem;font-weight:700}.bio{margin:10px 0 0;color:#737b87;font-size:.7rem;line-height:1.5}.member-card address{display:grid;gap:4px;margin-top:11px;padding-top:9px;border-top:1px solid rgba(18,35,59,.08);font-style:normal;font-size:.63rem}.member-card address a{color:#395572;text-decoration:none}.member-card address span{color:#7d8590}.committee-lightbox{width:100vw;max-width:none;height:100vh;max-height:none;border:0;padding:clamp(16px,4vw,48px);background:rgba(5,13,24,.94)}.committee-lightbox::backdrop{background:rgba(5,13,24,.94)}.committee-lightbox img{display:block;width:100%;height:100%;object-fit:contain}.committee-lightbox button{position:fixed;z-index:1;top:14px;right:18px;width:42px;height:42px;border:1px solid rgba(255,255,255,.35);border-radius:50%;background:rgba(10,24,42,.8);color:white;font-size:1.7rem;line-height:1;cursor:pointer}
  .directory-section{max-width:980px;margin:42px auto 0}.directory-section+.directory-section{margin-top:48px;padding-top:38px;border-top:1px solid rgba(18,35,59,.1)}.office-directory{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.office-entry{display:grid;grid-template-columns:60px minmax(0,1fr);align-items:center;gap:13px;min-height:82px;padding:10px 14px;border:1px solid rgba(18,35,59,.1);border-radius:11px;background:#fff;box-shadow:0 5px 16px rgba(23,38,59,.045)}.office-entry>img{width:60px;height:60px;border:1px solid rgba(184,149,63,.24);border-radius:50%;object-fit:cover;background:#edf0ed}.office-entry p{margin:0 0 3px;color:#9a7429;font-size:.58rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.office-entry h4,.member-entry h4{margin:0;color:#1c3048;font-family:var(--font-display,serif);font-size:.9rem}.office-entry address{display:flex;flex-wrap:wrap;gap:4px 10px;margin-top:5px;font-style:normal;font-size:.58rem}.office-entry address a{color:#526780;text-decoration:none}.member-directory{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid rgba(18,35,59,.1);border-left:1px solid rgba(18,35,59,.1);border-radius:10px;overflow:hidden}.member-entry{display:grid;grid-template-columns:46px minmax(0,1fr);align-items:center;gap:11px;min-height:68px;padding:10px 12px;border-right:1px solid rgba(18,35,59,.1);border-bottom:1px solid rgba(18,35,59,.1);background:#fff}.member-entry>img{width:46px;height:46px;border-radius:50%;object-fit:cover;background:#edf0ed}.member-entry p{margin:3px 0 0;color:#8d6d29;font-size:.58rem;font-weight:700}.directory-empty{margin:0;padding:22px;border:1px solid rgba(18,35,59,.1);border-radius:10px;background:#fff;color:#747d88;font-size:.75rem}.members-heading{margin:0 0 16px}
  .committee-year-switcher{display:flex;align-items:center;justify-content:flex-end;gap:9px;margin:16px 0}.committee-year-switcher span{color:#7c8390;font-size:.58rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.committee-year-switcher select{min-width:120px;border:1px solid rgba(18,35,59,.16);border-radius:8px;padding:9px;background:#fff;color:#263851;font-size:.75rem}
  @media(max-width:850px){.committee-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.committee-filters{grid-template-columns:1fr}.committee-filters>p{margin:0}.member-directory{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:620px){.office-directory{grid-template-columns:1fr}}
  @media(max-width:560px){.committee-filters{padding:13px}.committee-filters>div{display:grid;grid-template-columns:1fr 1fr}.committee-filters select{width:100%;min-width:0}.committee-grid,.member-directory{grid-template-columns:1fr}.section-heading{display:block}.section-heading>p{margin-top:6px;text-align:left}.committee-cover{height:180px}.detail-photo{height:62vw;min-height:260px}.detail-hero-caption{padding:55px 20px 20px}.detail-hero h2{font-size:1.55rem}.directory-section{margin-top:32px}.directory-section+.directory-section{margin-top:35px;padding-top:30px}}
</style>
