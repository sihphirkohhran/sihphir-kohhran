---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { resolveDocumentUrl } from '../lib/documents-url';
import { parseMonthFromDate, parseYearFromDate, parseYearMonthFromId } from '../lib/archive';
import { formatHistoricalYear, historicalYearFilterValue, resolveHistoricalYearType } from '../lib/historical-year';
import { getPageSettings } from '../lib/page-settings';
import PageHero from '../components/PageHero.astro';
const ui=await getPageSettings('documents',{hero_caption:'Sihphir Presbyterian Kohhran',search_placeholder:'Search title, description, category or year…',download_button:'Download',category_label:'Category',document_label:'Document',empty_message:'No documents found'});

const pageEntry=await getEntry('settings','document-page');
const page={...ui,...(pageEntry?.data as Record<string,string>|undefined)};
const categoryRegistry = await getEntry('settings', 'document-categories');
const registeredCategories = categoryRegistry?.data.categories ?? [];
const entries = await getCollection('documents');

const fileExtension = (value: string) => {
  const clean = value.split(/[?#]/)[0];
  const match = clean.match(/\.([a-z0-9]+)$/i);
  return match?.[1]?.toLowerCase() ?? 'file';
};

const filenameFromUrl = (value: string) => {
  try {
    const pathname = value.startsWith('http') ? new URL(value).pathname : value;
    return decodeURIComponent(pathname.split('/').pop() || 'Document');
  } catch {
    return value.split('/').pop() || 'Document';
  }
};

const documentSortDate = (value: string | undefined, year: number | null, month: number | null, id: string) => {
  const text = String(value || '').trim();
  const dayFirst = text.match(/^(\d{1,2})[.\-/](\d{1,2})[.\-/](\d{4})$/);
  if (dayFirst) return `${dayFirst[3]}-${dayFirst[2].padStart(2, '0')}-${dayFirst[1].padStart(2, '0')}`;
  const parsed = Date.parse(text);
  if (text && !Number.isNaN(parsed)) return new Date(parsed).toISOString();
  return `${String(year ?? 0).padStart(4, '0')}-${String(month ?? 0).padStart(2, '0')}-${id}`;
};

const documents = entries
  .filter((entry) => entry.data.status !== 'archived' && entry.data.published !== false)
  .map((entry) => {
    const data = entry.data;
    const legacyUrl = resolveDocumentUrl(data.pdf_url, data.pdf_external);
    const storedFiles = Array.isArray(data.files) ? data.files : [];
    const normalizedFiles = storedFiles
      .map((file) => ({
        url: resolveDocumentUrl(file.url),
        filename: file.filename || filenameFromUrl(file.url),
        size: file.size ?? null,
        uploadedAt: file.uploaded_at || '',
        modifiedAt: file.modified_at || '',
        type: file.type || '',
      }))
      .filter((file) => file.url);
    if (legacyUrl && !normalizedFiles.some((file) => file.url === legacyUrl)) {
      normalizedFiles.unshift({
        url: legacyUrl,
        filename: filenameFromUrl(legacyUrl),
        size: null,
        uploadedAt: '',
        modifiedAt: '',
        type: '',
      });
    }
    const primary = normalizedFiles[0];
    const fromId = parseYearMonthFromId(entry.id);
    const legacyYear = data.year ?? fromId.year ?? parseYearFromDate(data.date) ?? null;
    const yearType = resolveHistoricalYearType(legacyYear, (data as typeof data & { yearType?: 'known' | 'approximate' | 'unspecified' }).yearType);
    const year = yearType === 'unspecified' ? null : legacyYear;
    const yearLabel = formatHistoricalYear(year, yearType);
    const yearFilterValue = historicalYearFilterValue(year, yearType);
    const month = data.month ?? fromId.month ?? parseMonthFromDate(data.date) ?? null;
    const category = String(
      data.category || (entry.id.startsWith('ktp-inleng/') ? 'KTP Inleng' : 'Other'),
    );
    const description = String(data.description || entry.body || '').replace(/<[^>]*>/g, '').trim();
    const uploadDate = primary?.uploadedAt || data.date || '';
    const sortDate = documentSortDate(primary?.uploadedAt || primary?.modifiedAt || data.date, year, month, entry.id);
    const ext = fileExtension(primary?.filename || primary?.url || '');
    return {
      id: entry.id,
      title: String(data.name),
      description,
      category,
      year,
      yearType,
      yearLabel,
      yearFilterValue,
      uploadDate,
      sortDate,
      featured: Boolean(data.featured),
      pinned: Boolean(data.pinned),
      url: primary?.url || '',
      filename: primary?.filename || '',
      size: primary?.size ?? null,
      extension: ext,
      previewable: ext === 'pdf' || ['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif', 'svg'].includes(ext),
      image: ['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif', 'svg'].includes(ext),
      files: normalizedFiles.map((file) => ({ ...file, type: file.type || fileExtension(file.filename || file.url) })),
      fileCount: normalizedFiles.length,
    };
  })
  .filter((document) => document.url)
  .sort((a, b) => b.sortDate.localeCompare(a.sortDate));

const categories = Array.from(new Set([
  ...registeredCategories.map((category) => category.name),
  ...documents.map((document) => document.category),
])).filter(Boolean);
const years = Array.from(new Set(documents.map((document) => document.year).filter((year): year is number => year != null))).sort((a, b) => b - a);
const hasUnspecifiedYear = documents.some((document) => document.yearType === 'unspecified');
const featuredDocuments = documents.filter((document) => document.featured);
const archiveDocuments = documents.filter((document) => !document.featured);

const formatSize = (size: number | null) => {
  if (size == null) return 'Size unavailable';
  if (size < 1024) return `${size} B`;
  if (size < 1024 * 1024) return `${(size / 1024).toFixed(1)} KB`;
  return `${(size / (1024 * 1024)).toFixed(1)} MB`;
};
const formatDate = (value: string) => {
  if (!value) return 'Archive record';
  const parsed = new Date(value);
  if (Number.isNaN(parsed.valueOf())) return value;
  return new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(parsed);
};
const iconLabel = (ext: string) => ({ pdf: 'PDF', docx: 'DOCX', xlsx: 'XLSX', pptx: 'PPTX', zip: 'ZIP' }[ext] || (['jpg','jpeg','png','gif','webp','avif','svg'].includes(ext) ? 'IMAGE' : ext.toUpperCase()));
---

<BaseLayout title={page.seo_title} description={page.seo_description} activePage="document">
  <PageHero title={page.hero_title} subtitle={page.hero_subtitle} image={page.hero_background_image} eyebrow={page.hero_caption} />

  <main class="documents-page max-w-6xl mx-auto px-4 py-8 sm:py-10" data-download-label={ui.download_button}>
    {page.intro_text && <p class="page-intro reveal">{page.intro_text}</p>}
    <section class="document-toolbar reveal" aria-label="Document search and filters">
      <label class="document-search" for="document-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
        <span class="sr-only">{ui.search_placeholder}</span>
        <input id="document-search" type="search" placeholder={ui.search_placeholder} autocomplete="off" />
      </label>
      <div class="document-filter-row">
        <label><span>{ui.category_label}</span><select id="document-category"><option value="all">All categories</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
        <label><span>Year</span><select id="document-year"><option value="all">All years</option>{years.map((year) => <option value={year}>{year}</option>)}{hasUnspecifiedYear && <option value="unspecified">Year Unspecified</option>}</select></label>
        <label><span>Sort</span><select id="document-sort"><option value="newest">Newest</option><option value="oldest">Oldest</option><option value="title">Title A–Z</option></select></label>
      </div>
      <p id="document-count" class="document-count">{documents.length} documents</p>
    </section>

    {featuredDocuments.length > 0 && (
      <section class="document-section" id="featured-documents">
        <div class="document-section-heading reveal">
          <div><span>Selected archive</span><h2>Featured Documents</h2></div>
          <p>Important publications and frequently requested records.</p>
        </div>
        <div class="document-list featured-list" id="featured-grid">
          {featuredDocuments.map((document) => (
            <button type="button" class="document-row" data-document-row data-document-open data-document-id={document.id} data-files={JSON.stringify(document.files)} data-title={document.title} data-search-title={document.title.toLowerCase()} data-description={document.description.toLowerCase()} data-category={document.category} data-year={document.yearFilterValue} data-date={document.sortDate}>
              <span class={`file-icon file-${document.extension}`} aria-hidden="true"><svg viewBox="0 0 20 22"><path d="M4 1.5h7l5 5V20.5H4z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M11 1.8v5h5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span>
              <span class="document-row-copy"><span class="document-row-title">{document.title}</span><span class="document-row-meta"><span class="document-row-category">{document.category}</span><span>{document.yearLabel}</span><span>{document.fileCount} {document.fileCount === 1 ? 'file' : 'files'}</span><span class="document-featured-label">Featured</span></span></span>
              <svg class="document-row-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          ))}
        </div>
      </section>
    )}

    <section class="document-section archive-section">
      <div class="document-list" id="document-grid">
        {archiveDocuments.map((document) => (
          <button type="button" class="document-row" data-document-row data-document-open data-document-id={document.id} data-files={JSON.stringify(document.files)} data-title={document.title} data-search-title={document.title.toLowerCase()} data-description={document.description.toLowerCase()} data-category={document.category} data-year={document.yearFilterValue} data-date={document.sortDate}>
            <span class={`file-icon file-${document.extension}`} aria-hidden="true"><svg viewBox="0 0 20 22"><path d="M4 1.5h7l5 5V20.5H4z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M11 1.8v5h5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span>
            <span class="document-row-copy"><span class="document-row-title">{document.title}</span><span class="document-row-meta"><span class="document-row-category">{document.category}</span><span>{document.yearLabel}</span><span>{document.fileCount} {document.fileCount === 1 ? 'file' : 'files'}</span></span></span>
            <svg class="document-row-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        ))}
      </div>
    </section>

    <section class="document-empty" id="document-empty" hidden>
      <div class="empty-illustration" aria-hidden="true"><span></span><i>⌕</i></div>
      <h2>{ui.empty_message}</h2>
      <p>Try a different search term or clear one of the filters.</p>
      <button type="button" id="document-clear">Clear filters</button>
    </section>
    <dialog class="document-dialog" id="document-dialog" aria-labelledby="document-dialog-title">
      <div class="document-dialog-header"><div class="document-dialog-heading"><span class="document-dialog-eyebrow">DOCUMENT ARCHIVE</span><h2 id="document-dialog-title"></h2><p class="document-dialog-subtitle" id="document-dialog-subtitle">Attached files</p></div><button type="button" class="document-dialog-close" id="document-dialog-close" aria-label="Close file selection">×</button></div>
      <ul class="document-file-list" id="document-file-list"></ul>
    </dialog>
  </main>
</BaseLayout>

<script>
  import { resolveCategoryFromSearch } from '../lib/category-query';
  import { resolveContentDeepLink } from '../lib/content-deep-links';

  const search = document.querySelector<HTMLInputElement>('#document-search');
  const category = document.querySelector<HTMLSelectElement>('#document-category');
  const requestedCategory = resolveCategoryFromSearch(window.location.search, category ? Array.from(category.options, (option) => option.value).filter((value) => value !== 'all') : []);
  if (requestedCategory && category) category.value = requestedCategory;
  const year = document.querySelector<HTMLSelectElement>('#document-year');
  const sort = document.querySelector<HTMLSelectElement>('#document-sort');
  const empty = document.querySelector<HTMLElement>('#document-empty');
  const count = document.querySelector<HTMLElement>('#document-count');
  const dialog = document.querySelector<HTMLDialogElement>('#document-dialog');
  const dialogTitle = document.querySelector<HTMLElement>('#document-dialog-title');
  const dialogSubtitle = document.querySelector<HTMLElement>('#document-dialog-subtitle');
  const fileList = document.querySelector<HTMLUListElement>('#document-file-list');
  const closeDialog = document.querySelector<HTMLButtonElement>('#document-dialog-close');
  let lastFocusedRow: HTMLButtonElement | null = null;

  function applyFilters() {
    const query = search?.value.trim().toLowerCase() || '';
    const selectedCategory = category?.value || 'all';
    const selectedYear = year?.value || 'all';
    let visible = 0;
    document.querySelectorAll<HTMLElement>('[data-document-row]').forEach((row) => {
      const haystack = [row.dataset.searchTitle, row.dataset.description, row.dataset.category?.toLowerCase(), row.dataset.year].join(' ');
      const matches = (!query || haystack.includes(query)) && (selectedCategory === 'all' || row.dataset.category === selectedCategory) && (selectedYear === 'all' || row.dataset.year === selectedYear);
      row.hidden = !matches;
      if (matches) visible++;
    });
    document.querySelectorAll<HTMLElement>('.document-list').forEach((list) => {
      const rows = [...list.querySelectorAll<HTMLElement>('[data-document-row]')];
      rows.sort((a, b) => {
        if (sort?.value === 'title') return (a.dataset.searchTitle || '').localeCompare(b.dataset.searchTitle || '');
        const result = (b.dataset.date || '').localeCompare(a.dataset.date || '');
        return sort?.value === 'oldest' ? -result : result;
      }).forEach((row) => list.append(row));
    });
    document.querySelector<HTMLElement>('#featured-documents')?.toggleAttribute('hidden', !document.querySelector('#featured-grid [data-document-row]:not([hidden])'));
    document.querySelector<HTMLElement>('.archive-section')?.toggleAttribute('hidden', !document.querySelector('#document-grid [data-document-row]:not([hidden])'));
    if (empty) empty.hidden = visible > 0;
    if (count) count.textContent = visible + ' document' + (visible === 1 ? '' : 's');
  }

  const fileTypeDetails: Record<string, { label: string; icon: string; color: string }> = {
    pdf: { label: 'PDF Document', icon: 'file-text', color: 'pdf' },
    xlsx: { label: 'Excel Spreadsheet', icon: 'file-spreadsheet', color: 'spreadsheet' },
    xls: { label: 'Excel Spreadsheet', icon: 'file-spreadsheet', color: 'spreadsheet' },
    csv: { label: 'CSV File', icon: 'file-spreadsheet', color: 'spreadsheet' },
    docx: { label: 'Word Document', icon: 'file-text', color: 'word' },
    doc: { label: 'Word Document', icon: 'file-text', color: 'word' },
    pptx: { label: 'PowerPoint Presentation', icon: 'presentation', color: 'powerpoint' },
    ppt: { label: 'PowerPoint Presentation', icon: 'presentation', color: 'powerpoint' },
    zip: { label: 'ZIP Archive', icon: 'file-archive', color: 'zip' },
    jpg: { label: 'Image', icon: 'file-image', color: 'image' },
    jpeg: { label: 'Image', icon: 'file-image', color: 'image' },
    png: { label: 'Image', icon: 'file-image', color: 'image' },
    gif: { label: 'Image', icon: 'file-image', color: 'image' },
    webp: { label: 'Image', icon: 'file-image', color: 'image' },
    avif: { label: 'Image', icon: 'file-image', color: 'image' },
    svg: { label: 'Image', icon: 'file-image', color: 'image' },
    bmp: { label: 'Image', icon: 'file-image', color: 'image' },
    tif: { label: 'Image', icon: 'file-image', color: 'image' },
    tiff: { label: 'Image', icon: 'file-image', color: 'image' },
    heic: { label: 'Image', icon: 'file-image', color: 'image' },
    ico: { label: 'Image', icon: 'file-image', color: 'image' },
  };
  const fileIcons: Record<string, string> = {
    'file-text': '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h8"/></svg>',
    'file-spreadsheet': '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M4 12h16M4 16h16M10 12v10M15 12v10"/></svg>',
    presentation: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h18v13H3zM12 16v5M8 21h8M7 8h10M7 12h6"/></svg>',
    'file-archive': '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM4 8h16M10 4v4M14 4v4M12 11v2m-2 2h4v4h-4z"/></svg>',
    'file-image': '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M7 18l4-4 3 3 2-2 2 3M9 11h.01"/></svg>',
    file: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/></svg>',
  };

  function fileExtension(filename: string) {
    return filename.match(/\.([a-z0-9]+)$/i)?.[1]?.toLowerCase() || '';
  }

  function fileType(file: { filename?: string; type?: string; url?: string }) {
    const extension = fileExtension(file.filename || '') || (file.type || '').toLowerCase();
    return fileTypeDetails[extension] || { label: 'File', icon: 'file', color: 'other' };
  }

  function displayFilename(filename: string) {
    return fileTypeDetails[fileExtension(filename)] ? filename.replace(/\.[^.]+$/, '') : filename;
  }

  function openDocumentRow(row: HTMLButtonElement, options: { fromUrl?: boolean; pushHistory?: boolean } = {}) {
    let files: Array<{ url: string; filename: string; type?: string }> = [];
    try { files = JSON.parse(row.dataset.files || '[]'); } catch { files = []; }
    if (files.length === 1 && files[0]?.url) {
      if (options.fromUrl) window.location.replace(files[0].url);
      else window.open(files[0].url, '_blank', 'noopener,noreferrer');
      return;
    }
    if (files.length < 2 || !dialog || !dialogTitle || !dialogSubtitle || !fileList) return;
    if (options.pushHistory && row.dataset.documentId) {
      const url = new URL(window.location.href);
      url.searchParams.set('document', row.dataset.documentId);
      history.pushState({ documentDialog: true }, '', url);
    }
    lastFocusedRow = row;
    dialogTitle.textContent = row.dataset.title || 'Document files';
    const attachedFileCount = files.filter((file) => Boolean(file.url)).length;
    dialogSubtitle.textContent = attachedFileCount + ' attached file' + (attachedFileCount === 1 ? '' : 's');
    fileList.replaceChildren();
    files.forEach((file) => {
      if (!file.url) return;
      const filenameText = file.filename || 'Document';
      const metadata = fileType(file);
      const item = document.createElement('li');
      item.className = 'document-file-item';
      const link = document.createElement('a');
      link.className = 'document-file-link';
      link.href = file.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.setAttribute('aria-label', 'Open ' + filenameText + ' (' + metadata.label + ') in a new tab');
      const icon = document.createElement('span');
      icon.className = 'document-file-icon document-file-icon-' + metadata.color;
      icon.setAttribute('aria-hidden', 'true');
      icon.innerHTML = fileIcons[metadata.icon] || fileIcons.file;
      const details = document.createElement('span');
      details.className = 'document-file-details';
      const filename = document.createElement('span');
      filename.className = 'document-file-name';
      filename.textContent = displayFilename(filenameText);
      const type = document.createElement('span');
      type.className = 'document-file-type';
      type.textContent = metadata.label;
      details.append(filename, type);
      const arrow = document.createElement('span');
      arrow.className = 'document-file-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>';
      link.append(icon, details, arrow);
      item.append(link);
      fileList.append(item);
    });
    dialog.showModal();
    closeDialog?.focus();
  }

  function clearDocumentDeepLink() {
    const url = new URL(window.location.href);
    url.searchParams.delete('document');
    history.replaceState(history.state, '', url);
  }

  function syncDocumentDeepLink() {
    const requestedId = resolveContentDeepLink(window.location.search, 'document');
    if (!requestedId) return;
    const row = [...document.querySelectorAll<HTMLButtonElement>('[data-document-open]')].find(item => item.dataset.documentId === requestedId);
    if (!row) { clearDocumentDeepLink(); return; }
    row.hidden = false;
    openDocumentRow(row, { fromUrl: true });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-document-open]').forEach((row) => row.addEventListener('click', () => openDocumentRow(row, { pushHistory: true })));
  closeDialog?.addEventListener('click', () => {
    if (history.state?.documentDialog) history.back();
    else dialog?.close();
  });
  dialog?.addEventListener('close', () => {
    if (new URLSearchParams(window.location.search).has('document') && !history.state?.documentDialog) {
      clearDocumentDeepLink();
      applyFilters();
    }
    lastFocusedRow?.focus();
  });
  window.addEventListener('popstate', () => {
    const requestedId = resolveContentDeepLink(window.location.search, 'document');
    if (!requestedId) { if (dialog?.open) dialog.close(); return; }
    const row = [...document.querySelectorAll<HTMLButtonElement>('[data-document-open]')].find(item => item.dataset.documentId === requestedId);
    if (!row) { clearDocumentDeepLink(); if (dialog?.open) dialog.close(); return; }
    row.hidden = false;
    if (!dialog?.open) openDocumentRow(row, { fromUrl: true });
  });
  [search, category, year].forEach((control) => control?.addEventListener(control === search ? 'input' : 'change', applyFilters));
  sort?.addEventListener('change', applyFilters);
  document.querySelector('#document-clear')?.addEventListener('click', () => {
    if (search) search.value = '';
    if (category) category.value = 'all';
    if (year) year.value = 'all';
    if (sort) sort.value = 'newest';
    applyFilters(); search?.focus();
  });
  applyFilters();
  syncDocumentDeepLink();
</script>

<style>
  .documents-page{color:#13233a}
  .document-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px 16px;padding:14px 0 12px;border-bottom:1px solid rgba(18,35,59,.12)}
  .document-search{grid-column:1/-1;display:flex;align-items:center;gap:10px;border:1px solid rgba(18,35,59,.16);border-radius:5px;padding:0 12px;background:#fff}
  .document-search:focus-within{border-color:#b8953f;box-shadow:0 0 0 2px rgba(184,149,63,.1)}
  .document-search svg{width:17px;height:17px;fill:none;stroke:#9a772b;stroke-width:1.7}
  .document-search input{width:100%;border:0;outline:0;padding:10px 0;background:transparent;color:#182941;font-family:var(--font-body,serif);font-size:.86rem}
  .document-filter-row{display:flex;flex-wrap:wrap;gap:9px}
  .document-filter-row label{display:grid;gap:4px}
  .document-filter-row label>span{font-size:.56rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#7b8290}
  .document-filter-row select{min-width:132px;border:1px solid rgba(18,35,59,.15);border-radius:4px;padding:7px 27px 7px 9px;background:white;color:#263851;font-size:.72rem}
  .document-count{align-self:end;margin:0 1px 8px;color:#79808b;font-size:.68rem}
  .document-section{margin-top:27px}
  .document-section-heading{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:10px}
  .document-section-heading span{color:#9c7628;font-size:.55rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
