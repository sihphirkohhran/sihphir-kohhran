---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { resolveDocumentUrl } from '../lib/documents-url';
import { parseMonthFromDate, parseYearFromDate, parseYearMonthFromId } from '../lib/archive';
import { getPageSettings } from '../lib/page-settings';
const ui=await getPageSettings('documents',{hero_caption:'Sihphir Presbyterian Kohhran',hero_title:'Church Documents',hero_subtitle:'Browse official documents, reports, circulars, notices and publications of Sihphir Presbyterian Kohhran.',search_placeholder:'Search title, description, category or year…',section_title:'Document Archive',download_button:'Download',category_label:'Category',document_label:'Document',empty_message:'No documents found'});

const categoryRegistry = await getEntry('settings', 'document-categories');
const registeredCategories = categoryRegistry?.data.categories ?? [];
const entries = await getCollection('documents');

const fileExtension = (value: string) => {
  const clean = value.split(/[?#]/)[0];
  const match = clean.match(/\.([a-z0-9]+)$/i);
  return match?.[1]?.toLowerCase() ?? 'file';
};

const filenameFromUrl = (value: string) => {
  try {
    const pathname = value.startsWith('http') ? new URL(value).pathname : value;
    return decodeURIComponent(pathname.split('/').pop() || 'Document');
  } catch {
    return value.split('/').pop() || 'Document';
  }
};

const documentSortDate = (value: string | undefined, year: number | null, month: number | null, id: string) => {
  const text = String(value || '').trim();
  const dayFirst = text.match(/^(\d{1,2})[.\-/](\d{1,2})[.\-/](\d{4})$/);
  if (dayFirst) return `${dayFirst[3]}-${dayFirst[2].padStart(2, '0')}-${dayFirst[1].padStart(2, '0')}`;
  const parsed = Date.parse(text);
  if (text && !Number.isNaN(parsed)) return new Date(parsed).toISOString();
  return `${String(year ?? 0).padStart(4, '0')}-${String(month ?? 0).padStart(2, '0')}-${id}`;
};

const documents = entries
  .filter((entry) => entry.data.status !== 'archived' && entry.data.published !== false)
  .map((entry) => {
    const data = entry.data;
    const legacyUrl = resolveDocumentUrl(data.pdf_url, data.pdf_external);
    const storedFiles = Array.isArray(data.files) ? data.files : [];
    const normalizedFiles = storedFiles
      .map((file) => ({
        url: resolveDocumentUrl(file.url),
        filename: file.filename || filenameFromUrl(file.url),
        size: file.size ?? null,
        uploadedAt: file.uploaded_at || '',
        modifiedAt: file.modified_at || '',
        type: file.type || '',
      }))
      .filter((file) => file.url);
    if (legacyUrl && !normalizedFiles.some((file) => file.url === legacyUrl)) {
      normalizedFiles.unshift({
        url: legacyUrl,
        filename: filenameFromUrl(legacyUrl),
        size: null,
        uploadedAt: '',
        modifiedAt: '',
        type: '',
      });
    }
    const primary = normalizedFiles[0];
    const fromId = parseYearMonthFromId(entry.id);
    const year = data.year ?? fromId.year ?? parseYearFromDate(data.date) ?? null;
    const month = data.month ?? fromId.month ?? parseMonthFromDate(data.date) ?? null;
    const category = String(
      data.category || (entry.id.startsWith('ktp-inleng/') ? 'KTP Inleng' : 'Other'),
    );
    const description = String(data.description || entry.body || '').replace(/<[^>]*>/g, '').trim();
    const uploadDate = primary?.uploadedAt || data.date || '';
    const sortDate = documentSortDate(primary?.uploadedAt || primary?.modifiedAt || data.date, year, month, entry.id);
    const ext = fileExtension(primary?.filename || primary?.url || '');
    return {
      id: entry.id,
      title: String(data.name),
      description,
      category,
      year,
      uploadDate,
      sortDate,
      featured: Boolean(data.featured),
      pinned: Boolean(data.pinned),
      url: primary?.url || '',
      filename: primary?.filename || '',
      size: primary?.size ?? null,
      extension: ext,
      previewable: ext === 'pdf' || ['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif', 'svg'].includes(ext),
      image: ['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif', 'svg'].includes(ext),
      fileCount: normalizedFiles.length,
    };
  })
  .filter((document) => document.url)
  .sort((a, b) => b.sortDate.localeCompare(a.sortDate));

const categories = Array.from(new Set([
  ...registeredCategories.map((category) => category.name),
  ...documents.map((document) => document.category),
])).filter(Boolean);
const years = Array.from(new Set(documents.map((document) => document.year).filter((year): year is number => year != null))).sort((a, b) => b - a);
const featuredDocuments = documents.filter((document) => document.featured);
const archiveDocuments = documents.filter((document) => !document.featured);

const formatSize = (size: number | null) => {
  if (size == null) return 'Size unavailable';
  if (size < 1024) return `${size} B`;
  if (size < 1024 * 1024) return `${(size / 1024).toFixed(1)} KB`;
  return `${(size / (1024 * 1024)).toFixed(1)} MB`;
};
const formatDate = (value: string) => {
  if (!value) return 'Archive record';
  const parsed = new Date(value);
  if (Number.isNaN(parsed.valueOf())) return value;
  return new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(parsed);
};
const iconLabel = (ext: string) => ({ pdf: 'PDF', docx: 'DOCX', xlsx: 'XLSX', pptx: 'PPTX', zip: 'ZIP' }[ext] || (['jpg','jpeg','png','gif','webp','avif','svg'].includes(ext) ? 'IMAGE' : ext.toUpperCase()));
---

<BaseLayout title="Church Documents — Sihphir Presbyterian Kohhran" activePage="document">
  <div class="documents-hero bg-navy border-b-2 border-gold px-4 py-10 sm:py-12 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: repeating-linear-gradient(45deg, #b8953f 0px, #b8953f 1px, transparent 1px, transparent 28px);"></div>
    <div class="relative z-10 max-w-3xl mx-auto">
      <p class="font-body text-[0.6rem] tracking-[0.16em] uppercase text-gold-pale/55 mb-2">{ui.hero_caption}</p>
      <h1 class="font-display text-white text-3xl sm:text-4xl font-semibold">{ui.hero_title}</h1>
      <p class="font-body text-gold-pale/65 text-sm sm:text-base mt-3 leading-relaxed">{ui.hero_subtitle}</p>
      <div class="w-16 h-px bg-gold/50 mx-auto mt-5"></div>
    </div>
  </div>

  <main class="documents-page max-w-6xl mx-auto px-4 py-8 sm:py-10" data-download-label={ui.download_button}>
    <section class="document-toolbar reveal" aria-label="Document search and filters">
      <label class="document-search" for="document-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
        <span class="sr-only">{ui.search_placeholder}</span>
        <input id="document-search" type="search" placeholder={ui.search_placeholder} autocomplete="off" />
      </label>
      <div class="document-filter-row">
        <label><span>{ui.category_label}</span><select id="document-category"><option value="all">All categories</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
        <label><span>Year</span><select id="document-year"><option value="all">All years</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label>
        <label><span>Sort</span><select id="document-sort"><option value="newest">Newest</option><option value="oldest">Oldest</option><option value="title">Title A–Z</option></select></label>
      </div>
      <p id="document-count" class="document-count">{documents.length} documents</p>
    </section>

    {featuredDocuments.length > 0 && (
      <section class="document-section" id="featured-documents">
        <div class="document-section-heading reveal">
          <div><span>Selected archive</span><h2>Featured Documents</h2></div>
          <p>Important publications and frequently requested records.</p>
        </div>
        <div class="document-grid featured-grid" id="featured-grid">
          {featuredDocuments.map((document, index) => (
            <article class={`document-card featured-card reveal reveal-delay-${(index % 3) + 1}`} data-document-card data-title={document.title.toLowerCase()} data-description={document.description.toLowerCase()} data-category={document.category} data-year={document.year ?? ''} data-date={document.sortDate}>
              <div class="document-preview">
                {document.image ? <img src={document.url} alt="" loading="lazy" /> : document.extension === 'pdf' ? <iframe src={`${document.url}#page=1&view=FitH&toolbar=0&navpanes=0`} title={`Preview of ${document.title}`} loading="lazy"></iframe> : <span class={`file-mark file-${document.extension}`}>{iconLabel(document.extension)}</span>}
                <span class="featured-ribbon">Featured</span>
              </div>
              <div class="document-card-body">
                <div class="document-badges"><span>{document.category}</span>{document.year && <span>{document.year}</span>}</div>
                <h3>{document.title}</h3>
                <p class="document-description">{document.description || 'An official document from the church archive.'}</p>
                <div class="document-meta"><span>{formatDate(document.uploadDate)}</span><span>{formatSize(document.size)}</span>{document.fileCount > 1 && <span>{document.fileCount} files</span>}</div>
                <div class="document-actions">{document.previewable && <a href={document.url} target="_blank" rel="noopener" class="preview-link">Preview</a>}<a href={document.url} download class="download-link">Download</a><a href={document.url} target="_blank" rel="noopener" class="open-link" aria-label={`Open ${document.title}`}>Open ↗</a></div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="document-section archive-section">
      <div class="document-section-heading reveal">
        <div><span>Complete collection</span><h2>{ui.section_title}</h2></div>
        <p>Browse all available church records and publications.</p>
      </div>
      <div class="document-grid" id="document-grid">
        {archiveDocuments.map((document, index) => (
          <article class={`document-card reveal reveal-delay-${(index % 3) + 1}`} data-document-card data-title={document.title.toLowerCase()} data-description={document.description.toLowerCase()} data-category={document.category} data-year={document.year ?? ''} data-date={document.sortDate}>
            <div class="document-preview">
              {document.image ? <img src={document.url} alt="" loading="lazy" /> : document.extension === 'pdf' ? <iframe src={`${document.url}#page=1&view=FitH&toolbar=0&navpanes=0`} title={`Preview of ${document.title}`} loading="lazy"></iframe> : <span class={`file-mark file-${document.extension}`}>{iconLabel(document.extension)}</span>}
            </div>
            <div class="document-card-body">
              <div class="document-badges"><span>{document.category}</span>{document.year && <span>{document.year}</span>}</div>
              <h3>{document.title}</h3>
              <p class="document-description">{document.description || 'An official document from the church archive.'}</p>
              <div class="document-meta"><span>{formatDate(document.uploadDate)}</span><span>{formatSize(document.size)}</span>{document.fileCount > 1 && <span>{document.fileCount} files</span>}</div>
              <div class="document-actions">{document.previewable && <a href={document.url} target="_blank" rel="noopener" class="preview-link">Preview</a>}<a href={document.url} download class="download-link">Download</a><a href={document.url} target="_blank" rel="noopener" class="open-link" aria-label={`Open ${document.title}`}>Open ↗</a></div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="document-empty" id="document-empty" hidden>
      <div class="empty-illustration" aria-hidden="true"><span></span><i>⌕</i></div>
      <h2>{ui.empty_message}</h2>
      <p>Try a different search term or clear one of the filters.</p>
      <button type="button" id="document-clear">Clear filters</button>
    </section>
  </main>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#document-search');
  const category = document.querySelector<HTMLSelectElement>('#document-category');
  const year = document.querySelector<HTMLSelectElement>('#document-year');
  const sort = document.querySelector<HTMLSelectElement>('#document-sort');
  const empty = document.querySelector<HTMLElement>('#document-empty');
  const count = document.querySelector<HTMLElement>('#document-count');
  const downloadLabel=document.querySelector<HTMLElement>('.documents-page')?.dataset.downloadLabel;document.querySelectorAll('.download-link').forEach(link=>{if(downloadLabel)link.textContent=downloadLabel;});

  function applyFilters() {
    const query = search?.value.trim().toLowerCase() || '';
    const selectedCategory = category?.value || 'all';
    const selectedYear = year?.value || 'all';
    let visible = 0;

    document.querySelectorAll<HTMLElement>('[data-document-card]').forEach((card) => {
      const haystack = `${card.dataset.title} ${card.dataset.description} ${card.dataset.category?.toLowerCase()} ${card.dataset.year}`;
      const matches = (!query || haystack.includes(query)) &&
        (selectedCategory === 'all' || card.dataset.category === selectedCategory) &&
        (selectedYear === 'all' || card.dataset.year === selectedYear);
      card.hidden = !matches;
      if (matches) visible++;
    });

    document.querySelectorAll<HTMLElement>('.document-grid').forEach((grid) => {
      const cards = [...grid.querySelectorAll<HTMLElement>('[data-document-card]')];
      cards.sort((a, b) => {
        if (sort?.value === 'title') return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        const result = (b.dataset.date || '').localeCompare(a.dataset.date || '');
        return sort?.value === 'oldest' ? -result : result;
      }).forEach((card) => grid.append(card));
    });

    document.querySelector<HTMLElement>('#featured-documents')?.toggleAttribute('hidden', !document.querySelector('#featured-grid [data-document-card]:not([hidden])'));
    document.querySelector<HTMLElement>('.archive-section')?.toggleAttribute('hidden', !document.querySelector('#document-grid [data-document-card]:not([hidden])'));
    if (empty) empty.hidden = visible > 0;
    if (count) count.textContent = `${visible} document${visible === 1 ? '' : 's'}`;
  }

  [search, category, year].forEach((control) => control?.addEventListener(control === search ? 'input' : 'change', applyFilters));
  sort?.addEventListener('change', applyFilters);
  document.querySelector('#document-clear')?.addEventListener('click', () => {
    if (search) search.value = '';
    if (category) category.value = 'all';
    if (year) year.value = 'all';
    if (sort) sort.value = 'newest';
    applyFilters();
    search?.focus();
  });
  applyFilters();
</script>

<style>
  .documents-page{color:#13233a}.document-toolbar{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:15px;padding:18px;border:1px solid rgba(18,35,59,.11);border-radius:14px;background:#fffdf8;box-shadow:0 12px 35px rgba(20,36,58,.07)}.document-search{grid-column:1/-1;display:flex;align-items:center;gap:11px;border:1px solid rgba(18,35,59,.18);border-radius:10px;padding:0 14px;background:white}.document-search:focus-within{border-color:#b8953f;box-shadow:0 0 0 3px rgba(184,149,63,.12)}.document-search svg{width:19px;height:19px;fill:none;stroke:#9a772b;stroke-width:1.7}.document-search input{width:100%;border:0;outline:0;padding:13px 0;background:transparent;color:#182941;font-family:var(--font-body,serif);font-size:.9rem}.document-filter-row{display:flex;flex-wrap:wrap;gap:10px}.document-filter-row label{display:grid;gap:5px}.document-filter-row label>span{font-size:.58rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#7b8290}.document-filter-row select{min-width:150px;border:1px solid rgba(18,35,59,.16);border-radius:8px;padding:9px 32px 9px 10px;background:white;color:#263851;font-size:.76rem}.document-count{align-self:end;margin:0 2px 10px;color:#79808b;font-size:.72rem}.document-section{margin-top:42px}.document-section-heading{display:flex;justify-content:space-between;gap:25px;align-items:end;margin-bottom:18px}.document-section-heading span{color:#9c7628;font-size:.57rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.document-section-heading h2{margin:4px 0 0;font-family:var(--font-display,serif);font-size:1.55rem;color:#162840}.document-section-heading p{max-width:340px;margin:0;color:#7a818d;font-size:.75rem;text-align:right}.document-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.document-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid rgba(18,35,59,.1);border-radius:14px;background:#fff;box-shadow:0 7px 25px rgba(23,38,59,.07);transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}.document-card:hover{transform:translateY(-3px);border-color:rgba(184,149,63,.38);box-shadow:0 15px 35px rgba(23,38,59,.12)}.document-card[hidden],.document-section[hidden],.document-empty[hidden]{display:none}.document-preview{position:relative;display:grid;place-items:center;height:180px;overflow:hidden;background:linear-gradient(145deg,#eef0f1,#faf8f1)}.document-preview iframe{width:125%;height:150%;border:0;pointer-events:none;transform:scale(.8)}.document-preview img{width:100%;height:100%;object-fit:cover}.file-mark{display:grid;place-items:center;width:76px;height:92px;border-radius:8px 8px 11px 11px;background:#fff;color:#a44e4e;box-shadow:0 8px 22px rgba(26,40,58,.12);font-size:.68rem;font-weight:800;letter-spacing:.06em}.file-docx{color:#456da4}.file-xlsx{color:#3d7d5b}.file-pptx{color:#ae603c}.file-zip{color:#84679a}.featured-ribbon{position:absolute;top:12px;right:12px;border-radius:999px;padding:5px 8px;background:#b8953f;color:#fff;font-size:.54rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.featured-card{border-color:rgba(184,149,63,.32)}.document-card-body{display:flex;flex:1;flex-direction:column;padding:17px}.document-badges{display:flex;flex-wrap:wrap;gap:6px}.document-badges span{border:1px solid rgba(184,149,63,.22);border-radius:999px;padding:4px 7px;background:#fdf8eb;color:#8e6a25;font-size:.53rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.document-card h3{margin:12px 0 7px;color:#172941;font-family:var(--font-display,serif);font-size:1.05rem;line-height:1.3}.document-description{display:-webkit-box;min-height:3.7em;margin:0;overflow:hidden;color:#747b87;font-size:.72rem;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:3}.document-meta{display:flex;flex-wrap:wrap;gap:5px 12px;margin-top:14px;padding-top:11px;border-top:1px solid rgba(18,35,59,.08);color:#89909a;font-size:.6rem}.document-meta span+span:before{content:'·';margin-right:10px;color:#c0a568}.document-actions{display:flex;align-items:center;gap:7px;margin-top:16px}.document-actions a{border-radius:7px;padding:8px 10px;text-decoration:none;font-size:.62rem;font-weight:700}.preview-link{border:1px solid rgba(18,35,59,.15);color:#344862}.download-link{background:#b8953f;color:white;box-shadow:0 5px 12px rgba(184,149,63,.23)}.open-link{margin-left:auto;color:#8c6a27}.document-empty{display:grid;justify-items:center;padding:75px 20px;text-align:center}.empty-illustration{position:relative;width:92px;height:78px}.empty-illustration span{position:absolute;inset:9px 20px 0;border:1px solid rgba(184,149,63,.35);border-radius:8px;background:#fffaf0;transform:rotate(-5deg)}.empty-illustration span:after{content:'';position:absolute;left:14px;right:14px;top:20px;height:18px;border-top:2px solid rgba(184,149,63,.25);border-bottom:2px solid rgba(184,149,63,.25)}.empty-illustration i{position:absolute;right:7px;bottom:2px;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#142740;color:#ddc782;font-style:normal}.document-empty h2{margin:15px 0 5px;font-family:var(--font-display,serif);color:#172941}.document-empty p{margin:0;color:#7b828d;font-size:.78rem}.document-empty button{margin-top:17px;border:1px solid rgba(18,35,59,.18);border-radius:8px;padding:9px 13px;background:white;color:#253851;font-size:.7rem;font-weight:700}
  @media(max-width:850px){.document-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.document-toolbar{grid-template-columns:1fr}.document-count{margin:0}.document-filter-row label{flex:1}.document-filter-row select{width:100%;min-width:0}}
  @media(max-width:560px){.documents-hero{padding-top:2rem;padding-bottom:2rem}.document-toolbar{padding:13px}.document-filter-row{display:grid;grid-template-columns:1fr 1fr}.document-filter-row label:last-child{grid-column:1/-1}.document-grid{grid-template-columns:1fr}.document-section{margin-top:32px}.document-section-heading{display:block}.document-section-heading p{margin-top:6px;text-align:left}.document-preview{height:165px}.document-actions a{padding:8px 9px}}
</style>
