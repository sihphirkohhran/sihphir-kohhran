---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { resolveDocumentUrl } from '../lib/documents-url';
import { parseMonthFromDate, parseYearFromDate, parseYearMonthFromId } from '../lib/archive';
import { formatHistoricalYear, historicalYearFilterValue, resolveHistoricalYearType } from '../lib/historical-year';
import { getPageSettings } from '../lib/page-settings';
import PageHero from '../components/PageHero.astro';
const ui=await getPageSettings('documents',{hero_caption:'Sihphir Presbyterian Kohhran',search_placeholder:'Search title, description, category or year…',download_button:'Download',category_label:'Category',document_label:'Document',empty_message:'No documents found'});

const pageEntry=await getEntry('settings','document-page');
const page={...ui,...(pageEntry?.data as Record<string,string>|undefined)};
const categoryRegistry = await getEntry('settings', 'document-categories');
const registeredCategories = categoryRegistry?.data.categories ?? [];
const entries = await getCollection('documents');

const fileExtension = (value: string) => {
  const clean = value.split(/[?#]/)[0];
  const match = clean.match(/\.([a-z0-9]+)$/i);
  return match?.[1]?.toLowerCase() ?? 'file';
};

const filenameFromUrl = (value: string) => {
  try {
    const pathname = value.startsWith('http') ? new URL(value).pathname : value;
    return decodeURIComponent(pathname.split('/').pop() || 'Document');
  } catch {
    return value.split('/').pop() || 'Document';
  }
};

const documentSortDate = (value: string | undefined, year: number | null, month: number | null, id: string) => {
  const text = String(value || '').trim();
  const dayFirst = text.match(/^(\d{1,2})[.\-/](\d{1,2})[.\-/](\d{4})$/);
  if (dayFirst) return `${dayFirst[3]}-${dayFirst[2].padStart(2, '0')}-${dayFirst[1].padStart(2, '0')}`;
  const parsed = Date.parse(text);
  if (text && !Number.isNaN(parsed)) return new Date(parsed).toISOString();
  return `${String(year ?? 0).padStart(4, '0')}-${String(month ?? 0).padStart(2, '0')}-${id}`;
};

const documents = entries
  .filter((entry) => entry.data.status !== 'archived' && entry.data.published !== false)
  .map((entry) => {
    const data = entry.data;
    const legacyUrl = resolveDocumentUrl(data.pdf_url, data.pdf_external);
    const storedFiles = Array.isArray(data.files) ? data.files : [];
    const normalizedFiles = storedFiles
      .map((file) => ({
        url: resolveDocumentUrl(file.url),
        filename: file.filename || filenameFromUrl(file.url),
        size: file.size ?? null,
        uploadedAt: file.uploaded_at || '',
        modifiedAt: file.modified_at || '',
        type: file.type || '',
      }))
      .filter((file) => file.url);
    if (legacyUrl && !normalizedFiles.some((file) => file.url === legacyUrl)) {
      normalizedFiles.unshift({
        url: legacyUrl,
        filename: filenameFromUrl(legacyUrl),
        size: null,
        uploadedAt: '',
        modifiedAt: '',
        type: '',
      });
    }
    const primary = normalizedFiles[0];
    const fromId = parseYearMonthFromId(entry.id);
    const legacyYear = data.year ?? fromId.year ?? parseYearFromDate(data.date) ?? null;
    const yearType = resolveHistoricalYearType(legacyYear, (data as typeof data & { yearType?: 'known' | 'approximate' | 'unspecified' }).yearType);
    const year = yearType === 'unspecified' ? null : legacyYear;
    const yearLabel = formatHistoricalYear(year, yearType);
    const yearFilterValue = historicalYearFilterValue(year, yearType);
    const month = data.month ?? fromId.month ?? parseMonthFromDate(data.date) ?? null;
    const category = String(
      data.category || (entry.id.startsWith('ktp-inleng/') ? 'KTP Inleng' : 'Other'),
    );
    const description = String(data.description || entry.body || '').replace(/<[^>]*>/g, '').trim();
    const uploadDate = primary?.uploadedAt || data.date || '';
    const sortDate = documentSortDate(primary?.uploadedAt || primary?.modifiedAt || data.date, year, month, entry.id);
    const ext = fileExtension(primary?.filename || primary?.url || '');
    return {
      id: entry.id,
      title: String(data.name),
      description,
      category,
      year,
      yearType,
      yearLabel,
      yearFilterValue,
      uploadDate,
      sortDate,
      featured: Boolean(data.featured),
      pinned: Boolean(data.pinned),
      url: primary?.url || '',
      filename: primary?.filename || '',
      size: primary?.size ?? null,
      extension: ext,
      previewable: ext === 'pdf' || ['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif', 'svg'].includes(ext),
      image: ['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif', 'svg'].includes(ext),
      fileCount: normalizedFiles.length,
    };
  })
  .filter((document) => document.url)
  .sort((a, b) => b.sortDate.localeCompare(a.sortDate));

const categories = Array.from(new Set([
  ...registeredCategories.map((category) => category.name),
  ...documents.map((document) => document.category),
])).filter(Boolean);
const years = Array.from(new Set(documents.map((document) => document.year).filter((year): year is number => year != null))).sort((a, b) => b - a);
const hasUnspecifiedYear = documents.some((document) => document.yearType === 'unspecified');
const featuredDocuments = documents.filter((document) => document.featured);
const archiveDocuments = documents.filter((document) => !document.featured);

const formatSize = (size: number | null) => {
  if (size == null) return 'Size unavailable';
  if (size < 1024) return `${size} B`;
  if (size < 1024 * 1024) return `${(size / 1024).toFixed(1)} KB`;
  return `${(size / (1024 * 1024)).toFixed(1)} MB`;
};
const formatDate = (value: string) => {
  if (!value) return 'Archive record';
  const parsed = new Date(value);
  if (Number.isNaN(parsed.valueOf())) return value;
  return new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(parsed);
};
const iconLabel = (ext: string) => ({ pdf: 'PDF', docx: 'DOCX', xlsx: 'XLSX', pptx: 'PPTX', zip: 'ZIP' }[ext] || (['jpg','jpeg','png','gif','webp','avif','svg'].includes(ext) ? 'IMAGE' : ext.toUpperCase()));
---

<BaseLayout title={page.seo_title} description={page.seo_description} activePage="document">
  <PageHero title={page.hero_title} subtitle={page.hero_subtitle} image={page.hero_background_image} eyebrow={page.hero_caption} />

  <main class="documents-page max-w-6xl mx-auto px-4 py-8 sm:py-10" data-download-label={ui.download_button}>
    {page.intro_text && <p class="page-intro reveal">{page.intro_text}</p>}
    <section class="document-toolbar reveal" aria-label="Document search and filters">
      <label class="document-search" for="document-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
        <span class="sr-only">{ui.search_placeholder}</span>
        <input id="document-search" type="search" placeholder={ui.search_placeholder} autocomplete="off" />
      </label>
      <div class="document-filter-row">
        <label><span>{ui.category_label}</span><select id="document-category"><option value="all">All categories</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
        <label><span>Year</span><select id="document-year"><option value="all">All years</option>{years.map((year) => <option value={year}>{year}</option>)}{hasUnspecifiedYear && <option value="unspecified">Year Unspecified</option>}</select></label>
        <label><span>Sort</span><select id="document-sort"><option value="newest">Newest</option><option value="oldest">Oldest</option><option value="title">Title A–Z</option></select></label>
      </div>
      <p id="document-count" class="document-count">{documents.length} documents</p>
    </section>

    {featuredDocuments.length > 0 && (
      <section class="document-section" id="featured-documents">
        <div class="document-section-heading reveal">
          <div><span>Selected archive</span><h2>Featured Documents</h2></div>
          <p>Important publications and frequently requested records.</p>
        </div>
        <div class="document-grid featured-grid" id="featured-grid">
          {featuredDocuments.map((document, index) => (
            <article class={`document-card featured-card reveal reveal-delay-${(index % 3) + 1}`} data-document-card data-title={document.title.toLowerCase()} data-description={document.description.toLowerCase()} data-category={document.category} data-year={document.yearFilterValue} data-date={document.sortDate}>
              <div class="document-card-body">
                <div class="document-card-top"><span class={`file-icon file-${document.extension}`} aria-label={`${iconLabel(document.extension)} file`}><svg viewBox="0 0 20 22" aria-hidden="true"><path d="M4 1.5h7l5 5V20.5H4z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M11 1.8v5h5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><span>{iconLabel(document.extension)}</span></span><span class="featured-ribbon">Featured</span></div>
                <div class="document-badges"><span>{document.category}</span><span>{document.yearLabel}</span></div>
                <h3>{document.title}</h3>
                {document.description && <p class="document-description">{document.description}</p>}
                <div class="document-meta"><span>{formatDate(document.uploadDate)}</span><span>{formatSize(document.size)}</span><span>{document.fileCount} {document.fileCount === 1 ? 'file' : 'files'}</span></div>
                <div class="document-actions"><a href={document.url} target="_blank" rel="noopener noreferrer" class="view-link">View Document</a><a href={document.url} download class="download-link">Download</a></div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="document-section archive-section">
      <div class="document-grid" id="document-grid">
        {archiveDocuments.map((document, index) => (
          <article class={`document-card reveal reveal-delay-${(index % 3) + 1}`} data-document-card data-title={document.title.toLowerCase()} data-description={document.description.toLowerCase()} data-category={document.category} data-year={document.yearFilterValue} data-date={document.sortDate}>
            <div class="document-card-body">
              <div class="document-card-top"><span class={`file-icon file-${document.extension}`} aria-label={`${iconLabel(document.extension)} file`}>{iconLabel(document.extension)}</span></div>
              <div class="document-badges"><span>{document.category}</span><span>{document.yearLabel}</span></div>
              <h3>{document.title}</h3>
              {document.description && <p class="document-description">{document.description}</p>}
              <div class="document-meta"><span>{formatDate(document.uploadDate)}</span><span>{formatSize(document.size)}</span><span>{document.fileCount} {document.fileCount === 1 ? 'file' : 'files'}</span></div>
              <div class="document-actions"><a href={document.url} target="_blank" rel="noopener noreferrer" class="view-link">View Document</a><a href={document.url} download class="download-link">Download</a></div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="document-empty" id="document-empty" hidden>
      <div class="empty-illustration" aria-hidden="true"><span></span><i>⌕</i></div>
      <h2>{ui.empty_message}</h2>
      <p>Try a different search term or clear one of the filters.</p>
      <button type="button" id="document-clear">Clear filters</button>
    </section>
  </main>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#document-search');
  const category = document.querySelector<HTMLSelectElement>('#document-category');
  const year = document.querySelector<HTMLSelectElement>('#document-year');
  const sort = document.querySelector<HTMLSelectElement>('#document-sort');
  const empty = document.querySelector<HTMLElement>('#document-empty');
  const count = document.querySelector<HTMLElement>('#document-count');
  const downloadLabel=document.querySelector<HTMLElement>('.documents-page')?.dataset.downloadLabel;document.querySelectorAll('.download-link').forEach(link=>{if(downloadLabel)link.textContent=downloadLabel;});

  function applyFilters() {
    const query = search?.value.trim().toLowerCase() || '';
    const selectedCategory = category?.value || 'all';
    const selectedYear = year?.value || 'all';
    let visible = 0;

    document.querySelectorAll<HTMLElement>('[data-document-card]').forEach((card) => {
      const haystack = `${card.dataset.title} ${card.dataset.description} ${card.dataset.category?.toLowerCase()} ${card.dataset.year}`;
      const matches = (!query || haystack.includes(query)) &&
        (selectedCategory === 'all' || card.dataset.category === selectedCategory) &&
        (selectedYear === 'all' || card.dataset.year === selectedYear);
      card.hidden = !matches;
      if (matches) visible++;
    });

    document.querySelectorAll<HTMLElement>('.document-grid').forEach((grid) => {
      const cards = [...grid.querySelectorAll<HTMLElement>('[data-document-card]')];
      cards.sort((a, b) => {
        if (sort?.value === 'title') return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        const result = (b.dataset.date || '').localeCompare(a.dataset.date || '');
        return sort?.value === 'oldest' ? -result : result;
      }).forEach((card) => grid.append(card));
    });

    document.querySelector<HTMLElement>('#featured-documents')?.toggleAttribute('hidden', !document.querySelector('#featured-grid [data-document-card]:not([hidden])'));
    document.querySelector<HTMLElement>('.archive-section')?.toggleAttribute('hidden', !document.querySelector('#document-grid [data-document-card]:not([hidden])'));
    if (empty) empty.hidden = visible > 0;
    if (count) count.textContent = `${visible} document${visible === 1 ? '' : 's'}`;
  }

  [search, category, year].forEach((control) => control?.addEventListener(control === search ? 'input' : 'change', applyFilters));
  sort?.addEventListener('change', applyFilters);
  document.querySelector('#document-clear')?.addEventListener('click', () => {
    if (search) search.value = '';
    if (category) category.value = 'all';
    if (year) year.value = 'all';
    if (sort) sort.value = 'newest';
    applyFilters();
    search?.focus();
  });
  applyFilters();
</script>

<style>
  .documents-page{color:#13233a}
  .document-toolbar{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:15px;padding:18px;border:1px solid rgba(18,35,59,.11);border-radius:12px;background:#fffdf8}
  .document-search{grid-column:1/-1;display:flex;align-items:center;gap:11px;border:1px solid rgba(18,35,59,.18);border-radius:8px;padding:0 14px;background:white}
  .document-search:focus-within{border-color:#b8953f;box-shadow:0 0 0 3px rgba(184,149,63,.12)}
  .document-search svg{width:19px;height:19px;fill:none;stroke:#9a772b;stroke-width:1.7}
  .document-search input{width:100%;border:0;outline:0;padding:13px 0;background:transparent;color:#182941;font-family:var(--font-body,serif);font-size:.9rem}
  .document-filter-row{display:flex;flex-wrap:wrap;gap:10px}
  .document-filter-row label{display:grid;gap:5px}
  .document-filter-row label>span{font-size:.58rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#7b8290}
  .document-filter-row select{min-width:150px;border:1px solid rgba(18,35,59,.16);border-radius:8px;padding:9px 32px 9px 10px;background:white;color:#263851;font-size:.76rem}
  .document-count{align-self:end;margin:0 2px 10px;color:#79808b;font-size:.72rem}
  .document-section{margin-top:36px}
  .document-section-heading{display:flex;justify-content:space-between;gap:25px;align-items:end;margin-bottom:16px}
  .document-section-heading span{color:#9c7628;font-size:.57rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
  .document-section-heading h2{margin:4px 0 0;font-family:var(--font-display,serif);font-size:1.5rem;color:#162840}
  .document-section-heading p{max-width:340px;margin:0;color:#7a818d;font-size:.75rem;text-align:right}
  .document-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .document-card{display:flex;min-width:0;flex-direction:column;border:1px solid rgba(18,35,59,.12);border-radius:10px;background:#fff;transition:border-color .18s ease,background .18s ease}
  .document-card:hover{border-color:rgba(184,149,63,.55);background:#fffefa}
  .document-card[hidden],.document-section[hidden],.document-empty[hidden]{display:none}
  .document-card-body{display:flex;flex:1;flex-direction:column;padding:16px}
  .document-card-top{display:flex;align-items:center;justify-content:space-between;min-height:34px;margin-bottom:10px}
  .file-icon{display:inline-flex;align-items:center;gap:5px;min-width:54px;height:32px;padding:0 7px;border:1px solid rgba(164,78,78,.2);border-radius:5px;background:#fff7f5;color:#a44e4e;font-size:.55rem;font-weight:800;letter-spacing:.04em}.file-icon svg{width:13px;height:15px;flex:none}
  .file-docx,.file-doc{border-color:rgba(69,109,164,.2);background:#f3f7fc;color:#456da4}
  .file-xlsx,.file-xls,.file-csv{border-color:rgba(61,125,91,.2);background:#f2f8f3;color:#3d7d5b}
  .file-pptx,.file-ppt{border-color:rgba(174,96,60,.2);background:#fff5ef;color:#ae603c}
  .file-zip{border-color:rgba(132,103,154,.2);background:#f8f4fb;color:#84679a}
  .featured-ribbon{border-radius:999px;padding:4px 8px;background:#fdf8eb;color:#8e6a25;font-size:.53rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .featured-card{border-color:rgba(184,149,63,.35)}
  .document-badges{display:flex;flex-wrap:wrap;gap:6px}
  .document-badges span{border:1px solid rgba(184,149,63,.22);border-radius:999px;padding:4px 7px;background:#fdf8eb;color:#8e6a25;font-size:.53rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .document-card h3{margin:9px 0 5px;color:#172941;font-family:var(--font-display,serif);font-size:1.02rem;line-height:1.35}
  .document-description{display:-webkit-box;margin:0;overflow:hidden;color:#747b87;font-size:.72rem;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}
  .document-meta{display:flex;flex-wrap:wrap;gap:5px 12px;margin-top:12px;padding-top:10px;border-top:1px solid rgba(18,35,59,.08);color:#89909a;font-size:.6rem}
  .document-meta span+span:before{content:'·';margin-right:10px;color:#c0a568}
  .document-actions{display:flex;align-items:center;gap:8px;margin-top:13px}
  .document-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:33px;border-radius:6px;padding:7px 12px;text-decoration:none;font-size:.63rem;font-weight:700}
  .view-link{border:1px solid rgba(184,149,63,.55);background:#fdf8eb;color:#253851}
  .view-link:hover{border-color:#b8953f;background:#f8efd9}
  .download-link{border:1px solid rgba(184,149,63,.4);background:#fffaf0;color:#8c6a27}
  .download-link:hover{border-color:#b8953f;background:#fdf5e4}
  .document-empty{display:grid;justify-items:center;padding:75px 20px;text-align:center}
  .empty-illustration{position:relative;width:92px;height:78px}
  .empty-illustration span{position:absolute;inset:9px 20px 0;border:1px solid rgba(184,149,63,.35);border-radius:8px;background:#fffaf0;transform:rotate(-5deg)}
  .empty-illustration span:after{content:'';position:absolute;left:14px;right:14px;top:20px;height:18px;border-top:2px solid rgba(184,149,63,.25);border-bottom:2px solid rgba(184,149,63,.25)}
  .empty-illustration i{position:absolute;right:7px;bottom:2px;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#142740;color:#ddc782;font-style:normal}
  .document-empty h2{margin:15px 0 5px;font-family:var(--font-display,serif);color:#172941}
  .document-empty p{margin:0;color:#7b828d;font-size:.78rem}
  .document-empty button{margin-top:17px;border:1px solid rgba(18,35,59,.18);border-radius:8px;padding:9px 13px;background:white;color:#253851;font-size:.7rem;font-weight:700}
  @media(max-width:760px){.document-grid{grid-template-columns:1fr}.document-toolbar{grid-template-columns:1fr}.document-count{margin:0}.document-filter-row label{flex:1}.document-filter-row select{width:100%;min-width:0}}
  @media(max-width:560px){.documents-hero{padding-top:2rem;padding-bottom:2rem}.document-toolbar{padding:13px}.document-filter-row{display:grid;grid-template-columns:1fr 1fr}.document-filter-row label:last-child{grid-column:1/-1}.document-section{margin-top:30px}.document-section-heading{display:block}.document-section-heading p{margin-top:6px;text-align:left}.document-card-body{padding:14px}.document-actions a{flex:1}}
</style>
