---
import { getCollection } from 'astro:content';
import MinistryArchive from '../components/MinistryArchive.astro';
import { normalizeMinistryProfile } from '../lib/ministry-profile';
const profiles=(await getCollection('elders')).map(entry=>normalizeMinistryProfile(entry,'elder')).filter((profile): profile is NonNullable<typeof profile>=>Boolean(profile));
---
<MinistryArchive title="Kohhran Upa" subtitle="The elders entrusted with spiritual leadership, pastoral care and faithful service in our congregation." activePage="elders-history" currentLabel="Current Upa" historyLabel="Upa History Timeline" profiles={profiles} />
