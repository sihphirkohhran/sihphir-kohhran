---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import { getCollection } from 'astro:content';
import { resolveMediaUrl } from '../lib/ministry';
import { renderMarkdown } from '../lib/markdown';

const entries = (await getCollection('elders')).sort(
  (a, b) => a.data.name.localeCompare(b.data.name),
);

const elderPayload = entries.map((e) => ({
  id: e.id,
  name: e.data.name,
  photo: resolveMediaUrl(e.data.photo),
  ordained_year: e.data.ordained_year,
  status: e.data.status ?? '',
  notesHtml: renderMarkdown(e.data.notes),
}));
---

<ContentPageLayout
  title="Kohhran Upate"
  activeKey="elders-history"
  unboxed
>

  {entries.length === 0 ? (
    <p class="text-gray-600">No elder profiles yet. Add elders in Admin → Elders History.</p>
  ) : (
    <div class="pastoral-grid" id="elders-grid">
      {entries.map((entry) => {
        const d = entry.data;
        const photo = resolveMediaUrl(d.photo);
        return (
          <button
            type="button"
            class="ministry-profile-card elder-card reveal"
            data-elder-id={entry.id}
            aria-label={`View profile: ${d.name}`}
          >
            {photo ? (
              <img src={photo} alt={d.name} class="ministry-profile-photo" loading="lazy" />
            ) : (
              <div class="ministry-profile-photo ministry-profile-photo-placeholder">No photo</div>
            )}
            <div class="ministry-profile-details">
              <h2 class="ministry-profile-name">{d.name}</h2>
              <p class="ministry-profile-meta">
                <span class="ministry-profile-label">Ordained:</span> {d.ordained_year}
              </p>
              {d.status?.trim() && (
                <p class="ministry-profile-meta text-sm text-gray-600">{d.status}</p>
              )}
            </div>
          </button>
        );
      })}
    </div>
  )}

</ContentPageLayout>

<div class="elder-modal" id="elder-modal" role="dialog" aria-modal="true" aria-labelledby="elder-modal-title" hidden>
  <div class="elder-modal-panel">
    <button type="button" class="elder-modal-close" id="elder-modal-close" aria-label="Close">&times;</button>
    <div class="ministry-profile-card elder-modal-profile">
      <img id="elder-modal-photo" src="" alt="" class="ministry-profile-photo hidden" />
      <div id="elder-modal-photo-placeholder" class="ministry-profile-photo ministry-profile-photo-placeholder hidden">No photo</div>
      <div class="ministry-profile-details">
        <h2 id="elder-modal-title" class="ministry-profile-name"></h2>
        <p id="elder-modal-year" class="ministry-profile-meta"></p>
        <p id="elder-modal-status" class="ministry-profile-meta text-sm text-gray-600 hidden"></p>
        <div id="elder-modal-notes" class="ministry-profile-notes content-page-body text-left"></div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ elderPayload }}>
  const modal = document.getElementById('elder-modal');
  const closeBtn = document.getElementById('elder-modal-close');
  const titleEl = document.getElementById('elder-modal-title');
  const yearEl = document.getElementById('elder-modal-year');
  const statusEl = document.getElementById('elder-modal-status');
  const photoEl = document.getElementById('elder-modal-photo');
  const photoPlaceholder = document.getElementById('elder-modal-photo-placeholder');
  const notesEl = document.getElementById('elder-modal-notes');
  const byId = Object.fromEntries(elderPayload.map((e) => [e.id, e]));

  function openElder(id) {
    const elder = byId[id];
    if (!elder || !modal) return;
    if (titleEl) titleEl.textContent = elder.name;
    if (yearEl) {
      yearEl.innerHTML = '<span class="ministry-profile-label">Ordained:</span> ' + elder.ordained_year;
    }
    if (statusEl) {
      if (elder.status?.trim()) {
        statusEl.textContent = elder.status;
        statusEl.classList.remove('hidden');
      } else {
        statusEl.classList.add('hidden');
      }
    }
    if (photoEl && photoPlaceholder) {
      if (elder.photo) {
        photoEl.src = elder.photo;
        photoEl.alt = elder.name;
        photoEl.classList.remove('hidden');
        photoPlaceholder.classList.add('hidden');
      } else {
        photoEl.classList.add('hidden');
        photoPlaceholder.classList.remove('hidden');
      }
    }
    if (notesEl) {
      notesEl.innerHTML = elder.notesHtml || '<p class="text-gray-500">No additional notes.</p>';
    }
    modal.removeAttribute('hidden');
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeElder() {
    modal?.classList.remove('is-open');
    modal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  document.getElementById('elders-grid')?.addEventListener('click', (e) => {
    const card = e.target.closest('[data-elder-id]');
    if (card) openElder(card.dataset.elderId);
  });
  closeBtn?.addEventListener('click', closeElder);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeElder();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeElder();
  });
</script>
