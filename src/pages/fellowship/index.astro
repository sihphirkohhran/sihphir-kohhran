---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fellowshipMeta, type FellowshipSlug } from '../../lib/fellowship-meta';
import { publishedFellowships } from '../../lib/fellowship-records';
import { getPageSettings } from '../../lib/page-settings';
const ui=await getPageSettings('fellowship',{hero_caption:'Sihphir Presbyterian Kohhran',hero_title:'Fellowship',hero_subtitle:'Thalai, hmeichhia, mipa leh member zawng zawng tan',history_title:'History',office_bearers_title:'Office Bearers',members_title:'Committee Members',gallery_title:'Gallery',documents_title:'Documents',search_placeholder:'Search fellowships…',empty_message:'No fellowships found',back_button:'All Fellowships'});

const fellowshipViewButton=ui.view_button||'View Details';
const fellowshipEntries = await getCollection('fellowship');
const fellowships = publishedFellowships(fellowshipEntries).map(({ slug: id, entry }) => {
  const data = entry.data;
  const meta = fellowshipMeta[id as FellowshipSlug];
  const name = meta?.name ?? data.fellowship_name ?? id.replace(/-/g, ' ');
  return {
    id, name,
    abbr: meta?.abbr ?? name.split(/\s+/).map(word => word[0]).join('').slice(0, 3).toUpperCase(),
    color: meta?.accentColor ?? 'from-navy to-navy-light',
    description: data.short_description ?? data.description ?? data.history_short ?? '',
    logo: data.logo,
    order: meta ? Object.keys(fellowshipMeta).indexOf(id) : (data.display_order ?? data.homepage_order ?? 999),
  };
}).sort((a,b) => a.order - b.order || a.name.localeCompare(b.name));
---

<BaseLayout title="Fellowship — Sihphir Presbyterian Kohhran" activePage="fellowship">

  <div class="bg-navy border-b-2 border-gold px-4 py-8 text-center relative overflow-hidden fellowship-hero">
    <div class="relative z-10">
      <p class="font-body text-[0.6rem] tracking-[0.14em] uppercase text-gold-pale/50 mb-2">{ui.hero_caption}</p>
      <h1 class="font-display text-white text-2xl sm:text-3xl font-semibold">{ui.hero_title}</h1>
      <p class="font-body text-gold-pale/60 text-sm mt-2 italic">{ui.hero_subtitle}</p>
      <div class="w-16 h-px bg-gold/40 mx-auto mt-3"></div>
    </div>
  </div>

  <div class="max-w-2xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {fellowships.map((f, i) => (
        <a
          href={`/fellowship/${f.id}`}
          class={`reveal reveal-delay-${i + 1} group block bg-navy border border-gold/20 rounded overflow-hidden hover:border-gold/50 transition-all hover:-translate-y-0.5`}
        >
          <div class={`h-1.5 bg-gradient-to-r ${f.color}`}></div>
          <div class="p-5">
            <div class="w-12 h-12 rounded-full border-2 border-gold/40 flex items-center justify-center mb-4 group-hover:border-gold/70 transition-colors overflow-hidden bg-gold/[0.06]">
              {f.logo ? (
                <img src={f.logo} alt="" class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <span class="font-display text-gold-light font-bold text-lg">{f.abbr}</span>
              )}
            </div>
            <h2 class="font-display text-white text-lg font-semibold leading-tight mb-3">{f.name}</h2>
            <p class="font-body text-gold-pale/60 text-xs leading-relaxed mb-4">{f.description}</p>
            <div class="flex items-center gap-1 font-body text-[0.65rem] tracking-wider uppercase text-gold/70 group-hover:text-gold transition-colors">
              {fellowshipViewButton}
              <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

</BaseLayout>
