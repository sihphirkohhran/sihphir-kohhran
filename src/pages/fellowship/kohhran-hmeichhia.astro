---
import FellowshipPage from '../../components/FellowshipPage.astro';
import { getCollection } from 'astro:content';
import { fellowshipMeta } from '../../lib/fellowship-meta';
import { fellowshipHistoryToHtml } from '../../lib/cms';
import { resolveGroupPhotos, resolveRelatedGalleryPhotos, resolveRelatedDocuments } from '../../lib/fellowship';
import { currentFellowshipRecord } from '../../lib/fellowship-records';

const meta = fellowshipMeta['kohhran-hmeichhia'];
const [fellowshipEntries, galleryEntries, documentEntries] = await Promise.all([getCollection('fellowship'), getCollection('gallery'), getCollection('documents')]);
const record = currentFellowshipRecord(fellowshipEntries, 'kohhran-hmeichhia');
if (!record) throw new Error('Fellowship content not found: kohhran-hmeichhia');
const data = record.data;
---

<FellowshipPage
  name={meta.name}
  abbr={meta.abbr}
  subtitle={meta.subtitle}
  accentColor={meta.accentColor}
  logo={data.logo}
  groupPhotos={resolveGroupPhotos({ ...data, group_photo: data.cover_photo ?? data.banner_image ?? data.group_photo })}
  history={data.description ?? data.history_short}
  historyFull={fellowshipHistoryToHtml(data.full_history ?? data.history_full)}
  relatedPhotos={resolveRelatedGalleryPhotos(galleryEntries, data.related_galleries)}
  relatedDocuments={resolveRelatedDocuments(documentEntries, data.related_documents)}
  officeBearers={data.office_bearers}
  committeeMembers={data.members.sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0)).map((m) => ({
    name: m.name,
    role: m.designation ?? m.role ?? 'Member', photo: m.photo, notes: m.notes,
  }))}
/>
