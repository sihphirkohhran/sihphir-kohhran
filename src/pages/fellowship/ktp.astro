---
import FellowshipPage from '../../components/FellowshipPage.astro';
import { getCollection } from 'astro:content';
import { fellowshipMeta } from '../../lib/fellowship-meta';
import { fellowshipHistoryToHtml } from '../../lib/cms';
import { resolveGroupPhotos } from '../../lib/fellowship';
import { currentFellowshipRecord } from '../../lib/fellowship-records';

const meta = fellowshipMeta.ktp;
const record = currentFellowshipRecord(await getCollection('fellowship'), 'ktp');
if (!record) throw new Error('Fellowship content not found: ktp');
const data = record.data;
---

<FellowshipPage
  name={meta.name}
  abbr={meta.abbr}
  subtitle={meta.subtitle}
  accentColor={meta.accentColor}
  logo={data.logo}
  groupPhotos={resolveGroupPhotos({ ...data, group_photo: data.banner_image ?? data.group_photo })}
  history={data.description ?? data.history_short}
  historyFull={fellowshipHistoryToHtml(data.history_full)}
  officeBearers={data.office_bearers}
  committeeMembers={data.members.sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0)).map((m) => ({
    name: m.name,
    role: m.role ?? 'Member',
  }))}
/>
