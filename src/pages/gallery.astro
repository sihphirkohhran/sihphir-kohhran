m:translateY(-4px);border-color:rgba(184,149,63,.38);box-shadow:0 16px 36px rgba(23,38,59,.13)}.album-cover{position:relative;width:100%;height:220px;overflow:hidden;border:0;padding:0;background:#e8ebed;text-align:left;cursor:pointer}.album-cover img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}.album-card:hover .album-cover img{transform:scale(1.06)}.cover-badges{position:absolute;top:12px;left:12px}.cover-badges span{border:0;background:rgba(20,39,64,.88);color:#f4dfaa;backdrop-filter:blur(5px)}.album-cover>strong{position:absolute;right:12px;bottom:12px;border-radius:999px;padding:5px 8px;background:rgba(255,255,255,.91);color:#172941;font-size:.56rem}.album-body{display:flex;flex:1;flex-direction:column;padding:17px}.album-body h3{margin:0 0 8px;font-family:var(--font-display,serif);font-size:1.08rem}.album-body p{display:-webkit-box;min-height:3.5em;margin:0;overflow:hidden;color:#747b87;font-size:.72rem;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:3}.album-body small{margin-top:11px;color:#949aa2;font-size:.6rem}.album-body button{margin-top:auto;padding-top:9px;padding-bottom:9px}.gallery-empty{display:grid;justify-items:center;margin-top:34px;padding:62px 20px;border:1px solid rgba(18,35,59,.1);border-radius:15px;background:#fffdf8;text-align:center;box-shadow:0 10px 30px rgba(23,38,59,.06)}.gallery-empty>div{position:relative;width:82px;height:65px}.gallery-empty>div span{position:absolute;inset:5px 10px;border:1px solid rgba(184,149,63,.35);border-radius:9px;background:white;transform:rotate(-4deg)}.gallery-empty>div i{position:absolute;right:3px;bottom:0;width:28px;height:28px;border-radius:50%;background:#142740}.gallery-empty h2{margin:12px 0 4px;font-family:var(--font-display,serif)}.gallery-empty p{margin:0;color:#7b828d;font-size:.76rem}.gallery-empty button{justify-self:center;margin-top:16px}.album-card[hidden],.gallery-section[hidden],.gallery-toolbar[hidden],.gallery-empty[hidden],.album-detail[hidden]{display:none}.album-detail{padding-top:4px}.back-button{margin:0 0 18px;background:white;color:#31445e;border:1px solid rgba(18,35,59,.14)}.detail-hero{position:relative;height:clamp(360px,53vw,570px);overflow:hidden;border-radius:16px;background:#142740;box-shadow:0 15px 40px rgba(17,34,56,.15)}.detail-hero>img{width:100%;height:100%;object-fit:cover}.detail-overlay{position:absolute;right:0;bottom:0;left:0;padding:100px 36px 30px;background:linear-gradient(transparent,rgba(8,20,36,.92));color:white}.detail-overlay h2{margin:13px 0 7px;color:white;font-family:var(--font-display,serif);font-size:clamp(1.65rem,4vw,2.35rem)}.detail-overlay>p{max-width:700px;margin:0;color:rgba(255,255,255,.73);font-size:.78rem;line-height:1.6}.photo-heading{margin-top:38px}.photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.photo-card{position:relative;aspect-ratio:4/3;overflow:hidden;border:0;border-radius:11px;padding:0;background:#e9ecee;cursor:zoom-in;box-shadow:0 5px 17px rgba(23,38,59,.08)}.photo-card img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease,filter .4s ease}.photo-card span{position:absolute;inset:auto 10px 10px auto;border-radius:999px;padding:5px 8px;background:rgba(20,39,64,.86);color:white;font-size:.55rem;opacity:0;transform:translateY(5px);transition:.25s}.photo-card:hover img{transform:scale(1.055);filter:brightness(.9)}.photo-card:hover span{opacity:1;transform:none}.photo-lightbox{width:100vw;max-width:none;height:100vh;max-height:none;overflow:hidden;border:0;padding:70px 62px 28px;background:rgba(4,11,21,.96)}.photo-lightbox::backdrop{background:rgba(4,11,21,.96)}.photo-lightbox>img{display:block;width:100%;height:100%;object-fit:contain;transition:transform .25s;cursor:zoom-in}.photo-lightbox>img.zoomed{transform:scale(1.7);cursor:zoom-out}.lightbox-bar{position:fixed;z-index:2;top:0;right:0;left:0;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:12px 18px;background:rgba(5,14,25,.84);color:white}.lightbox-bar p{display:flex;align-items:center;gap:12px;margin:0;min-width:0}.lightbox-bar p>span{color:#e2ca85;font-size:.7rem;font-weight:700}.lightbox-bar small{overflow:hidden;color:rgba(255,255,255,.65);font-size:.68rem;text-overflow:ellipsis;white-space:nowrap}.lightbox-bar>div{display:flex;align-items:center;gap:8px}.lightbox-bar a,.lightbox-bar button{border:1px solid rgba(255,255,255,.24);border-radius:7px;padding:7px 10px;background:transparent;color:white;text-decoration:none;font-size:.68rem}.lightbox-bar button:last-child{font-size:1.1rem}.lightbox-arrow{position:fixed;z-index:2;top:50%;width:42px;height:52px;border:1px solid rgba(255,255,255,.2);border-radius:9px;background:rgba(5,14,25,.7);color:white;font-size:2rem;transform:translateY(-50%)}.lightbox-arrow.previous{left:10px}.lightbox-arrow.next{right:10px}
