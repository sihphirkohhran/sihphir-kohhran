---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getFallbackGalleryPhotos } from '../lib/gallery';

const registry = await getEntry('settings', 'gallery-categories');
const registeredCategories = registry?.data.categories?.map((item) => item.name) ?? [];
const entries = (await getCollection('gallery')).filter((entry) => entry.data.status !== 'archived');

const albums = entries.map((entry) => {
  const data = entry.data;
  const raw = data.photos?.length ? data.photos : data.photo ? [data.photo] : [];
  const photos = raw.map((photo) => typeof photo === 'string'
    ? { src: photo, alt: data.caption, caption: data.caption }
    : { src: photo.src || photo.photo || '', alt: photo.alt || data.caption, caption: photo.caption || data.caption })
    .filter((photo) => photo.src);
  if (data.photo && !photos.some((photo) => photo.src === data.photo)) photos.unshift({ src: data.photo, alt: data.caption, caption: data.caption });
  return {
    id: entry.id.replace(/[^a-z0-9]+/gi, '-'), title: data.caption, year: data.year,
    category: data.category, description: data.description || '', date: data.date || '',
    order: data.display_order ?? Number.MAX_SAFE_INTEGER, featured: Boolean((data as typeof data & { featured?: boolean }).featured), photos,
  };
}).filter((album) => album.photos.length).sort((a, b) => b.year - a.year || a.order - b.order || a.title.localeCompare(b.title));

if (!albums.length) {
  const fallback = getFallbackGalleryPhotos(18);
  if (fallback.length) albums.push({ id: 'church-gallery', title: 'Church Gallery', year: fallback[0].year, category: 'Gallery', description: 'Photographs from Sihphir Presbyterian Kohhran.', date: '', order: 0, featured: false, photos: fallback.map(({ src, alt, caption }) => ({ src, alt, caption })) });
}

const featured = albums.filter((album) => album.featured);
const archive = albums.filter((album) => !album.featured);
const years = Array.from(new Set(albums.map((album) => album.year))).sort((a, b) => b - a);
const categories = Array.from(new Set([...registeredCategories, ...albums.map((album) => album.category)])).filter(Boolean).sort();
const photoCount = albums.reduce((sum, album) => sum + album.photos.length, 0);
const formatDate = (value: string) => {
  if (!value) return '';
  const parsed = new Date(value);
  return Number.isNaN(parsed.valueOf()) ? value : new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(parsed);
};
---

<BaseLayout title="Gallery — Sihphir Presbyterian Kohhran" activePage="gallery">
  <header class="gallery-hero bg-navy border-b-2 border-gold px-4 py-10 sm:py-12 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image:repeating-linear-gradient(45deg,#b8953f 0,#b8953f 1px,transparent 1px,transparent 28px)"></div>
    <div class="relative z-10 max-w-3xl mx-auto"><p>Sihphir Presbyterian Kohhran</p><h1>Church Gallery</h1><div class="gallery-hero-copy">A living photo archive of our worship, fellowship and life together.</div><div class="gallery-hero-stats"><span>{albums.length} album{albums.length === 1 ? '' : 's'}</span><i></i><span>{photoCount} photo{photoCount === 1 ? '' : 's'}</span></div></div>
  </header>

  <main class="gallery-page max-w-6xl mx-auto px-4 py-8 sm:py-10">
    <section class="gallery-toolbar reveal" aria-label="Gallery search and filters">
      <label class="gallery-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg><span class="sr-only">Search albums</span><input type="search" id="gallery-search" placeholder="Search albums, descriptions or categories…" autocomplete="off" /></label>
      <div class="gallery-filter-row"><label><span>Year</span><select id="gallery-year"><option value="all">All years</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label><label><span>Category</span><select id="gallery-category"><option value="all">All categories</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label><label><span>Sort</span><select id="gallery-sort"><option value="newest">Newest</option><option value="oldest">Oldest</option><option value="az">A–Z</option><option value="za">Z–A</option><option value="photos">Most Photos</option></select></label></div>
      <p id="gallery-count">{albums.length} albums · {photoCount} photos</p>
    </section>

    {featured.length > 0 && <section class="gallery-section featured-section" id="featured-galleries"><div class="section-heading reveal"><div><span>Selected collection</span><h2>Featured Gallery</h2></div><p>Highlights from the church photo archive.</p></div><div class="featured-grid" data-album-grid>{featured.map((album) => <article class="featured-album reveal" data-album-card data-id={album.id} data-title={album.title.toLowerCase()} data-description={album.description.toLowerCase()} data-category={album.category} data-year={album.year} data-photos={album.photos.length}><div class="featured-cover"><img src={album.photos[0].src} alt={album.photos[0].alt} loading="lazy" /><span>Featured</span></div><div class="featured-copy"><div class="badges"><span>{album.category}</span><span>{album.year}</span><span>{album.photos.length} photos</span></div><h3>{album.title}</h3><p>{album.description || 'A selected collection from the Sihphir Presbyterian Kohhran photo archive.'}</p><button type="button" data-open-album={album.id}>Open Gallery <span>→</span></button></div></article>)}</div></section>}

    <section class="gallery-section archive-section"><div class="section-heading reveal"><div><span>Complete collection</span><h2>Gallery Archive</h2></div><p>Browse church albums by year and category.</p></div><div class="album-grid" id="album-grid" data-album-grid>{archive.map((album, index) => <article class={`album-card reveal reveal-delay-${index % 3 + 1}`} data-album-card data-id={album.id} data-title={album.title.toLowerCase()} data-description={album.description.toLowerCase()} data-category={album.category} data-year={album.year} data-photos={album.photos.length}><button type="button" class="album-cover" data-open-album={album.id} aria-label={`Open ${album.title}`}><img src={album.photos[0].src} alt={album.photos[0].alt} loading="lazy" /><div class="cover-badges"><span>{album.year}</span><span>{album.category}</span></div><strong>{album.photos.length} photos</strong></button><div class="album-body"><h3>{album.title}</h3><p>{album.description || 'Photographs preserved in the church archive.'}</p>{album.date && <small>Updated {formatDate(album.date)}</small>}<button type="button" data-open-album={album.id}>Open Gallery <span>→</span></button></div></article>)}</div></section>

    <section class="gallery-empty" id="gallery-empty" hidden><div aria-hidden="true"><span></span><i></i></div><h2>No albums found</h2><p>Try a different search or clear the selected filters.</p><button type="button" id="gallery-clear">Clear filters</button></section>

    {albums.map((album) => <section class="album-detail" id={`album-${album.id}`} hidden><button type="button" class="back-button" data-close-album>← Back to Gallery</button><div class="detail-hero"><img src={album.photos[0].src} alt={album.photos[0].alt} loading="lazy" /><div class="detail-overlay"><div class="badges"><span>{album.category}</span><span>{album.year}</span><span>{album.photos.length} photos</span></div><h2>{album.title}</h2>{album.description && <p>{album.description}</p>}</div></div><div class="photo-heading"><div><span>Album collection</span><h3>Gallery Photos</h3></div><p>{album.photos.length} photographs</p></div><div class="photo-grid">{album.photos.map((photo, index) => <button type="button" class="photo-card" data-photo data-album={album.id} data-index={index} data-src={photo.src} data-caption={photo.caption} aria-label={`View photo ${index + 1} of ${album.photos.length}`}><img src={photo.src} alt={photo.alt} loading="lazy" /><span>View</span></button>)}</div></section>)}
  </main>

  <dialog class="photo-lightbox" id="photo-lightbox" aria-label="Photo viewer"><div class="lightbox-bar"><p><span id="lightbox-counter"></span><small id="lightbox-caption"></small></p><div><a id="lightbox-download" href="" download>Download</a><button type="button" id="lightbox-zoom" aria-label="Zoom photo">＋</button><button type="button" data-close-lightbox aria-label="Close photo viewer">×</button></div></div><button type="button" class="lightbox-arrow previous" data-lightbox-previous aria-label="Previous photo">‹</button><img src="" alt="" /><button type="button" class="lightbox-arrow next" data-lightbox-next aria-label="Next photo">›</button></dialog>
</BaseLayout>

<script>
  const search=document.querySelector<HTMLInputElement>('#gallery-search'),year=document.querySelector<HTMLSelectElement>('#gallery-year'),category=document.querySelector<HTMLSelectElement>('#gallery-category'),sort=document.querySelector<HTMLSelectElement>('#gallery-sort'),count=document.querySelector<HTMLElement>('#gallery-count'),empty=document.querySelector<HTMLElement>('#gallery-empty');
  function applyFilters(){const query=search?.value.trim().toLowerCase()||'',selectedYear=year?.value||'all',selectedCategory=category?.value||'all';let albumTotal=0,photosTotal=0;document.querySelectorAll<HTMLElement>('[data-album-card]').forEach(card=>{const haystack=`${card.dataset.title} ${card.dataset.description} ${card.dataset.category?.toLowerCase()} ${card.dataset.year}`,show=(!query||haystack.includes(query))&&(selectedYear==='all'||card.dataset.year===selectedYear)&&(selectedCategory==='all'||card.dataset.category===selectedCategory);card.hidden=!show;if(show){albumTotal++;photosTotal+=Number(card.dataset.photos||0);}});document.querySelectorAll<HTMLElement>('[data-album-grid]').forEach(grid=>{[...grid.querySelectorAll<HTMLElement>('[data-album-card]')].sort((a,b)=>{if(sort?.value==='az'||sort?.value==='za'){const result=(a.dataset.title||'').localeCompare(b.dataset.title||'');return sort.value==='za'?-result:result;}if(sort?.value==='photos')return Number(b.dataset.photos)-Number(a.dataset.photos);const result=Number(b.dataset.year)-Number(a.dataset.year);return sort?.value==='oldest'?-result:result;}).forEach(card=>grid.append(card));});document.querySelector<HTMLElement>('#featured-galleries')?.toggleAttribute('hidden',!document.querySelector('#featured-galleries [data-album-card]:not([hidden])'));document.querySelector<HTMLElement>('.archive-section')?.toggleAttribute('hidden',!document.querySelector('.archive-section [data-album-card]:not([hidden])'));if(empty)empty.hidden=albumTotal>0;if(count)count.textContent=`${albumTotal} album${albumTotal===1?'':'s'} · ${photosTotal} photo${photosTotal===1?'':'s'}`;}
  [search,year,category].forEach(control=>control?.addEventListener(control===search?'input':'change',applyFilters));sort?.addEventListener('change',applyFilters);document.querySelector('#gallery-clear')?.addEventListener('click',()=>{if(search)search.value='';if(year)year.value='all';if(category)category.value='all';if(sort)sort.value='newest';applyFilters();search?.focus();});
  document.querySelectorAll<HTMLButtonElement>('[data-open-album]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLElement>('.gallery-toolbar,.gallery-section,.gallery-empty').forEach(item=>item.hidden=true);const detail=document.querySelector<HTMLElement>(`#album-${button.dataset.openAlbum}`);if(detail){detail.hidden=false;detail.scrollIntoView({behavior:'smooth',block:'start'});}}));document.querySelectorAll('[data-close-album]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLElement>('.album-detail').forEach(item=>item.hidden=true);document.querySelector<HTMLElement>('.gallery-toolbar')!.hidden=false;document.querySelectorAll<HTMLElement>('.gallery-section').forEach(item=>item.hidden=false);applyFilters();document.querySelector('.gallery-toolbar')?.scrollIntoView({behavior:'smooth'});}));
  const lightbox=document.querySelector<HTMLDialogElement>('#photo-lightbox'),lightboxImage=lightbox?.querySelector<HTMLImageElement>('img'),counter=document.querySelector('#lightbox-counter'),caption=document.querySelector('#lightbox-caption'),download=document.querySelector<HTMLAnchorElement>('#lightbox-download');let activePhotos:HTMLButtonElement[]=[],activeIndex=0,zoomed=false;
  function showPhoto(index:number){if(!lightboxImage||!activePhotos.length)return;activeIndex=(index+activePhotos.length)%activePhotos.length;const item=activePhotos[activeIndex];lightboxImage.src=item.dataset.src||'';lightboxImage.alt=item.dataset.caption||'';if(counter)counter.textContent=`${activeIndex+1} / ${activePhotos.length}`;if(caption)caption.textContent=item.dataset.caption||'';if(download)download.href=item.dataset.src||'';zoomed=false;lightboxImage.classList.remove('zoomed');}
  document.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach(button=>button.addEventListener('click',()=>{activePhotos=[...document.querySelectorAll<HTMLButtonElement>(`[data-photo][data-album="${button.dataset.album}"]`)];showPhoto(Number(button.dataset.index));lightbox?.showModal();}));
  const move=(direction:number)=>showPhoto(activeIndex+direction);document.querySelector('[data-lightbox-previous]')?.addEventListener('click',()=>move(-1));document.querySelector('[data-lightbox-next]')?.addEventListener('click',()=>move(1));document.querySelector('[data-close-lightbox]')?.addEventListener('click',()=>lightbox?.close());document.querySelector('#lightbox-zoom')?.addEventListener('click',()=>{zoomed=!zoomed;lightboxImage?.classList.toggle('zoomed',zoomed);});lightbox?.addEventListener('click',event=>{if(event.target===lightbox)lightbox.close();});document.addEventListener('keydown',event=>{if(!lightbox?.open)return;if(event.key==='ArrowLeft'){event.preventDefault();move(-1);}if(event.key==='ArrowRight'){event.preventDefault();move(1);}});applyFilters();
</script>

