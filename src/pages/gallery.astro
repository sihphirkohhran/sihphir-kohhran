---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveFilterBar from '../components/ArchiveFilterBar.astro';
import { getEntry } from 'astro:content';
import { getUniqueYears } from '../lib/archive';
import { loadGalleryPhotos, getFallbackGalleryPhotos } from '../lib/gallery';

const categoryRegistry = await getEntry('settings', 'gallery-categories');
const categoryList = categoryRegistry?.data.categories ?? [];

const loaded = await loadGalleryPhotos();
const photos =
  loaded.length > 0
    ? loaded.map((p, i) => ({
        src: p.src,
        alt: p.alt,
        category: p.category,
        year: p.year,
        caption: p.caption,
        id: `gallery-${i}`,
      }))
    : getFallbackGalleryPhotos(18).map((p, i) => ({
        src: p.src,
        alt: p.alt,
        category: categoryList[i % Math.max(categoryList.length, 1)]?.name ?? 'Gallery',
        year: p.year,
        caption: p.caption,
        id: `fallback-${i}`,
      }));

const years = getUniqueYears(photos.map((p) => p.year));
const yearOptions = years.length > 0 ? years : [2026, 2025, 2024];

const categories = ['All', ...categoryList.map((c) => c.name)];
---

<BaseLayout title="Gallery — Sihphir Presbyterian Kohhran" activePage="gallery">

  <div class="bg-navy border-b-2 border-gold px-4 py-8 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]"
      style="background-image: repeating-linear-gradient(45deg, #b8953f 0px, #b8953f 1px, transparent 1px, transparent 28px);">
    </div>
    <div class="relative z-10">
      <p class="font-body text-[0.6rem] tracking-[0.14em] uppercase text-gold-pale/50 mb-2">Sihphir Presbyterian Kohhran</p>
      <h1 class="font-display text-white text-2xl sm:text-3xl font-semibold">Gallery</h1>
      <div class="w-16 h-px bg-gold/40 mx-auto mt-3"></div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 py-8">

    <div class="archive-filters-row reveal">
      <ArchiveFilterBar
        id="gallery-year-filter"
        label="Year"
        options={yearOptions.map((y) => ({ value: String(y), label: String(y) }))}
      />
    </div>

    <div class="flex flex-wrap gap-2 mb-6 reveal" id="gallery-filters">
      {categories.map((cat, i) => (
        <button
          class={`gallery-filter font-body text-[0.65rem] tracking-widest uppercase px-3 py-1.5 rounded border transition-all ${
            i === 0
              ? 'bg-navy text-gold-pale border-navy'
              : 'bg-ivory text-navy border-navy/20 hover:bg-navy hover:text-gold-pale hover:border-navy'
          }`}
          data-filter={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="gallery-grid">
      {photos.map((photo, i) => (
        <div
          class={`gallery-item reveal reveal-delay-${(i % 3) + 1} bg-ivory-dark rounded overflow-hidden cursor-pointer ${
            i % 7 === 0 ? 'col-span-2 sm:col-span-1' : ''
          }`}
          style={i % 5 === 0 ? 'grid-row: span 2' : ''}
          data-category={photo.category}
          data-year={photo.year}
          data-src={photo.src}
          data-caption={photo.caption}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            class="w-full h-full object-cover aspect-square"
            loading="lazy"
            data-lightbox
            data-lightbox-src={photo.src}
            data-lightbox-caption={photo.caption}
            onerror="this.parentElement.innerHTML='<div class=\'w-full aspect-square flex items-center justify-center bg-ivory-dark\'><svg class=\'w-8 h-8 text-gold/20\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\'/><circle cx=\'8.5\' cy=\'8.5\' r=\'1.5\'/><path d=\'m21 15-5-5L5 21\'/></svg></div>'"
          />
        </div>
      ))}
    </div>

    <p id="gallery-empty" class="hidden font-body text-sm text-gray-500 text-center py-8">
      No photos for this year and category.
    </p>

  </div>

</BaseLayout>

<script>
  let activeCategory = 'All';
  let activeYear = 'all';

  const yearSelect = document.getElementById('gallery-year-filter');
  yearSelect?.addEventListener('change', () => {
    activeYear = yearSelect.value;
    applyGalleryFilters();
  });

  document.querySelectorAll('.gallery-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = (btn as HTMLElement).dataset.filter || 'All';
      document.querySelectorAll('.gallery-filter').forEach((b) => {
        b.classList.remove('bg-navy', 'text-gold-pale', 'border-navy');
        b.classList.add('bg-ivory', 'text-navy', 'border-navy/20');
      });
      btn.classList.add('bg-navy', 'text-gold-pale', 'border-navy');
      btn.classList.remove('bg-ivory', 'text-navy', 'border-navy/20');
      applyGalleryFilters();
    });
  });

  function applyGalleryFilters() {
    let visible = 0;
    document.querySelectorAll('#gallery-grid .gallery-item').forEach((item) => {
      const cat = (item as HTMLElement).dataset.category;
      const year = (item as HTMLElement).dataset.year;
      const show =
        (activeCategory === 'All' || cat === activeCategory) &&
        (activeYear === 'all' || year === activeYear);
      (item as HTMLElement).style.display = show ? '' : 'none';
      if (show) visible++;
    });
    const empty = document.getElementById('gallery-empty');
    if (empty) empty.classList.toggle('hidden', visible > 0);
  }

  applyGalleryFilters();
</script>
