---
import YouTubeGallery from '../components/YouTubeGallery.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeKtpInleng from '../components/HomeKtpInleng.astro';
import {buildIssues,selectHomeIssue,isKtpInlengCategory} from '../lib/ktp-inleng';
import QuickLinks from '../components/QuickLinks.astro';
import Highlights from '../components/Highlights.astro';
import ProfileImage from '../components/ProfileImage.astro';
import { getCollection, getEntry } from 'astro:content';
import {
  getWeeklySchedules,
  getMonthlyDuties,
  getKtpInlengDocs,
  getOtherDocuments,
} from '../lib/cms';
import { normalizeHighlights } from '../lib/highlights';
import { renderMarkdown } from '../lib/markdown';
import { selectHomeAlbums } from '../lib/home-gallery-albums';
import HomeGalleryCarousel from '../components/HomeGalleryCarousel.astro';
import { buildHomeDocumentSections } from '../lib/documents';
import { normalizeContact } from '../lib/contact';
import { getPageSettings } from '../lib/page-settings';
import { normalizeNotice, noticeIsActive, sortNotices } from '../lib/notices';
import { isoDate, indianDate, monthKey, monthTitle } from '../lib/notice-periods.js';
import { scheduleIsPublic } from '../lib/schedule-publication.js';
import { getHomepageStatistics } from '../lib/statistics.js';

const heroEntry = await getEntry('settings', 'hero');
const quickLinksEntry = await getEntry('settings', 'quick-links');
const highlightsEntry = await getEntry('settings', 'highlights');
const statsEntry = await getEntry('settings', 'statistics');
const pastorEntry = await getEntry('settings', 'pastor');
const historyEntry = await getEntry('settings', 'history');
const prayerEntry = await getEntry('settings', 'prayer');
const generalEntry = await getEntry('settings', 'general');
const homeEntry = await getEntry('settings', 'home');

const statsSettings = statsEntry?.data ?? {};
const legacyStats = (statsSettings.stats ?? [])
  .filter((stat) => stat.enabled !== false)
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
const stats = getHomepageStatistics(legacyStats, (await getCollection('statistics')).map(entry => entry.data));
const pastor = pastorEntry?.data ?? {};
const history = historyEntry?.data ?? {};
const heroSlides = heroEntry?.data.slides ?? [];
const home = homeEntry?.data ?? {};
const heroContactUrl = String(home.contactButtonUrl || '#contact');
const heroYoutubeUrl = String(home.youtubeButtonUrl || generalEntry?.data.youtube_url || 'https://youtube.com');
const contact = normalizeContact(generalEntry?.data);
const visibility = {
  hero: true, highlights: true, notice_board: true, quick_access: true, prayer_topics: true,
  featured_gallery: true, kohhran_videos: false, featured_documents: true, ktp_inleng: false, featured_committee: true,
  featured_fellowship: true, featured_ministries: true,
  ...(home.visibility ?? {}),
};
const positiveCount = (value: unknown, fallback: number) => {
  const count = Number(value);
  return Number.isFinite(count) && count > 0 ? Math.floor(count) : fallback;
};

const galleryAlbums = selectHomeAlbums(await getCollection('gallery'));

// Historical records remain server-rendered; the homepage filters eligible records in place.
const weeklyRecords = (await getWeeklySchedules()).filter(record => scheduleIsPublic(record));
const monthlyRecords = (await getMonthlyDuties()).filter(record => scheduleIsPublic(record));
const weeklyInitial = weeklyRecords[0];
const monthlyInitial = monthlyRecords[0];
const weeklyBrowse=weeklyRecords.map(record=>({...record,period:isoDate(record.week_start),end:isoDate(record.week_end)})).filter(record=>record.period);
const monthlyBrowse=monthlyRecords.map(record=>({...record,period:monthKey(record.month)})).filter(record=>record.period);
const prayerSettings = prayerEntry?.data ?? {};
const prayerHeading = prayerSettings.heading ?? 'Tawngtai Thupui';
const prayerSubtitle = prayerSettings.subtitle ?? '';
const homeUi=await getPageSettings('home',{hero_caption:'',hero_title:'',hero_subtitle:'',statistics_title:String(statsSettings.title??'Kohhran inchhiarna'),statistics_subtitle:'',notice_title:String(home.noticeHeading??'Notice Board'),notice_subtitle:String(home.noticeSubtitle??''),quick_links_title:'Quick Links',quick_links_subtitle:'',prayer_title:String(prayerSettings.heading??'Tawngtai Thupui'),prayer_subtitle:String(prayerSettings.subtitle??''),contact_title:'Contact',contact_subtitle:'',footer_heading:contact.churchName,footer_description:'Mizoram Presbyterian Kohhran · Presbyterian Church of India'});
const prayerLimit = positiveCount(prayerSettings.max_visible, 4);
const prayerTopics = (prayerSettings.topics ?? [])
  .map((topic, index) => typeof topic === 'string' ? { topic, display_order: index } : { topic: topic.topic, display_order: topic.display_order ?? index })
  .sort((a, b) => a.display_order - b.display_order)
  .slice(0, prayerLimit)
  .map((item) => item.topic);

const docCategoryRegistry = await getEntry('settings', 'document-categories');
const docCategoriesList = docCategoryRegistry?.data.categories ?? [];

const homeIssue = selectHomeIssue(visibility.ktp_inleng === true ? buildIssues(await getCollection('documents'), docCategoriesList.find(c=>c.id==='ktp-inleng')?.name) : [], visibility);

const ktpDocs = await getKtpInlengDocs();
const otherDocs = await getOtherDocuments();

const documentCount = positiveCount(home.documentCount, 3);
const documentCategory = String(home.documentCategory ?? '').trim();
const builtHomeDocuments = buildHomeDocumentSections(
  ktpDocs,
  otherDocs,
  docCategoriesList,
  documentCount,
).filter(section=>section.id!=='ktp-inleng'&&!isKtpInlengCategory(section.category,docCategoriesList.find(c=>c.id==='ktp-inleng')?.name));
const homeDocuments = documentCategory
  ? builtHomeDocuments.filter(
      (section) => section.id === documentCategory || section.category === documentCategory,
    )
  : builtHomeDocuments;

const announcementEntries = (await getCollection('notices'))
  .filter((entry) => entry.id.startsWith('announcements/'))
  .map(normalizeNotice)
  .filter((notice) => noticeIsActive(notice))
  .sort((a, b) => sortNotices(a, b));

const noticeCount = positiveCount(home.noticeCount, 3);
const noticeVisible = home.noticeVisible !== false && visibility.notice_board !== false;
const noticeHeading = homeUi.notice_title || String(home.noticeHeading ?? 'Notice Board');
const noticeSubtitle = homeUi.notice_subtitle || String(home.noticeSubtitle ?? '');
const announcementPeriods = announcementEntries.map(notice=>({...notice,period:isoDate(notice.publishDate).slice(0,7)})).filter(notice=>notice.period);
const announcements = await Promise.all(announcementPeriods.map(async notice=>{
  const {Content}=await notice.entry.render();
  return {id:notice.id,title:notice.title,summary:notice.summary,date:notice.publishDate,period:notice.period,attachments:notice.attachments.filter((file: any)=>typeof file?.url==='string' && /^(https?:\/\/|\/[^\/])/.test(file.url)),Content};
}));
const initialNoticePeriod=announcements[0]?.period??'';
const historyFullHtml = renderMarkdown(history.full ?? '');
const pastorMessageHtml = renderMarkdown(pastor.message ?? '');

type QuickLinkData = {
  label: string;
  description?: string;
  href: string;
  action?: string;
  visible?: boolean;
  enabled?: boolean;
  order?: number;
  icon?: string;
  open_in_new_tab?: boolean;
  new_tab?: boolean;
  target?: string;
};

const quickLinks = ((quickLinksEntry?.data.links ?? []) as QuickLinkData[])
  .filter((link) => link.visible !== false && link.enabled !== false)
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
const highlightItems = normalizeHighlights(
  highlightsEntry?.data.items as Record<string, unknown>[] | undefined,
);
---

<BaseLayout activePage="home">

  <!-- ══════════════════════════════ HERO ══════════════════════════════ -->
  <section class="relative h-[62vw] min-h-[240px] max-h-[480px] overflow-hidden bg-navy" id="hero-section" style={visibility.hero === false ? 'display:none' : undefined}>
    <!-- Slides (replaced by real images in production) -->
    {heroSlides.map((slide, i) => (
      <div
        class={`hero-slide ${i === 0 ? 'active' : ''}`}
        style={`background-image: linear-gradient(to bottom, rgba(10,22,40,0.35) 0%, rgba(10,22,40,0.65) 100%), url('${slide.src}'); background-color: #162844;`}
        data-slide={i}
        data-caption={slide.caption}
      ></div>
    ))}

    <!-- Hero overlay content -->
    <div class="absolute inset-0 flex flex-col justify-end px-5 pb-7 z-10">
      <div class="flex flex-wrap gap-3 mb-3">
        <a href={heroContactUrl}
          class="inline-flex items-center gap-2 rounded border border-gold/20 bg-gold/10 px-4 py-2 text-sm font-semibold text-gold-pale/90 hover:bg-gold/20 hover:text-white transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M22 16.92v3a2 2 0 01-2.18 2 19.78 19.78 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.78 19.78 0 014.18 4.18 2 2 0 016.2 2h3a2 2 0 012 1.72 12.24 12.24 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.24 12.24 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          Contact
        </a>
        <a href={heroYoutubeUrl} target="_blank" rel="noopener"
          class="inline-flex items-center gap-2 rounded border border-gold/20 bg-gold/10 px-4 py-2 text-sm font-semibold text-gold-pale/90 hover:bg-gold/20 hover:text-white transition-all">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon fill="var(--navy)" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
          YouTube
        </a>
      </div>
      {homeUi.hero_caption && <span class="font-body text-gold-pale/60 text-[0.6rem] tracking-widest uppercase">{homeUi.hero_caption}</span>}
      <h2 class="font-display text-white text-2xl sm:text-3xl font-semibold leading-tight mb-2" id="hero-caption" data-fixed-caption={homeUi.hero_title}>
        {homeUi.hero_title || heroSlides[0].caption}
      </h2>
      <p class="font-body text-gold-pale/70 text-sm mb-4">{homeUi.hero_subtitle || 'Sihphir Presbyterian Kohhran'}</p>

      <!-- Slide indicators -->
      <div class="flex gap-2 items-center" id="slide-dots">
        {heroSlides.map((_, i) => (
          <button
            class={`h-0.5 rounded-full transition-all duration-300 cursor-pointer ${i === 0 ? 'w-8 bg-gold' : 'w-5 bg-gold/30'}`}
            data-dot={i}
            aria-label={`Slide ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>

    <!-- Slide counter -->
    <div class="absolute bottom-7 right-5 font-body text-[0.6rem] text-gold-pale/40 tracking-widest z-10" id="slide-counter">
      1 / {heroSlides.length}
    </div>
  </section>

  <div style={visibility.highlights === false ? 'display:none' : 'display:contents'}><Highlights items={highlightItems} /></div>

  <div style={visibility.quick_access === false ? 'display:none' : 'display:contents'}><QuickLinks links={quickLinks} heading={homeUi.quick_links_title} subtitle={homeUi.quick_links_subtitle} /></div>

  <!-- ══════════════════════════════ STATISTICS ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="statistics" style={statsSettings.enabled === false ? 'display:none' : undefined}>
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>{homeUi.statistics_title}</h2>
      </div>
      {homeUi.statistics_subtitle && <p class="font-body text-xs text-gray-500 text-center mb-4">{homeUi.statistics_subtitle}</p>}
      <div class="grid grid-cols-3 gap-3 mb-4">
        {stats.map((stat, i) => (
          <div class={`stat-card reveal reveal-delay-${i + 1}`}>
            <div class="font-display text-gold-light text-3xl sm:text-4xl font-bold leading-none mb-1">{stat.value}</div>
            <div class="font-body text-[0.62rem] text-gold-pale/65 tracking-widest uppercase">{stat.label}</div>
          </div>
        ))}
      </div>
      <div class="flex justify-center">
        <a
          href="/statistics/"
          class="reveal inline-flex items-center justify-center gap-2 rounded bg-navy px-4 py-2.5 font-body text-sm font-semibold tracking-wide text-gold-pale transition-colors hover:bg-navy-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          {statsSettings.dashboard_text ?? 'Click to view detailed Dashboard'}
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ PASTOR ══════════════════════════════ -->
  <section class="bg-ivory py-8 px-4" id="pastor" style={pastor.enabled === false ? 'display:none' : undefined}>
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>{pastor.section_title ?? "Pastor's Message"}</h2>
      </div>
      <div class="reveal bg-navy border border-gold/20 rounded p-5 relative overflow-hidden">
        <!-- Large quote mark watermark -->
        <div class="absolute -top-2 left-2 font-display text-[6rem] text-gold/10 leading-none select-none pointer-events-none">"</div>
        <div class="flex gap-4 items-start relative z-10">
          <div class="flex-shrink-0">
            <div class="w-16 h-16 rounded-full border-2 border-gold/60 overflow-hidden bg-navy-light flex items-center justify-center">
              <ProfileImage src={pastor.photo} alt={pastor.name ?? 'Pastor'} class="w-full h-full object-cover" />
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-display text-gold-light font-semibold text-base mb-0.5">{pastor.name ?? 'Rev. [Pastor Hming]'}</div>
            <div class="font-body text-[0.65rem] text-gold-pale/50 tracking-widest uppercase mb-3">{pastor.title ?? 'Head Pastor · Sihphir Kohhran'}</div>
            {pastor.message_title && <div class="font-display text-gold-pale text-sm mb-2">{pastor.message_title}</div>}
            {pastor.verse && <div class="font-body text-gold/80 text-xs mb-2">{pastor.verse}</div>}
            <div class={`font-body text-gold-pale/75 text-sm leading-relaxed ${pastor.quote_style === 'plain' ? '' : 'italic'}`}>
              {pastor.quote_style !== 'none' && '“'}<Fragment set:html={pastorMessageHtml} />{pastor.quote_style !== 'none' && '”'}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ CHURCH HISTORY ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="history" style={history.enabled === false ? 'display:none' : undefined}>
    <div class="max-w-4xl mx-auto">
      <div class="gold-divider reveal">
        <h2>{history.section_title ?? 'Sihphir Kohhran Chanchin'}</h2>
      </div>
      <div class="reveal grid grid-cols-1 md:grid-cols-2 items-center gap-5 md:gap-8">
        <div class="w-full aspect-[4/3] rounded-md overflow-hidden bg-ivory-dark border border-gold/20">
          <img
            src={history.building_photo ?? '/images/church-building.jpg'}
            alt="Sihphir Presbyterian Kohhran Building"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="min-w-0 py-1 md:py-3">
          <div class="font-body text-xs font-semibold tracking-[0.14em] text-gold-deep uppercase mb-2">Established 1910</div>
          <div class="font-body text-base text-gray-700 leading-relaxed mb-3" id="history-short">
            {history.short}
          </div>
          <button
            id="history-toggle"
            type="button"
            data-destination={history.destination ?? ''}
            aria-expanded="false"
            aria-controls="history-full"
            data-expand-label={history.read_more_text ?? 'Read More →'}
            data-collapse-label="Show Less"
            class="inline-flex font-body text-xs font-semibold tracking-wide text-navy border-b border-gold/70 hover:border-gold transition-colors pb-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
          >
            {history.read_more_text ?? 'Read More →'}
          </button>
        </div>
      </div>
      <div
        class="content-page-body hidden mt-6 mx-auto max-w-3xl font-body text-sm text-gray-700 leading-8 [&_p]:mb-4 [&_ul]:my-4 [&_ol]:my-4 [&_li]:mb-2"
        id="history-full"
        aria-labelledby="history-toggle"
      >
        <Fragment set:html={historyFullHtml} />
        <div class="mt-6 flex justify-end">
          <button
            id="history-collapse-bottom"
            type="button"
            aria-controls="history-full"
            aria-expanded="true"
            class="inline-flex font-body text-xs font-semibold tracking-wide text-navy border-b border-gold/70 hover:border-gold transition-colors pb-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
          >
            Show Less ↑
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ GALLERY ══════════════════════════════ -->
  {visibility.kohhran_videos === true && <YouTubeGallery home channel={generalEntry?.data.youtube_url || heroYoutubeUrl}/>}
  <section class="bg-ivory py-8 px-4" id="gallery" style={visibility.featured_gallery === false ? 'display:none' : undefined}>
    <HomeGalleryCarousel albums={galleryAlbums} />
  </section>

  <!-- ══════════════════════════════ DOCUMENTS ══════════════════════════════ -->
  {homeIssue && <HomeKtpInleng issue={homeIssue} />}
  <section class="bg-cream py-8 px-4" id="documents" style={visibility.featured_documents === false ? 'display:none' : undefined}>
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Documents</h2>
      </div>
      <div class="space-y-4">
        {homeDocuments.map((doc, di) => (
          <div class={`reveal reveal-delay-${(di % 3) + 1} bg-ivory border border-gold/10 rounded overflow-hidden shadow-sm shadow-navy/10 transition-shadow duration-200 hover:shadow-md`}>
            <div class="flex items-center justify-between px-4 py-3 border-b border-gold/10">
              <h3 class="font-body font-bold text-navy text-sm">{doc.category}</h3>
              <span class="font-body text-[0.6rem] text-navy/60 tracking-widest uppercase">{doc.badge}</span>
            </div>
            <div class="px-4 py-2">
              {doc.items.length > 0 ? (
                doc.items.map((item) => (
                  <div class="doc-item">
                    <div class="flex items-center gap-2 min-w-0">
                      <svg class="w-3.5 h-3.5 text-navy/50 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                      <div class="min-w-0">
                        <span class="font-body text-navy text-xs block truncate">{item.name}</span>
                        {item.date && (
                          <span class="font-body text-[0.6rem] text-navy/55 tracking-wide">{item.date}</span>
                        )}
                      </div>
                    </div>
                    <a href={item.url} target="_blank" rel="noopener"
                      class="font-body text-gold text-xs hover:text-gold-light tracking-wide flex items-center gap-1 transition-colors flex-shrink-0 ml-2">
                      PDF ↗
                    </a>
                  </div>
                ))
              ) : (
                <p class="font-body text-xs text-navy/70 py-2 text-center">No documents in this category yet.</p>
              )}
            </div>
            {doc.totalCount > 0 && (
              <div class="px-4 pb-3 pt-1 border-t border-gold/[0.06] text-right">
                <a
                  href={doc.archiveLink}
                  class="font-body text-[0.65rem] tracking-[0.1em] uppercase text-navy/70 hover:text-navy transition-colors"
                >
                  {doc.totalCount > doc.items.length
                    ? `View all ${doc.totalCount} →`
                    : 'View in archive →'}
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
      <div class="mt-3 text-right">
        <a href="/document" class="font-body text-[0.7rem] tracking-[0.1em] uppercase text-navy border-b border-navy/30 hover:border-navy transition-colors">
          View All Documents →
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ NOTICE BOARD ══════════════════════════════ -->
  <section class="bg-ivory py-8 px-4" id="notice-board" style={noticeVisible ? undefined : 'display:none'}>
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>{noticeHeading}</h2>
      </div>
      {noticeSubtitle && <p class="font-body text-xs text-gray-500 text-center -mt-3 mb-5">{noticeSubtitle}</p>}

      <!-- Tabs -->
      <div class="flex border-b-2 border-navy mb-5 overflow-x-auto md:overflow-visible reveal">
        <button class="notice-tab active" data-target="weekly">Hun ruatna</button>
        <button class="notice-tab" data-target="monthly">Thlabi mawhphurtu</button>
        <button class="notice-tab" data-target="notices">Notices</button>
      </div>

      <!-- Each record stays server-rendered; selectors reveal the selected eligible period. -->
      <div id="notice-weekly" class="notice-panel" data-initial={weeklyInitial?.id??''}>
        <div class="notice-period-controls" data-notice-controls="weekly">
          <label>Year <select data-period="year" aria-label="Weekly year"></select></label>
          <label>Month <select data-period="month" aria-label="Weekly month"></select></label>
          <label>Week <select data-period="record" aria-label="Weekly date range"></select></label>
        </div>
        {weeklyBrowse.map(record=>(
          <div class="notice-period-record" data-record-id={record.id} data-period={record.period.slice(0,7)} data-week-start={record.period} data-week-end={record.end} hidden>
            <div class="font-body text-xs text-navy font-semibold tracking-wide mb-3">{indianDate(record.week_start)} — {indianDate(record.week_end)}</div>
            <div class="space-y-3">
              {(record.days??[]).map((day,i)=>(
                <div class={`border-l-2 border-gold bg-white rounded-r px-4 py-3`}>
                  <div class="font-body text-sm font-semibold text-navy tracking-wide uppercase mb-2">{day.day}</div>
                  <div class="space-y-1">
                    {(day.duties??[]).map(duty=>(
                      <div class="grid grid-cols-[minmax(0,0.35fr)_minmax(0,0.65fr)] gap-3 items-start font-body text-sm border-b border-ivory-dark pb-1 last:border-0 last:pb-0">
                        <span class="notice-duty-label min-w-0 break-words">{duty.role||duty.title}</span>
                        <span class="min-w-0 font-medium text-navy text-left break-words">{duty.name||duty.person_responsible}</span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
        <p class="notice-period-empty" hidden>No publicly available weekly schedules.</p>
      </div>

      <div id="notice-monthly" class="notice-panel" data-initial={monthlyInitial?.id??''} style="display:none">
        <div class="notice-period-controls" data-notice-controls="monthly">
          <label>Year <select data-period="year" aria-label="Monthly year"></select></label>
          <label>Month <select data-period="month" aria-label="Monthly month"></select></label>
        </div>
        {monthlyBrowse.map(record=>(
          <div class="notice-period-record" data-record-id={record.id} data-period={record.period} hidden>
            <div class="font-body text-sm text-navy font-semibold tracking-wide mb-3">{monthTitle(record.period)}</div>
            <div class="space-y-3">
              {(record.sections??[]).map(section=>(
                <div class="bg-white border border-gold/20 border-l-2 border-l-gold rounded-r overflow-hidden">
                  <div class="bg-cream px-4 py-2 border-b border-navy/10">
                    <span class="font-display text-navy font-semibold text-sm">{section.title}</span>
                  </div>
                  <div class="px-4 py-2 space-y-1">
                    {(section.duties??[]).map(duty=>(
                      <div class="grid grid-cols-[minmax(0,0.35fr)_minmax(0,0.65fr)] gap-3 items-start font-body text-sm text-navy border-b border-navy/10 pb-1.5 last:border-0 last:pb-0">
                        <span class="notice-duty-label min-w-0 break-words">{duty.role}</span>
                        <span class="min-w-0 text-navy text-left break-words">{duty.name}</span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
        <p class="notice-period-empty" hidden>No publicly available monthly rosters.</p>
      </div>

      <div id="notice-notices" class="notice-panel" data-initial={initialNoticePeriod} style="display:none">
        <div class="notice-period-controls" data-notice-controls="notices">
          <label>Year <select data-period="year" aria-label="Notice year"></select></label>
          <label>Month <select data-period="month" aria-label="Notice month"></select></label>
        </div>
        {announcements.map((notice,i)=>(
          <article class={`notice-period-record notice-accordion-card border-l-2 ${i===0?'border-gold':'border-gold/40'} bg-white rounded-r mb-3`} data-period={notice.period} hidden>
            <h3 class="m-0">
              <button type="button" class="notice-accordion-toggle" aria-expanded="false" aria-controls={`notice-accordion-body-${i}`}>
                <span class="notice-accordion-heading">
                  <span class="font-display text-navy font-semibold text-sm">{notice.title}</span>
                  {notice.summary && <span class="notice-accordion-summary font-body text-xs text-gray-700">{notice.summary}</span>}
                  <span class="notice-accordion-read-more font-body text-xs">Read More</span>
                </span>
                <svg class="notice-accordion-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </h3>
            <div id={`notice-accordion-body-${i}`} class="notice-accordion-body" hidden>
              <div class="content-page-body font-body text-xs text-gray-700"><notice.Content /></div>
              {notice.attachments.length>0 && (
                <div class="notice-accordion-attachments">
                  <div class="font-body text-xs font-semibold text-navy">Attachments</div>
                  {notice.attachments.map((file:any)=>(
                    <a href={file.url} target="_blank" rel="noopener noreferrer" class="font-body text-sm text-navy underline underline-offset-2">{file.title||file.name||'View attachment'}</a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
        <button type="button" class="notice-accordion-show-more" hidden aria-controls="notice-notices">Show More</button>
        <p class="notice-period-empty" hidden>No publicly available notices for this period.</p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ PRAYER TOPICS ══════════════════════════════ -->
  <section class="bg-navy py-8 px-4" id="prayer" style={prayerSettings.enabled === false || visibility.prayer_topics === false ? 'display:none' : undefined}>
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center gap-3 mb-5 reveal">
        <div class="flex-1 h-px bg-gradient-to-r from-transparent to-gold/35"></div>
        <div class="text-center"><h2 class="font-display text-gold-light text-xl font-semibold whitespace-nowrap">{homeUi.prayer_title}</h2>{homeUi.prayer_subtitle && <p class="font-body text-gold-pale/55 text-xs mt-1">{homeUi.prayer_subtitle}</p>}</div>
        <div class="flex-1 h-px bg-gradient-to-l from-transparent to-gold/35"></div>
      </div>
      <div class="space-y-3">
        {prayerTopics.map((topic, i) => (
          <div class={`reveal reveal-delay-${(i % 4) + 1} flex gap-3 items-start border-b border-gold/10 pb-3 last:border-0`}>
            <span class="font-display text-gold/50 text-xl leading-tight flex-shrink-0 w-5">{i + 1}</span>
            <p class="font-body text-gold-pale/75 text-sm italic leading-relaxed">{topic}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SECRETARY CONTACT ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="contact" style={contact.showHomeContact ? undefined : 'display:none'}>
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>{homeUi.contact_title}</h2>
      </div>
      {homeUi.contact_subtitle && <p class="font-body text-xs text-gray-500 text-center mb-4">{homeUi.contact_subtitle}</p>}
      <div class="reveal bg-navy border border-gold/20 rounded p-5">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-full border border-gold/40 bg-navy-light flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-gold/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div>
            <div class="font-body font-bold text-gold-light text-base">{contact.secretaryName}</div>
            <div class="font-body text-[0.65rem] text-gold-pale/50 tracking-widest uppercase">Kohhran Secretary</div>
          </div>
        </div>
        <div class="space-y-2 border-t border-gold/10 pt-3">
          <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="flex items-center gap-3 text-gold-pale/70 hover:text-gold-light transition-colors group">
            <svg class="w-4 h-4 text-gold/60 group-hover:text-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span class="font-body text-sm">{contact.phone}</span>
          </a>
          <a href={`mailto:${contact.email}`} class="flex items-center gap-3 text-gold-pale/70 hover:text-gold-light transition-colors group">
            <svg class="w-4 h-4 text-gold/60 group-hover:text-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span class="font-body text-sm">{contact.email}</span>
          </a>
          <div class="flex items-center gap-3 text-gold-pale/70">
            <svg class="w-4 h-4 text-gold/60 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="font-body text-sm">{contact.address}</span>
          </div>
          {contact.mobile_number && contact.mobile_number !== contact.phone && <a href={`tel:${contact.mobile_number.replace(/\s/g, '')}`} class="flex items-center gap-3 text-gold-pale/70 hover:text-gold-light transition-colors"><span class="w-4 text-center text-gold/60">M</span><span class="font-body text-sm">{contact.mobile_number}</span></a>}
          {contact.whatsapp && <a href={`https://wa.me/${contact.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener" class="flex items-center gap-3 text-gold-pale/70 hover:text-gold-light transition-colors"><span class="w-4 text-center text-gold/60">W</span><span class="font-body text-sm">{contact.whatsapp}</span></a>}
          {contact.office_hours && <div class="flex items-center gap-3 text-gold-pale/70"><span class="w-4 text-center text-gold/60">◷</span><span class="font-body text-sm">{contact.office_hours}</span></div>}
          {contact.website_url && <a href={contact.website_url} target="_blank" rel="noopener" class="flex items-center gap-3 text-gold-pale/70 hover:text-gold-light transition-colors"><span class="w-4 text-center text-gold/60">↗</span><span class="font-body text-sm">{contact.website_url}</span></a>}
        </div>
        {contact.google_maps_embed_url && <iframe src={contact.google_maps_embed_url} title={`${contact.churchName} map`} class="w-full h-48 mt-4 rounded border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  #notice-board .notice-period-controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0 0 16px}
  #notice-board .notice-period-controls label{display:grid;gap:5px;min-width:0;font-family:Poppins,sans-serif;font-size:12px;font-weight:600;color:#172941}
  #notice-board .notice-period-controls select{box-sizing:border-box;min-width:0;width:100%;height:40px;padding:7px 9px;border:1px solid rgba(23,41,65,.2);border-radius:6px;background:#fff;color:#172941;font:inherit;font-weight:500}
  #notice-board .notice-period-controls select:focus-visible{outline:2px solid #b8953f;outline-offset:2px}
  #notice-board .notice-period-record[hidden],#notice-board .notice-period-empty[hidden]{display:none!important}
  #notice-board .notice-duty-label{font-size:inherit;font-weight:600;color:#172941;overflow-wrap:anywhere}
  #notice-board .notice-accordion-card{overflow:hidden}
  #notice-board .notice-accordion-toggle{display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;padding:13px 15px;text-align:left;color:#172941;border:0;background:transparent;cursor:pointer}
  #notice-board .notice-accordion-toggle:focus-visible,#notice-board .notice-accordion-show-more:focus-visible{outline:2px solid #b8953f;outline-offset:-3px}
  #notice-board .notice-accordion-heading{display:flex;flex-direction:column;gap:5px;min-width:0;overflow-wrap:anywhere}
  #notice-board .notice-accordion-read-more{color:#98752e;font-weight:600}
  #notice-board .notice-accordion-chevron{flex:none;color:#98752e;transition:transform .2s ease}
  #notice-board .notice-accordion-toggle[aria-expanded="true"] .notice-accordion-chevron{transform:rotate(180deg)}
  #notice-board .notice-accordion-toggle[aria-expanded="true"] .notice-accordion-read-more{font-size:0}
  #notice-board .notice-accordion-toggle[aria-expanded="true"] .notice-accordion-read-more::after{content:'Show Less';font-size:12px}
  #notice-board .notice-accordion-body{padding:0 15px 15px;border-top:1px solid rgba(23,41,65,.1);overflow-wrap:anywhere}
  #notice-board .notice-accordion-body[hidden],#notice-board .notice-accordion-show-more[hidden]{display:none!important}
  #notice-board .notice-accordion-body .content-page-body{padding-top:12px}
  #notice-board .notice-accordion-attachments{display:flex;flex-direction:column;gap:7px;margin-top:12px;padding-top:12px;border-top:1px solid rgba(23,41,65,.12)}
  #notice-board .notice-accordion-show-more{display:block;margin:10px auto 14px;padding:9px 18px;border:1px solid rgba(23,41,65,.2);border-radius:6px;background:#fff;color:#172941;font-family:Poppins,sans-serif;font-size:12px;font-weight:600;cursor:pointer}
  @media(prefers-reduced-motion:reduce){#notice-board .notice-accordion-chevron{transition:none}}
  #notice-board .notice-period-empty{border:1px solid rgba(184,149,63,.2);border-radius:5px;background:#fff;padding:14px;color:#52627a;font-size:13px}
  @media(max-width:480px){#notice-board .notice-period-controls{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}#notice-board .notice-period-controls label:last-child:nth-child(3){grid-column:1/-1}#notice-board .notice-period-record{min-width:0}#notice-board .notice-period-record .grid{gap:8px}}
</style>

<script>
  import { selectWeekly, selectMonthly } from '../lib/schedule-publication.js';
  // ── HERO SLIDESHOW ──
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('[data-dot]');
  const caption = document.getElementById('hero-caption');
  const counter = document.getElementById('slide-counter');
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    slides[current].classList.remove('active');
    dots[current].classList.replace('w-8', 'w-5');
    dots[current].classList.replace('bg-gold', 'bg-gold/30');
    current = index;
    slides[current].classList.add('active');
    dots[current].classList.replace('w-5', 'w-8');
    dots[current].classList.replace('bg-gold/30', 'bg-gold');
    if (caption) caption.textContent = caption.dataset.fixedCaption || slides[current].getAttribute('data-caption') || '';
    if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
  }

  function next() { goTo((current + 1) % slides.length); }

  function startTimer() {
    clearInterval(timer);
    timer = setInterval(next, 4500);
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      goTo(parseInt(dot.getAttribute('data-dot') || '0'));
      startTimer();
    });
  });

  startTimer();

  // ── HISTORY READ MORE ──
  const btn = document.getElementById('history-toggle');
  const full = document.getElementById('history-full');
  const bottomCollapse = document.getElementById('history-collapse-bottom');
  let expanded = false;

  function setHistoryExpanded(nextExpanded: boolean) {
    expanded = nextExpanded;
    full?.classList.toggle('hidden', !expanded);
    btn?.setAttribute('aria-expanded', String(expanded));
    if (btn instanceof HTMLButtonElement) {
      btn.textContent = expanded
        ? (btn.dataset.collapseLabel || 'Show Less')
        : (btn.dataset.expandLabel || 'Read More →');
    }
    bottomCollapse?.setAttribute('aria-expanded', String(expanded));
  }

  btn?.addEventListener('click', () => {
    if (!expanded && btn instanceof HTMLButtonElement && btn.dataset.destination) {
      window.location.href = btn.dataset.destination;
      return;
    }
    setHistoryExpanded(!expanded);
  });

  bottomCollapse?.addEventListener('click', () => {
    setHistoryExpanded(false);
    const historyHeading = document.querySelector('#history .gold-divider');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    historyHeading?.scrollIntoView({
      behavior: prefersReducedMotion ? 'auto' : 'smooth',
      block: 'start',
    });
  });

  // The first Notice Board panel is visible by default; the other panels retain their tab state.

  // Native cascading selectors use the actual eligible, server-rendered records.
  document.querySelectorAll<HTMLElement>('#notice-board .notice-panel').forEach(panel=>{
    const records=Array.from(panel.querySelectorAll<HTMLElement>('.notice-period-record'));
    const year=panel.querySelector<HTMLSelectElement>('[data-period="year"]');
    const month=panel.querySelector<HTMLSelectElement>('[data-period="month"]');
    const week=panel.querySelector<HTMLSelectElement>('[data-period="record"]');
    const empty=panel.querySelector<HTMLElement>('.notice-period-empty');
    // The Notices accordion is scoped to this panel; other schedule tabs are untouched.
    const isNotices=panel.id==='notice-notices';
    const showMore=isNotices?panel.querySelector<HTMLButtonElement>('.notice-accordion-show-more'):null;
    const pageSize=5;
    let shownLimit=pageSize;
    const closeNotices=()=>{
      if(!isNotices)return;
      panel.querySelectorAll<HTMLButtonElement>('.notice-accordion-toggle').forEach(button=>button.setAttribute('aria-expanded','false'));
      panel.querySelectorAll<HTMLElement>('.notice-accordion-body').forEach(body=>{body.hidden=true;});
    };
    const limitNotices=()=>{
      if(!isNotices)return;
      const eligible=records.filter(record=>record.dataset.period===year?.value+'-'+month?.value);
      eligible.forEach((record,index)=>{record.hidden=index>=shownLimit;});
      if(showMore){showMore.hidden=eligible.length<=shownLimit;showMore.textContent='Show More';}
    };
    if(isNotices){
      panel.addEventListener('click',event=>{
        const button=(event.target as Element).closest<HTMLButtonElement>('.notice-accordion-toggle');
        if(!button||!panel.contains(button))return;
        const wasExpanded=button.getAttribute('aria-expanded')==='true';
        closeNotices();
        if(!wasExpanded){
          button.setAttribute('aria-expanded','true');
          const body=document.getElementById(button.getAttribute('aria-controls')||'');
          if(body&&panel.contains(body))body.hidden=false;
        }
      });
      showMore?.addEventListener('click',()=>{shownLimit+=pageSize;limitNotices();});
    }

    if(!year||!month)return;
    const key=(record:HTMLElement)=>record.dataset.period||'';
    const options=(select:HTMLSelectElement,values:string[],label:(value:string)=>string)=>{
      const previous=select.value;
      select.replaceChildren(...values.map(value=>{const option=document.createElement('option');option.value=value;option.textContent=label(value);return option;}));
      if(values.includes(previous))select.value=previous;
      select.disabled=!values.length;
    };
    const months=['January','February','March','April','May','June','July','August','September','October','November','December'];
    const monthName=(value:string)=>months[Number(value)-1]||value;
    const years=Array.from(new Set(records.map(record=>key(record).slice(0,4)))).sort().reverse();
    options(year,years,value=>value);
    const chosenPeriod=panel.id==='notice-weekly'
      ? selectWeekly(records.map(record=>({id:record.dataset.recordId,week_start:record.dataset.weekStart,week_end:record.dataset.weekEnd})))
      :panel.id==='notice-monthly'
        ?selectMonthly(records.map(record=>({id:record.dataset.period,month:record.dataset.period})))
        :null;
    const initial=chosenPeriod
      ?records.find(record=>panel.id==='notice-weekly'?record.dataset.recordId===chosenPeriod.id:record.dataset.period===chosenPeriod.id)
      :records.find(record=>record.dataset.recordId===panel.dataset.initial||(!record.dataset.recordId&&key(record)===panel.dataset.initial));
    if(initial)year.value=key(initial).slice(0,4);
    const update=(level:'year'|'month'|'week',preferInitial=false)=>{
      const availableMonths=Array.from(new Set(records.filter(record=>key(record).startsWith(year.value+'-')).map(record=>key(record).slice(5,7)))).sort().reverse();
      const oldMonth=month.value;
      options(month,availableMonths,monthName);
      if(level==='year'||!availableMonths.includes(oldMonth))month.value=availableMonths[0]||'';
      if(preferInitial&&initial&&key(initial).slice(0,4)===year.value)month.value=key(initial).slice(5,7);
      const visible=records.filter(record=>key(record)===year.value+'-'+month.value);
      if(week){
        const sorted=[...visible].sort((a,b)=>(b.dataset.weekStart||'').localeCompare(a.dataset.weekStart||'')||(a.dataset.recordId||'').localeCompare(b.dataset.recordId||''));
        options(week,sorted.map(record=>record.dataset.recordId||''),id=>{
          const record=sorted.find(item=>item.dataset.recordId===id);
          const indian=(value:string)=>/^\d{4}-\d{2}-\d{2}$/.test(value)?value.slice(8)+'/'+value.slice(5,7)+'/'+value.slice(0,4):value;
          return record?indian(record.dataset.weekStart||'')+' — '+indian(record.dataset.weekEnd||''):id;
        });
        if(preferInitial&&initial&&sorted.includes(initial))week.value=initial.dataset.recordId||'';
        if(level==='year'||level==='month')if(!(preferInitial&&initial&&sorted.includes(initial)))week.value=sorted[0]?.dataset.recordId||'';
        records.forEach(record=>{record.hidden=record.dataset.recordId!==week.value;});
      }else if(panel.id==='notice-monthly'){
        const chosen=preferInitial&&initial&&visible.includes(initial)?initial:visible[0];
        records.forEach(record=>{record.hidden=record!==chosen;});
      }else{
        records.forEach(record=>{record.hidden=!visible.includes(record);});
        if(isNotices)limitNotices();
      }
      if(empty)empty.hidden=records.some(record=>!record.hidden);
    };
    year.addEventListener('change',()=>{closeNotices();shownLimit=pageSize;update('year');});
    month.addEventListener('change',()=>{closeNotices();shownLimit=pageSize;update('month');});
    week?.addEventListener('change',()=>update('week'));
    update('year',true);
  });

  // ── QUICK LINKS (deep link to notice board tabs) ──
  function activateNoticeTab(target: string) {
    if(target!=='notices'){
      document.querySelectorAll<HTMLButtonElement>('#notice-notices .notice-accordion-toggle').forEach(button=>button.setAttribute('aria-expanded','false'));
      document.querySelectorAll<HTMLElement>('#notice-notices .notice-accordion-body').forEach(body=>{body.hidden=true;});
    }
    document.querySelectorAll('.notice-tab').forEach((t) => {
      t.classList.toggle('active', (t as HTMLElement).dataset.target === target);
    });
    document.querySelectorAll('.notice-panel').forEach((p) => {
      (p as HTMLElement).style.display = 'none';
    });
    const panel = document.getElementById(`notice-${target}`);
    if (panel) panel.style.display = 'block';
  }

  document.querySelectorAll('[data-quick-action]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const action = (link as HTMLElement).dataset.quickAction;
      const tabTargets: Record<string, string> = {
        'tab-weekly': 'weekly',
        'tab-monthly': 'monthly',
        'tab-notices': 'notices',
      };
      const target = action ? tabTargets[action] : undefined;
      if (target) {
        e.preventDefault();
        const board = document.getElementById('notice-board');
        board?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        setTimeout(() => activateNoticeTab(target), 400);
      }
    });
  });

  if (location.hash === '#notice-board') {
    const params = new URLSearchParams(location.search);
    const tab = params.get('tab');
    if (tab === 'weekly' || tab === 'monthly' || tab === 'notices') {
      setTimeout(() => activateNoticeTab(tab), 300);
    }
  }
</script>
