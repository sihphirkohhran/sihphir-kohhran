---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import {
  getWeeklySchedules,
  getMonthlyDuties,
  getAnnouncements,
  getKtpInlengDocs,
  getOtherDocuments,
} from '../lib/cms';

const heroEntry = await getEntry('settings', 'hero');
const statsEntry = await getEntry('settings', 'statistics');
const pastorEntry = await getEntry('settings', 'pastor');
const historyEntry = await getEntry('settings', 'history');
const prayerEntry = await getEntry('settings', 'prayer');
const generalEntry = await getEntry('settings', 'general');

const stats = statsEntry?.data.stats ?? [];
const heroSlides = heroEntry?.data.slides ?? [];

const galleryPhotos = [
  { src: '/images/gallery-1.jpg', alt: 'Church event 1' },
  { src: '/images/gallery-2.jpg', alt: 'Church event 2' },
  { src: '/images/gallery-3.jpg', alt: 'Church event 3' },
  { src: '/images/gallery-4.jpg', alt: 'Church event 4' },
  { src: '/images/gallery-5.jpg', alt: 'Church event 5' },
  { src: '/images/gallery-6.jpg', alt: 'Church event 6' },
];

const latestWeekly = getWeeklySchedules()[0];
const weeklySchedule = latestWeekly
  ? {
      date: `${latestWeekly.week_start} — ${latestWeekly.week_end}`,
      days: (latestWeekly.days as { day: string; duties: { role: string; name: string }[] }[]) ?? [],
    }
  : { date: '', days: [] };

const latestMonthly = getMonthlyDuties()[0];
const monthlyDuties = latestMonthly
  ? {
      month: String(latestMonthly.month ?? ''),
      sections: (latestMonthly.sections as {
        title: string;
        duties: { role: string; name: string }[];
      }[]) ?? [],
    }
  : { month: '', sections: [] };

const prayerTopics = prayerEntry?.data.topics ?? [];

const ktpDocs = getKtpInlengDocs();
const otherDocs = getOtherDocuments();

const documents = [
  {
    category: 'KTP Inleng',
    badge: 'Weekly · Archived',
    items: ktpDocs.map((d) => ({
      name: String(d.name),
      url: String(d.pdf_url),
    })),
    showPagination: ktpDocs.length > 3,
  },
  {
    category: 'Church Year Book',
    badge: 'Annual',
    items: otherDocs
      .filter((d) => d.category === 'Church Year Book')
      .map((d) => ({ name: String(d.name), url: String(d.pdf_url) })),
    showPagination: false,
  },
  {
    category: 'Finance Report',
    badge: 'Annual',
    items: otherDocs
      .filter((d) => d.category === 'Finance Report')
      .map((d) => ({ name: String(d.name), url: String(d.pdf_url) })),
    showPagination: false,
  },
  {
    category: 'Others',
    badge: 'Handbooks & Miscellaneous',
    items: otherDocs
      .filter((d) => d.category === 'Others')
      .map((d) => ({ name: String(d.name), url: String(d.pdf_url) })),
    showPagination: false,
  },
].filter((doc) => doc.items.length > 0 || doc.category === 'KTP Inleng');

const announcements = getAnnouncements();
const lookerUrl = generalEntry?.data.looker_url ?? 'https://lookerstudio.google.com';
---

<BaseLayout activePage="home">

  <!-- ══════════════════════════════ HERO ══════════════════════════════ -->
  <section class="relative h-[62vw] min-h-[240px] max-h-[480px] overflow-hidden bg-navy" id="hero-section">
    <!-- Slides (replaced by real images in production) -->
    {heroSlides.map((slide, i) => (
      <div
        class={`hero-slide ${i === 0 ? 'active' : ''}`}
        style={`background-image: linear-gradient(to bottom, rgba(10,22,40,0.35) 0%, rgba(10,22,40,0.65) 100%), url('${slide.src}'); background-color: #162844;`}
        data-slide={i}
        data-caption={slide.caption}
      ></div>
    ))}

    <!-- Hero overlay content -->
    <div class="absolute inset-0 flex flex-col justify-end px-5 pb-7 z-10">
      <div class="inline-block bg-gold/20 border border-gold/35 text-gold-pale/90 text-[0.6rem] tracking-[0.15em] uppercase font-body px-3 py-1 mb-3 w-fit">
        Lak Tur Ula — Welcome
      </div>
      <h2 class="font-display text-white text-2xl sm:text-3xl font-semibold leading-tight mb-2" id="hero-caption">
        {heroSlides[0].caption}
      </h2>
      <p class="font-body text-gold-pale/70 text-sm mb-4">Sihphir, Aizawl District, Mizoram</p>

      <!-- Slide indicators -->
      <div class="flex gap-2 items-center" id="slide-dots">
        {heroSlides.map((_, i) => (
          <button
            class={`h-0.5 rounded-full transition-all duration-300 cursor-pointer ${i === 0 ? 'w-8 bg-gold' : 'w-5 bg-gold/30'}`}
            data-dot={i}
            aria-label={`Slide ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>

    <!-- Slide counter -->
    <div class="absolute bottom-7 right-5 font-body text-[0.6rem] text-gold-pale/40 tracking-widest z-10" id="slide-counter">
      1 / {heroSlides.length}
    </div>
  </section>

  <!-- ══════════════════════════════ STATISTICS ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="statistics">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Statistics at a Glance</h2>
      </div>
      <div class="grid grid-cols-3 gap-3 mb-4">
        {stats.map((stat, i) => (
          <div class={`stat-card reveal reveal-delay-${i + 1}`}>
            <div class="font-display text-gold-light text-3xl sm:text-4xl font-bold leading-none mb-1">{stat.value}</div>
            <div class="font-body text-[0.62rem] text-gold-pale/65 tracking-widest uppercase">{stat.label}</div>
          </div>
        ))}
      </div>
      <a
        href={lookerUrl}
        target="_blank"
        rel="noopener"
        class="reveal flex items-center justify-center gap-2 font-body text-xs text-navy border border-navy/20 hover:border-navy/50 hover:bg-navy hover:text-gold-pale py-2.5 px-4 rounded transition-all tracking-wide"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        Detailed Dashboard — Looker Studio →
      </a>
    </div>
  </section>

  <!-- ══════════════════════════════ PASTOR ══════════════════════════════ -->
  <section class="bg-ivory py-8 px-4" id="pastor">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Pastor's Message</h2>
      </div>
      <div class="reveal bg-navy border border-gold/20 rounded p-5 relative overflow-hidden">
        <!-- Large quote mark watermark -->
        <div class="absolute -top-2 left-2 font-display text-[6rem] text-gold/10 leading-none select-none pointer-events-none">"</div>
        <div class="flex gap-4 items-start relative z-10">
          <div class="flex-shrink-0">
            <div class="w-16 h-16 rounded-full border-2 border-gold/60 overflow-hidden bg-navy-light flex items-center justify-center">
              <img src={pastorEntry?.data.photo ?? '/images/pastor.jpg'} alt="Pastor" class="w-full h-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
              <span class="w-full h-full items-center justify-center hidden font-display text-gold-pale text-xl">✝</span>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-display text-gold-light font-semibold text-base mb-0.5">{pastorEntry?.data.name ?? 'Rev. [Pastor Hming]'}</div>
            <div class="font-body text-[0.65rem] text-gold-pale/50 tracking-widest uppercase mb-3">{pastorEntry?.data.title ?? 'Head Pastor · Sihphir Kohhran'}</div>
            <div class="font-body text-gold-pale/75 text-sm italic leading-relaxed">
              "{pastorEntry?.data.message ?? ''}"
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ CHURCH HISTORY ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="history">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Kohhran History</h2>
      </div>
      <div class="reveal border-l-4 border-gold rounded-r bg-ivory pl-5 pr-4 py-4">
        <!-- Church building photo -->
        <div class="w-full aspect-video rounded overflow-hidden mb-4 bg-ivory-dark border border-gold/20 flex items-center justify-center">
          <img src={historyEntry?.data.building_photo ?? '/images/church-building.jpg'} alt="Sihphir Presbyterian Kohhran Building"
            class="w-full h-full object-cover"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
          <span class="hidden font-body text-xs text-gold/40 tracking-wide">Church Building Photo</span>
        </div>

        <div class="font-body text-sm text-gray-700 leading-relaxed mb-3" id="history-short">
          {historyEntry?.data.short}
        </div>
        <div class="font-body text-sm text-gray-700 leading-relaxed mb-4 hidden" id="history-full">
          {(historyEntry?.data.full ?? '').split('\n\n').map((paragraph) => (
            <p class="mb-2">{paragraph}</p>
          ))}
        </div>
        <button
          id="history-toggle"
          class="font-body text-[0.7rem] tracking-[0.1em] uppercase text-navy border-b border-navy/50 hover:border-navy transition-colors pb-0.5"
        >
          Read More →
        </button>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ GALLERY ══════════════════════════════ -->
  <section class="bg-ivory py-8 px-4" id="gallery">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Gallery</h2>
      </div>
      <div class="grid grid-cols-3 gap-2 mb-4">
        {galleryPhotos.map((photo, i) => (
          <div
            class={`gallery-item reveal reveal-delay-${(i % 3) + 1} bg-ivory-dark ${i === 0 ? 'col-span-2 row-span-2' : ''}`}
            style={i === 0 ? 'aspect-ratio:2/1' : 'aspect-ratio:1'}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-full object-cover cursor-pointer"
              data-lightbox
              loading="lazy"
              onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center\'><svg class=\'w-6 h-6 text-gold/30\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\'/><circle cx=\'8.5\' cy=\'8.5\' r=\'1.5\'/><path d=\'m21 15-5-5L5 21\'/></svg></div>'"
            />
          </div>
        ))}
      </div>
      <a href="/gallery"
        class="reveal block text-center font-body text-[0.7rem] tracking-[0.1em] uppercase text-navy border border-navy/20 hover:bg-navy hover:text-gold-pale py-2.5 transition-all rounded">
        View Full Gallery →
      </a>
    </div>
  </section>

  <!-- ══════════════════════════════ DOCUMENTS ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="documents">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Documents</h2>
      </div>
      <div class="space-y-4">
        {documents.map((doc, di) => (
          <div class={`reveal reveal-delay-${(di % 3) + 1} bg-navy border border-gold/20 rounded`}>
            <div class="flex items-center justify-between px-4 py-3 border-b border-gold/10">
              <h3 class="font-display text-gold-light font-semibold text-sm">{doc.category}</h3>
              <span class="font-body text-[0.6rem] text-gold-pale/50 tracking-widest uppercase">{doc.badge}</span>
            </div>
            <div class="px-4 py-2">
              {doc.items.map(item => (
                <div class="doc-item">
                  <div class="flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-gold/50 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    <span class="font-body text-gold-pale/75 text-xs">{item.name}</span>
                  </div>
                  <a href={item.url} target="_blank" rel="noopener"
                    class="font-body text-gold text-xs hover:text-gold-light tracking-wide flex items-center gap-1 transition-colors">
                    PDF ↗
                  </a>
                </div>
              ))}
              {doc.showPagination && (
                <div class="pagination py-2">
                  <button class="page-btn active">1</button>
                  <button class="page-btn">2</button>
                  <button class="page-btn">3</button>
                  <button class="page-btn">···</button>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
      <div class="mt-3 text-right">
        <a href="/document" class="font-body text-[0.7rem] tracking-[0.1em] uppercase text-navy border-b border-navy/30 hover:border-navy transition-colors">
          View All Documents →
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ NOTICE BOARD ══════════════════════════════ -->
  <section class="bg-ivory py-8 px-4" id="notice-board">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Notice Board</h2>
      </div>

      <!-- Tabs -->
      <div class="flex border-b-2 border-navy mb-5 overflow-x-auto reveal">
        <button class="notice-tab active" data-target="weekly">Weekly Schedule</button>
        <button class="notice-tab" data-target="monthly">Monthly Duties</button>
        <button class="notice-tab" data-target="notices">Notices</button>
      </div>

      <!-- Weekly Schedule Panel -->
      <div id="notice-weekly" class="notice-panel">
        <div class="flex items-center justify-between mb-3">
          <span class="font-body text-xs text-gray-500 tracking-wide">Week of: {weeklySchedule.date}</span>
        </div>
        <div class="space-y-3">
          {weeklySchedule.days.map((day, i) => (
            <div class={`reveal reveal-delay-${i + 1} border-l-2 border-gold bg-white rounded-r px-4 py-3`}>
              <div class="font-body text-[0.65rem] text-gray-400 tracking-widest uppercase mb-2">{day.day}</div>
              <div class="space-y-1">
                {day.duties.map(duty => (
                  <div class="flex justify-between font-body text-sm text-gray-700 border-b border-ivory-dark pb-1 last:border-0 last:pb-0">
                    <span class="text-gray-400 text-xs">{duty.role}</span>
                    <span class="font-medium text-navy text-right">{duty.name}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="pagination mt-4">
          <button class="page-btn active">1</button>
          <button class="page-btn">2</button>
          <button class="page-btn">3</button>
        </div>
      </div>

      <!-- Monthly Duties Panel -->
      <div id="notice-monthly" class="notice-panel hidden" style="display:none">
        <div class="font-body text-xs text-gray-400 tracking-wide mb-3">{monthlyDuties.month}</div>
        <div class="space-y-3">
          {monthlyDuties.sections.map((section, i) => (
            <div class="bg-navy border border-gold/15 rounded overflow-hidden">
              <div class="bg-navy-light px-4 py-2 border-b border-gold/10">
                <span class="font-display text-gold-light font-semibold text-sm">{section.title}</span>
              </div>
              <div class="px-4 py-2 space-y-1">
                {section.duties.map(duty => (
                  <div class="flex justify-between font-body text-xs border-b border-gold/10 pb-1.5 last:border-0 last:pb-0">
                    {duty.role && <span class="text-gold-pale/50">{duty.role}</span>}
                    <span class={`text-gold-pale/80 ${!duty.role ? 'w-full' : ''}`}>{duty.name}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Notices Panel -->
      <div id="notice-notices" class="notice-panel" style="display:none">
        {announcements.map((notice, i) => (
          <div class={`border-l-2 ${i === 0 ? 'border-gold' : 'border-gold/40'} bg-white rounded-r px-4 py-3 mb-3 ${i > 0 ? 'opacity-70' : ''}`}>
            <div class="font-body text-[0.6rem] text-gray-400 tracking-widest uppercase mb-1">{notice.date}</div>
            <div class="font-display text-navy font-semibold text-sm mb-1">{notice.title}</div>
            <div class="font-body text-xs text-gray-600 whitespace-pre-line">{notice.body}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ PRAYER TOPICS ══════════════════════════════ -->
  <section class="bg-navy py-8 px-4" id="prayer">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center gap-3 mb-5 reveal">
        <div class="flex-1 h-px bg-gradient-to-r from-transparent to-gold/35"></div>
        <h2 class="font-display text-gold-light text-xl font-semibold whitespace-nowrap">Tawngtai Thupui</h2>
        <div class="flex-1 h-px bg-gradient-to-l from-transparent to-gold/35"></div>
      </div>
      <div class="space-y-3">
        {prayerTopics.map((topic, i) => (
          <div class={`reveal reveal-delay-${(i % 4) + 1} flex gap-3 items-start border-b border-gold/10 pb-3 last:border-0`}>
            <span class="font-display text-gold/50 text-xl leading-tight flex-shrink-0 w-5">{i + 1}</span>
            <p class="font-body text-gold-pale/75 text-sm italic leading-relaxed">{topic}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SECRETARY CONTACT ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="contact">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Church Secretary</h2>
      </div>
      <div class="reveal bg-navy border border-gold/20 rounded p-5">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-full border border-gold/40 bg-navy-light flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-gold/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div>
            <div class="font-display text-gold-light font-semibold text-base">{generalEntry?.data.secretary_name ?? '[Secretary Hming]'}</div>
            <div class="font-body text-[0.65rem] text-gold-pale/50 tracking-widest uppercase">Church Secretary</div>
          </div>
        </div>
        <div class="space-y-2 border-t border-gold/10 pt-3">
          <a href={`tel:${(generalEntry?.data.secretary_phone ?? '').replace(/\s/g, '')}`} class="flex items-center gap-3 text-gold-pale/70 hover:text-gold-light transition-colors group">
            <svg class="w-4 h-4 text-gold/60 group-hover:text-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span class="font-body text-sm">{generalEntry?.data.secretary_phone}</span>
          </a>
          <a href={`mailto:${generalEntry?.data.secretary_email}`} class="flex items-center gap-3 text-gold-pale/70 hover:text-gold-light transition-colors group">
            <svg class="w-4 h-4 text-gold/60 group-hover:text-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span class="font-body text-sm">{generalEntry?.data.secretary_email}</span>
          </a>
          <div class="flex items-center gap-3 text-gold-pale/70">
            <svg class="w-4 h-4 text-gold/60 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="font-body text-sm">{generalEntry?.data.address}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // ── HERO SLIDESHOW ──
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('[data-dot]');
  const caption = document.getElementById('hero-caption');
  const counter = document.getElementById('slide-counter');
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    slides[current].classList.remove('active');
    dots[current].classList.replace('w-8', 'w-5');
    dots[current].classList.replace('bg-gold', 'bg-gold/30');
    current = index;
    slides[current].classList.add('active');
    dots[current].classList.replace('w-5', 'w-8');
    dots[current].classList.replace('bg-gold/30', 'bg-gold');
    if (caption) caption.textContent = slides[current].getAttribute('data-caption') || '';
    if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
  }

  function next() { goTo((current + 1) % slides.length); }

  function startTimer() {
    clearInterval(timer);
    timer = setInterval(next, 4500);
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      goTo(parseInt(dot.getAttribute('data-dot') || '0'));
      startTimer();
    });
  });

  startTimer();

  // ── HISTORY READ MORE ──
  const btn = document.getElementById('history-toggle');
  const short = document.getElementById('history-short');
  const full = document.getElementById('history-full');
  let expanded = false;
  btn?.addEventListener('click', () => {
    expanded = !expanded;
    short!.classList.toggle('hidden', expanded);
    full!.classList.toggle('hidden', !expanded);
    btn!.textContent = expanded ? '← Read Less' : 'Read More →';
  });

  // ── NOTICE TAB FIX (ensure first panel shows) ──
  document.getElementById('notice-weekly')!.style.display = 'block';
</script>
