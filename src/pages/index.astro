<script>
  // ── HERO SLIDESHOW ──
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('[data-dot]');
  const caption = document.getElementById('hero-caption');
  const counter = document.getElementById('slide-counter');
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    slides[current].classList.remove('active');
    dots[current].classList.replace('w-8', 'w-5');
    dots[current].classList.replace('bg-gold', 'bg-gold/30');
    current = index;
    slides[current].classList.add('active');
    dots[current].classList.replace('w-5', 'w-8');
    dots[current].classList.replace('bg-gold/30', 'bg-gold');
    if (caption) caption.textContent = slides[current].getAttribute('data-caption') || '';
    if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
  }

  function next() { goTo((current + 1) % slides.length); }

  function startTimer() {
    clearInterval(timer);
    timer = setInterval(next, 4500);
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      goTo(parseInt(dot.getAttribute('data-dot') || '0'));
      startTimer();
    });
  });

  startTimer();

  // ── HISTORY READ MORE ──
  const btn = document.getElementById('history-toggle');
  const short = document.getElementById('history-short');
  const full = document.getElementById('history-full');
  let expanded = false;
  btn?.addEventListener('click', () => {
    expanded = !expanded;
    short!.classList.toggle('hidden', expanded);
    full!.classList.toggle('hidden', !expanded);
    btn!.textContent = expanded ? '← Read Less' : 'Read More →';
  });

  // ── NOTICE TAB FIX (ensure first panel shows) ──
  document.getElementById('notice-weekly')!.style.display = 'block';

  // ── QUICK LINKS (deep link to notice board tabs) ──
  function activateNoticeTab(target: string) {
    document.querySelectorAll('.notice-tab').forEach((t) => {
      t.classList.toggle('active', (t as HTMLElement).dataset.target === target);
    });
    document.querySelectorAll('.notice-panel').forEach((p) => {
      (p as HTMLElement).style.display = 'none';
    });
    const panel = document.getElementById(`notice-${target}`);
    if (panel) panel.style.display = 'block';
  }

  document.querySelectorAll('[data-quick-action]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const action = (link as HTMLElement).dataset.quickAction;
      if (action === 'tab-weekly' || action === 'tab-monthly') {
        e.preventDefault();
        const board = document.getElementById('notice-board');
        board?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        setTimeout(() => activateNoticeTab(action === 'tab-weekly' ? 'weekly' : 'monthly'), 400);
      }
    });
  });

  if (location.hash === '#notice-board') {
    const params = new URLSearchParams(location.search);
    const tab = params.get('tab');
    if (tab === 'weekly' || tab === 'monthly' || tab === 'notices') {
      setTimeout(() => activateNoticeTab(tab), 300);
    }
  }
</script>
