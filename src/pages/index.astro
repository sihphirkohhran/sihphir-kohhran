---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickLinks from '../components/QuickLinks.astro';
import Highlights from '../components/Highlights.astro';
import { getCollection, getEntry } from 'astro:content';
import {
  getWeeklySchedules,
  getMonthlyDuties,
  getKtpInlengDocs,
  getOtherDocuments,
} from '../lib/cms';
import { normalizeHighlights } from '../lib/highlights';
import { renderMarkdown } from '../lib/markdown';
import { loadGalleryPhotos, pickHomeGalleryPhotos } from '../lib/gallery';
import { buildHomeDocumentSections } from '../lib/documents';

const heroEntry = await getEntry('settings', 'hero');
const quickLinksEntry = await getEntry('settings', 'quick-links');
const highlightsEntry = await getEntry('settings', 'highlights');
const statsEntry = await getEntry('settings', 'statistics');
const pastorEntry = await getEntry('settings', 'pastor');
const historyEntry = await getEntry('settings', 'history');
const prayerEntry = await getEntry('settings', 'prayer');
const generalEntry = await getEntry('settings', 'general');
const homeEntry = await getEntry('settings', 'home');

const stats = statsEntry?.data.stats ?? [];
const heroSlides = heroEntry?.data.slides ?? [];
const home = homeEntry?.data ?? {};
const positiveCount = (value: unknown, fallback: number) => {
  const count = Number(value);
  return Number.isFinite(count) && count > 0 ? Math.floor(count) : fallback;
};

const allGalleryPhotos = await loadGalleryPhotos();
const galleryCount = positiveCount(home.galleryCount, 6);
const galleryCategory = String(home.galleryCategory ?? '').trim();
const gallerySource = galleryCategory
  ? allGalleryPhotos.filter((photo) => photo.category === galleryCategory)
  : allGalleryPhotos;
const galleryPhotos = home.galleryOrder === 'oldest'
  ? [...gallerySource]
      .sort((a, b) => a.sortKey.localeCompare(b.sortKey))
      .slice(0, galleryCount)
  : pickHomeGalleryPhotos(gallerySource, galleryCount);

const latestWeekly = (await getWeeklySchedules())[0];
const weeklySchedule = latestWeekly
  ? {
      date: `${latestWeekly.week_start} — ${latestWeekly.week_end}`,
      days: (latestWeekly.days as { day: string; duties: { role: string; name: string }[] }[]) ?? [],
    }
  : { date: '', days: [] };

const latestMonthly = (await getMonthlyDuties())[0];
const monthlyDuties = latestMonthly
  ? {
      month: String(latestMonthly.month ?? ''),
      sections: (latestMonthly.sections as {
        title: string;
        duties: { role: string; name: string }[];
      }[]) ?? [],
    }
  : { month: '', sections: [] };

const prayerTopics = (prayerEntry?.data.topics ?? []).map((t) =>
  typeof t === 'string' ? t : t.topic,
);

const docCategoryRegistry = await getEntry('settings', 'document-categories');
const docCategoriesList = docCategoryRegistry?.data.categories ?? [];

const ktpDocs = await getKtpInlengDocs();
const otherDocs = await getOtherDocuments();

const documentCount = positiveCount(home.documentCount, 3);
const documentCategory = String(home.documentCategory ?? '').trim();
const builtHomeDocuments = buildHomeDocumentSections(
  ktpDocs,
  otherDocs,
  docCategoriesList,
  documentCount,
);
const homeDocuments = documentCategory
  ? builtHomeDocuments.filter(
      (section) => section.id === documentCategory || section.category === documentCategory,
    )
  : builtHomeDocuments;

const announcementEntries = (await getCollection('notices'))
  .filter((e) => e.id.startsWith('announcements/'))
  .sort((a, b) => String(b.data.date ?? b.id).localeCompare(String(a.data.date ?? a.id)));

const noticeCount = positiveCount(home.noticeCount, 3);
const announcements = await Promise.all(
  announcementEntries.slice(0, noticeCount).map(async (entry) => {
    const { Content } = await entry.render();
    return {
      id: entry.id.replace(/^announcements\//, ''),
      title: entry.data.title ?? '',
      date: entry.data.date ?? '',
      Content,
    };
  }),
);

const historyFullHtml = renderMarkdown(historyEntry?.data.full ?? '');
const lookerUrl = generalEntry?.data.looker_url ?? 'https://lookerstudio.google.com';

const quickLinks = quickLinksEntry?.data.links ?? [];
const highlightItems = normalizeHighlights(
  highlightsEntry?.data.items as Record<string, unknown>[] | undefined,
);
---

<BaseLayout activePage="home">

  <!-- ══════════════════════════════ HERO ══════════════════════════════ -->
  <section class="relative h-[62vw] min-h-[240px] max-h-[480px] overflow-hidden bg-navy" id="hero-section">
    <!-- Slides (replaced by real images in production) -->
    {heroSlides.map((slide, i) => (
      <div
        class={`hero-slide ${i === 0 ? 'active' : ''}`}
        style={`background-image: linear-gradient(to bottom, rgba(10,22,40,0.35) 0%, rgba(10,22,40,0.65) 100%), url('${slide.src}'); background-color: #162844;`}
        data-slide={i}
        data-caption={slide.caption}
      ></div>
    ))}

    <!-- Hero overlay content -->
    <div class="absolute inset-0 flex flex-col justify-end px-5 pb-7 z-10">
      <div class="flex flex-wrap gap-3 mb-3">
        <a href="#contact"
          class="inline-flex items-center gap-2 rounded border border-gold/20 bg-gold/10 px-4 py-2 text-sm font-semibold text-gold-pale/90 hover:bg-gold/20 hover:text-white transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M22 16.92v3a2 2 0 01-2.18 2 19.78 19.78 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.78 19.78 0 014.18 4.18 2 2 0 016.2 2h3a2 2 0 012 1.72 12.24 12.24 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.24 12.24 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          Contact
        </a>
        <a href={generalEntry?.data.youtube_url ?? 'https://youtube.com'} target="_blank" rel="noopener"
          class="inline-flex items-center gap-2 rounded border border-gold/20 bg-gold/10 px-4 py-2 text-sm font-semibold text-gold-pale/90 hover:bg-gold/20 hover:text-white transition-all">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon fill="var(--navy)" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
          YouTube
        </a>
      </div>
      <h2 class="font-display text-white text-2xl sm:text-3xl font-semibold leading-tight mb-2" id="hero-caption">
        {heroSlides[0].caption}
      </h2>
      <p class="font-body text-gold-pale/70 text-sm mb-4">Sihphir Presbyterian Kohhran</p>

      <!-- Slide indicators -->
      <div class="flex gap-2 items-center" id="slide-dots">
        {heroSlides.map((_, i) => (
          <button
            class={`h-0.5 rounded-full transition-all duration-300 cursor-pointer ${i === 0 ? 'w-8 bg-gold' : 'w-5 bg-gold/30'}`}
            data-dot={i}
            aria-label={`Slide ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>

    <!-- Slide counter -->
    <div class="absolute bottom-7 right-5 font-body text-[0.6rem] text-gold-pale/40 tracking-widest z-10" id="slide-counter">
      1 / {heroSlides.length}
    </div>
  </section>

  <Highlights items={highlightItems} />

  <QuickLinks links={quickLinks} />

  <!-- ══════════════════════════════ STATISTICS ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="statistics">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Kohhran inchhiarna</h2>
      </div>
      <div class="grid grid-cols-3 gap-3 mb-4">
        {stats.map((stat, i) => (
          <div class={`stat-card reveal reveal-delay-${i + 1}`}>
            <div class="font-display text-gold-light text-3xl sm:text-4xl font-bold leading-none mb-1">{stat.value}</div>
            <div class="font-body text-[0.62rem] text-gold-pale/65 tracking-widest uppercase">{stat.label}</div>
          </div>
        ))}
      </div>
      <a
        href={lookerUrl}
        target="_blank"
        rel="noopener"
        class="reveal flex items-center justify-center gap-2 font-body text-xs text-navy border border-navy/20 hover:border-navy/50 hover:bg-navy hover:text-gold-pale py-2.5 px-4 rounded transition-all tracking-wide"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        Detailed Dashboard — Looker Studio →
      </a>
    </div>
  </section>

  <!-- ══════════════════════════════ PASTOR ══════════════════════════════ -->
  <section class="bg-ivory py-8 px-4" id="pastor">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Pastor's Message</h2>
      </div>
      <div class="reveal bg-navy border border-gold/20 rounded p-5 relative overflow-hidden">
        <!-- Large quote mark watermark -->
        <div class="absolute -top-2 left-2 font-display text-[6rem] text-gold/10 leading-none select-none pointer-events-none">"</div>
        <div class="flex gap-4 items-start relative z-10">
          <div class="flex-shrink-0">
            <div class="w-16 h-16 rounded-full border-2 border-gold/60 overflow-hidden bg-navy-light flex items-center justify-center">
              <img src={pastorEntry?.data.photo ?? '/images/pastor.jpg'} alt="Pastor" class="w-full h-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
              <span class="w-full h-full items-center justify-center hidden font-display text-gold-pale text-xl">✝</span>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-display text-gold-light font-semibold text-base mb-0.5">{pastorEntry?.data.name ?? 'Rev. [Pastor Hming]'}</div>
            <div class="font-body text-[0.65rem] text-gold-pale/50 tracking-widest uppercase mb-3">{pastorEntry?.data.title ?? 'Head Pastor · Sihphir Kohhran'}</div>
            <div class="font-body text-gold-pale/75 text-sm italic leading-relaxed">
              "{pastorEntry?.data.message ?? ''}"
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ CHURCH HISTORY ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="history">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Sihphir Kohhran Chanchin</h2>
      </div>
      <div class="reveal border-l-4 border-gold rounded-r bg-ivory pl-5 pr-4 py-4">
        <!-- Church building photo -->
        <div class="w-full aspect-video rounded overflow-hidden mb-4 bg-ivory-dark border border-gold/20 flex items-center justify-center">
          <img src={historyEntry?.data.building_photo ?? '/images/church-building.jpg'} alt="Sihphir Presbyterian Kohhran Building"
            class="w-full h-full object-cover"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
          <span class="hidden font-body text-xs text-gold/40 tracking-wide">Church Building Photo</span>
        </div>

        <div class="font-body text-sm text-gray-700 leading-relaxed mb-3" id="history-short">
          {historyEntry?.data.short}
        </div>
        <div class="content-page-body font-body text-sm text-gray-700 leading-relaxed mb-4 hidden" id="history-full">
          <Fragment set:html={historyFullHtml} />
        </div>
        <button
          id="history-toggle"
          class="font-body text-[0.7rem] tracking-[0.1em] uppercase text-navy border-b border-navy/50 hover:border-navy transition-colors pb-0.5"
        >
          Read More →
        </button>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ GALLERY ══════════════════════════════ -->
  <section class="bg-ivory py-8 px-4" id="gallery">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Gallery</h2>
      </div>
      <div class="home-gallery-masonry mb-4">
        {galleryPhotos.map((photo, i) => (
          <div class={`home-gallery-item gallery-item reveal reveal-delay-${(i % 3) + 1}`}>
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-auto object-cover cursor-pointer block"
              data-lightbox
              data-lightbox-src={photo.src}
              data-lightbox-caption={photo.caption}
              loading="lazy"
              onerror="this.parentElement.innerHTML='<div class=\'w-full aspect-square flex items-center justify-center bg-ivory-dark\'><svg class=\'w-6 h-6 text-gold/30\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\'/><circle cx=\'8.5\' cy=\'8.5\' r=\'1.5\'/><path d=\'m21 15-5-5L5 21\'/></svg></div>'"
            />
          </div>
        ))}
      </div>
      <a href="/gallery"
        class="reveal block text-center font-body text-[0.7rem] tracking-[0.1em] uppercase text-navy border border-navy/20 hover:bg-navy hover:text-gold-pale py-2.5 transition-all rounded">
        View Full Gallery →
      </a>
    </div>
  </section>

  <!-- ══════════════════════════════ DOCUMENTS ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="documents">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Documents</h2>
      </div>
      <div class="space-y-4">
        {homeDocuments.map((doc, di) => (
          <div class={`reveal reveal-delay-${(di % 3) + 1} bg-ivory border border-gold/10 rounded overflow-hidden shadow-sm shadow-navy/10 transition-shadow duration-200 hover:shadow-md`}>
            <div class="flex items-center justify-between px-4 py-3 border-b border-gold/10">
              <h3 class="font-body font-bold text-navy text-sm">{doc.category}</h3>
              <span class="font-body text-[0.6rem] text-navy/60 tracking-widest uppercase">{doc.badge}</span>
            </div>
            <div class="px-4 py-2">
              {doc.items.length > 0 ? (
                doc.items.map((item) => (
                  <div class="doc-item">
                    <div class="flex items-center gap-2 min-w-0">
                      <svg class="w-3.5 h-3.5 text-navy/50 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                      <div class="min-w-0">
                        <span class="font-body text-navy text-xs block truncate">{item.name}</span>
                        {item.date && (
                          <span class="font-body text-[0.6rem] text-navy/55 tracking-wide">{item.date}</span>
                        )}
                      </div>
                    </div>
                    <a href={item.url} target="_blank" rel="noopener"
                      class="font-body text-gold text-xs hover:text-gold-light tracking-wide flex items-center gap-1 transition-colors flex-shrink-0 ml-2">
                      PDF ↗
                    </a>
                  </div>
                ))
              ) : (
                <p class="font-body text-xs text-navy/70 py-2 text-center">No documents in this category yet.</p>
              )}
            </div>
            {doc.totalCount > 0 && (
              <div class="px-4 pb-3 pt-1 border-t border-gold/[0.06] text-right">
                <a
                  href={doc.archiveLink}
                  class="font-body text-[0.65rem] tracking-[0.1em] uppercase text-navy/70 hover:text-navy transition-colors"
                >
                  {doc.totalCount > doc.items.length
                    ? `View all ${doc.totalCount} →`
                    : 'View in archive →'}
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
      <div class="mt-3 text-right">
        <a href="/document" class="font-body text-[0.7rem] tracking-[0.1em] uppercase text-navy border-b border-navy/30 hover:border-navy transition-colors">
          View All Documents →
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ NOTICE BOARD ══════════════════════════════ -->
  <section class="bg-ivory py-8 px-4" id="notice-board">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Notice Board</h2>
      </div>

      <!-- Tabs -->
      <div class="flex border-b-2 border-navy mb-5 overflow-x-auto md:overflow-visible reveal">
        <button class="notice-tab active" data-target="weekly">Hun ruatna</button>
        <button class="notice-tab" data-target="monthly">Thlabi mawhphurtu</button>
        <button class="notice-tab" data-target="notices">Notices</button>
      </div>

      <!-- Weekly Schedule Panel -->
      <div id="notice-weekly" class="notice-panel">
        <div class="flex items-center justify-between mb-3">
          <span class="font-body text-xs text-gray-500 tracking-wide">Week of: {weeklySchedule.date}</span>
        </div>
        <div class="space-y-3">
          {weeklySchedule.days.map((day, i) => (
            <div class={`reveal reveal-delay-${i + 1} border-l-2 border-gold bg-white rounded-r px-4 py-3`}>
              <div class="font-body text-sm font-semibold text-gray-600 tracking-wide uppercase mb-2">{day.day}</div>
              <div class="space-y-1">
                {day.duties.map(duty => (
                  <div class="flex justify-between font-body text-sm text-gray-700 border-b border-ivory-dark pb-1 last:border-0 last:pb-0">
                    <span class="text-gray-400 text-xs">{duty.role}</span>
                    <span class="font-medium text-navy text-right">{duty.name}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="pagination mt-4">
          <button class="page-btn active">1</button>
          <button class="page-btn">2</button>
          <button class="page-btn">3</button>
        </div>
      </div>

      <!-- Monthly Duties Panel -->
      <div id="notice-monthly" class="notice-panel hidden" style="display:none">
        <div class="font-body text-sm text-navy font-semibold tracking-wide mb-3">{monthlyDuties.month}</div>
        <div class="space-y-3">
          {monthlyDuties.sections.map((section, i) => (
            <div class="bg-navy border border-gold/15 rounded overflow-hidden">
              <div class="bg-navy-light px-4 py-2 border-b border-gold/10">
                <span class="font-display text-gold-light font-semibold text-sm">{section.title}</span>
              </div>
              <div class="px-4 py-2 space-y-1">
                {section.duties.map(duty => (
                  <div class="flex justify-between font-body text-xs border-b border-gold/10 pb-1.5 last:border-0 last:pb-0">
                    {duty.role && <span class="text-gold-pale/50">{duty.role}</span>}
                    <span class={`text-gold-pale/80 ${!duty.role ? 'w-full' : ''}`}>{duty.name}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Notices Panel -->
      <div id="notice-notices" class="notice-panel" style="display:none">
        {announcements.map((notice, i) => (
          <div class={`border-l-2 ${i === 0 ? 'border-gold' : 'border-gold/40'} bg-white rounded-r px-4 py-3 mb-3 ${i > 0 ? 'opacity-70' : ''}`}>
            <div class="font-body text-[0.6rem] text-gray-400 tracking-widest uppercase mb-1">{notice.date}</div>
            <div class="font-display text-navy font-semibold text-sm mb-1">{notice.title}</div>
            <div class="content-page-body font-body text-xs text-gray-600">
              <notice.Content />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ PRAYER TOPICS ══════════════════════════════ -->
  <section class="bg-navy py-8 px-4" id="prayer">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center gap-3 mb-5 reveal">
        <div class="flex-1 h-px bg-gradient-to-r from-transparent to-gold/35"></div>
        <h2 class="font-display text-gold-light text-xl font-semibold whitespace-nowrap">Tawngtai Thupui</h2>
        <div class="flex-1 h-px bg-gradient-to-l from-transparent to-gold/35"></div>
      </div>
      <div class="space-y-3">
        {prayerTopics.map((topic, i) => (
          <div class={`reveal reveal-delay-${(i % 4) + 1} flex gap-3 items-start border-b border-gold/10 pb-3 last:border-0`}>
            <span class="font-display text-gold/50 text-xl leading-tight flex-shrink-0 w-5">{i + 1}</span>
            <p class="font-body text-gold-pale/75 text-sm italic leading-relaxed">{topic}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SECRETARY CONTACT ══════════════════════════════ -->
  <section class="bg-cream py-8 px-4" id="contact">
    <div class="max-w-2xl mx-auto">
      <div class="gold-divider reveal">
        <h2>Contact</h2>
      </div>
      <div class="reveal bg-navy border border-gold/20 rounded p-5">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-full border border-gold/40 bg-navy-light flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-gold/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div>
            <div class="font-body font-bold text-gold-light text-base">{generalEntry?.data.secretary_name ?? '[Secretary Hming]'}</div>
            <div class="font-body text-[0.65rem] text-gold-pale/50 tracking-widest uppercase">Kohhran Secretary</div>
          </div>
        </div>
        <div class="space-y-2 border-t border-gold/10 pt-3">
          <a href={`tel:${(generalEntry?.data.secretary_phone ?? '').replace(/\s/g, '')}`} class="flex items-center gap-3 text-gold-pale/70 hover:text-gold-light transition-colors group">
