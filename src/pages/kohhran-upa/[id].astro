---
import { getCollection } from 'astro:content';
import ElderDetail from '../../components/ElderDetail.astro';
import { normalizeElderProfile } from '../../lib/elder-profile';
export async function getStaticPaths() {
  const profiles = (await getCollection('elders'))
    .map(normalizeElderProfile)
    .filter((profile): profile is NonNullable<typeof profile> => Boolean(profile));
  return profiles.map((profile) => ({ params: { id: profile.id }, props: { profile } }));
}
const { profile } = Astro.props;
---
<ElderDetail profile={profile} />
