<style>.legacy-redirect{display:grid;place-content:center;justify-items:center;min-height:55vh;padding:30px;text-align:center}.legacy-redirect h1{font-family:var(--font-display,serif)}.legacy-redirect p{color:#718096}.legacy-redirect a{border-radius:8px;padding:10px 13px;background:#142740;color:white;text-decoration:none}</style>
