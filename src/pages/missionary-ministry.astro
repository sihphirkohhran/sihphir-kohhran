---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import { getCollection } from 'astro:content';
import { resolveMediaUrl } from '../lib/ministry';
import { renderMarkdown } from '../lib/markdown';

const entries = (await getCollection('missionaries')).sort(
  (a, b) => b.data.sent_year - a.data.sent_year,
);
---

<ContentPageLayout
  title="Hun puma rawngbawla chhuak te"
  activeKey="missionary-ministry"
  unboxed
>

  {entries.length === 0 ? (
    <p class="text-gray-600">No missionary profiles yet. Add entries in Admin → Missionary Ministry.</p>
  ) : (
    <div class="pastoral-grid">
      {entries.map((entry) => {
        const d = entry.data;
        const photo = resolveMediaUrl(d.photo);
        const familyPhoto = resolveMediaUrl(d.family_photo);
        const notesHtml = renderMarkdown(d.notes);
        const prayerHtml = renderMarkdown(d.prayer_requests);
        return (
          <article class="ministry-profile-card missionary-card reveal">
            {photo ? (
              <img src={photo} alt={d.name} class="ministry-profile-photo" loading="lazy" />
            ) : (
              <div class="ministry-profile-photo ministry-profile-photo-placeholder">No photo</div>
            )}
            <div class="ministry-profile-details">
              <h2 class="ministry-profile-name">{d.name}</h2>
              <dl class="ministry-profile-dl">
                <div>
                  <dt>Mission Field</dt>
                  <dd>{d.mission_field}</dd>
                </div>
                <div>
                  <dt>Sent Year</dt>
                  <dd>{d.sent_year}</dd>
                </div>
                <div>
                  <dt>Status</dt>
                  <dd>{d.status}</dd>
                </div>
              </dl>
              {notesHtml && (
                <div class="ministry-profile-notes content-page-body" set:html={notesHtml} />
              )}
              {prayerHtml && (
                <div class="ministry-profile-extra">
                  <p class="ministry-profile-label">Prayer requests</p>
                  <div class="content-page-body" set:html={prayerHtml} />
                </div>
              )}
              {familyPhoto && (
                <div class="ministry-profile-extra">
                  <p class="ministry-profile-label">Family</p>
                  <img
                    src={familyPhoto}
                    alt={`${d.name} family`}
                    class="ministry-family-photo"
                    loading="lazy"
                  />
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  )}

</ContentPageLayout>
