---
import { getCollection } from 'astro:content';
import MinistryArchive from '../components/MinistryArchive.astro';
import { normalizeMinistryProfile } from '../lib/ministry-profile';
const profiles=(await getCollection('missionaries')).map(entry=>normalizeMinistryProfile(entry,'missionary')).filter((profile): profile is NonNullable<typeof profile>=>Boolean(profile));
---
<MinistryArchive title="Missionary" subtitle="Honouring those sent out in mission and preserving the story of their service across every field." activePage="missionary-ministry" currentLabel="Current Missionaries" historyLabel="Former Missionaries" profiles={profiles} />
