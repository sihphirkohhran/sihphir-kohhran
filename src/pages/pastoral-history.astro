---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import { getCollection } from 'astro:content';
import {
  formatServedYears,
  resolveMediaUrl,
  yearsServed,
} from '../lib/ministry';
import { renderMarkdown } from '../lib/markdown';

const entries = (await getCollection('pastoral')).sort(
  (a, b) => b.data.start_year - a.data.start_year,
);

const pastors = entries.filter((entry) => (entry.data.role ?? 'pastor') === 'pastor');
const proPastors = entries.filter(
  (entry) => entry.data.role === 'pro-pastor',
);
---

<ContentPageLayout
  title="Pastor Bial lo vawng tawhte"
  activeKey="pastoral-history"
  unboxed
>

  {entries.length > 0 && (
    <div class="pastoral-sections">
      <section class="pastoral-section">
        <h3 class="pastoral-section-title">Pastor Section</h3>
        {pastors.length === 0 ? (
          <p class="text-gray-600">No pastors are listed yet.</p>
        ) : (
          <div class="pastoral-grid">
            {pastors.map((entry) => {
              const { name, photo, start_year, end_year, notes } = entry.data;
              const served = yearsServed(start_year, end_year);
              const servedRange = formatServedYears(start_year, end_year);
              const notesHtml = renderMarkdown(notes);
              return (
                <article class="pastoral-entry reveal">
                  <div class="ministry-profile-card pastoral-card">
                    {photo ? (
                      <img
                        src={resolveMediaUrl(photo)}
                        alt={name}
                        class="ministry-profile-photo"
                        loading="lazy"
                      />
                    ) : (
                      <div class="ministry-profile-photo ministry-profile-photo-placeholder">No photo</div>
                    )}
                    <div class="ministry-profile-details">
                      <h4 class="ministry-profile-name">{name}</h4>
                      <p class="ministry-profile-meta">
                        <span class="ministry-profile-label">Served:</span> {servedRange}
                      </p>
                      <p class="ministry-profile-meta">
                        <span class="ministry-profile-label">Years served:</span> {served} {served === 1 ? 'year' : 'years'}
                      </p>
                      {notesHtml && (
                        <div class="ministry-profile-notes content-page-body" set:html={notesHtml} />
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </section>

      <section class="pastoral-section">
        <h3 class="pastoral-section-title">Pro. Pastor Section</h3>
        {proPastors.length === 0 ? (
          <p class="text-gray-600">No pro. pastors are listed yet.</p>
        ) : (
          <div class="pastoral-grid">
            {proPastors.map((entry) => {
              const { name, photo, start_year, end_year, notes } = entry.data;
              const served = yearsServed(start_year, end_year);
              const servedRange = formatServedYears(start_year, end_year);
              const notesHtml = renderMarkdown(notes);
              return (
                <article class="pastoral-entry reveal">
                  <div class="ministry-profile-card pastoral-card">
                    {photo ? (
                      <img
                        src={resolveMediaUrl(photo)}
                        alt={name}
                        class="ministry-profile-photo"
                        loading="lazy"
                      />
                    ) : (
                      <div class="ministry-profile-photo ministry-profile-photo-placeholder">No photo</div>
                    )}
                    <div class="ministry-profile-details">
                      <h4 class="ministry-profile-name">{name}</h4>
                      <p class="ministry-profile-meta">
                        <span class="ministry-profile-label">Served:</span> {servedRange}
                      </p>
                      <p class="ministry-profile-meta">
                        <span class="ministry-profile-label">Years served:</span> {served} {served === 1 ? 'year' : 'years'}
                      </p>
                      {notesHtml && (
                        <div class="ministry-profile-notes content-page-body" set:html={notesHtml} />
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </section>
    </div>
  )}

</ContentPageLayout>
