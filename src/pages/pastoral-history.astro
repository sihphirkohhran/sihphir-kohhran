---
import { getCollection } from 'astro:content';
import MinistryArchive from '../components/MinistryArchive.astro';
import { normalizeMinistryProfile } from '../lib/ministry-profile';
const profiles=(await getCollection('pastoral')).map(entry=>normalizeMinistryProfile(entry,'pastor')).filter((profile): profile is NonNullable<typeof profile>=>Boolean(profile));
---
<MinistryArchive title="Bialtu Pastor" subtitle="Meet our current pastoral leadership and explore the history of those who have faithfully served Sihphir Presbyterian Kohhran." activePage="pastoral-history" currentLabel="Current Pastor" historyLabel="Pastor History Timeline" profiles={profiles} pastor />
