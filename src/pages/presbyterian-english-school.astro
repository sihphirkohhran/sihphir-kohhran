---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getEntry } from 'astro:content';
import { renderMarkdown } from '../lib/markdown';

const entry=await getEntry('settings','school');
const school=entry?.data as any;
const page=school.page,info=school.information,management=school.management,principal=school.principal;
const teachers=[...(school.teachers||[])].sort((a,b)=>(a.display_order??0)-(b.display_order??0));
const members=[...(management.members||[])].sort((a,b)=>(a.display_order??0)-(b.display_order??0));
const gallery=[...(school.gallery||[])].sort((a,b)=>(b.year??0)-(a.year??0));
const placeholder='/images/profile-placeholder.svg';
const leaders=[management.chairman&&{name:management.chairman,designation:'Chairman'},management.secretary&&{name:management.secretary,designation:'Secretary'}].filter(Boolean);
---
<BaseLayout title={page.seo_title} description={page.seo_description} activePage="presbyterian-english-school">
  <PageHero title={page.hero_title} subtitle={page.hero_subtitle} image={page.hero_background_image} eyebrow="Presbyterian English School, Sihphir" />
  <main class="school-page max-w-6xl mx-auto px-4 py-9 sm:py-12">
    <section class="school-about reveal"><div><span>About the School</span><h2>{info.school_name}</h2>{page.intro_text&&<p>{page.intro_text}</p>}</div><dl>{info.establishment_year&&<div><dt>Established</dt><dd>{info.establishment_year}</dd></div>}{info.motto&&<div><dt>Motto</dt><dd>{info.motto}</dd></div>}<div><dt>Address</dt><dd>{info.address}</dd></div>{info.website&&<div><dt>Website</dt><dd><a href={info.website}>{info.website}</a></dd></div>}</dl></section>
    {school.history&&<section class="school-section reveal"><header><span>Our Story</span><h2>History</h2></header><div class="prose" set:html={renderMarkdown(school.history)}></div></section>}
    {school.vision_mission&&<section class="school-section feature reveal"><header><span>Our Purpose</span><h2>Vision &amp; Mission</h2></header><div class="prose" set:html={renderMarkdown(school.vision_mission)}></div></section>}
    {(leaders.length||members.length)&&<section class="school-section reveal"><header><span>Leadership</span><h2>Management Committee</h2></header><div class="people-grid">{leaders.map((person:any)=><article class="person compact"><img src={placeholder} alt=""/><div><small>{person.designation}</small><h3>{person.name}</h3></div></article>)}{members.map((person:any)=><article class="person compact"><img src={person.photo||placeholder} alt=""/><div><small>{person.designation||'Member'}</small><h3>{person.name}</h3></div></article>)}</div></section>}
    {principal.name&&<section class="school-section reveal"><header><span>School Leadership</span><h2>Headmaster / Principal</h2></header><article class="principal"><img src={principal.photo||placeholder} alt={principal.name}/><div><small>{principal.designation}</small><h3>{principal.name}</h3>{principal.biography&&<div class="prose" set:html={renderMarkdown(principal.biography)}></div>}</div></article></section>}
    {teachers.length>0&&<section class="school-section reveal"><header><span>Our Faculty</span><h2>Teachers</h2></header><div class="teacher-grid">{teachers.map((teacher:any)=><article class="person"><img src={teacher.photo||placeholder} alt={teacher.name}/><div><small>{teacher.designation}{teacher.subject?` · ${teacher.subject}`:''}</small><h3>{teacher.name}</h3>{teacher.biography&&<p>{teacher.biography}</p>}</div></article>)}</div></section>}
    {gallery.length>0&&<section class="school-section reveal"><header><span>School Life</span><h2>Gallery</h2></header><div class="photo-grid">{gallery.map((photo:any)=><button data-lightbox-src={photo.image} data-lightbox-caption={photo.caption||''}><img src={photo.image} alt={photo.caption||'School gallery image'} loading="lazy"/><span>{photo.caption}</span>{photo.year&&<small>{photo.year}</small>}</button>)}</div></section>}
    <section class="school-section contact reveal"><header><span>Get in Touch</span><h2>Contact</h2></header><div><address>{school.contact.address}</address>{school.contact.phone&&<a href={`tel:${school.contact.phone}`}>{school.contact.phone}</a>}{school.contact.email&&<a href={`mailto:${school.contact.email}`}>{school.contact.email}</a>}{school.contact.google_map_link&&<a class="map" href={school.contact.google_map_link} target="_blank" rel="noopener">View on Google Maps →</a>}</div></section>
  </main>
</BaseLayout>
<style>
 .school-page{color:#172941}.school-about{display:grid;grid-template-columns:1.4fr 1fr;gap:35px;padding:30px;border:1px solid rgba(18,35,59,.1);border-radius:15px;background:#fffdf8;box-shadow:0 12px 35px rgba(20,36,58,.07)}header span,.school-about span{color:#9c7628;font-size:.57rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}h2{margin:5px 0 12px;font-family:var(--font-display,serif);font-size:1.65rem}.school-about p,.prose{color:#59677a;font-size:.82rem;line-height:1.75}.school-about dl{margin:0}.school-about dl div{padding:9px 0;border-bottom:1px solid rgba(18,35,59,.09)}dt{color:#8c6b29;font-size:.57rem;font-weight:700;text-transform:uppercase}dd{margin:3px 0 0;font-size:.78rem}.school-section{margin-top:55px}.school-section.feature{padding:30px;border-left:3px solid #b8953f;background:#fffdf8}.people-grid,.teacher-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.person{overflow:hidden;border:1px solid rgba(18,35,59,.1);border-radius:13px;background:#fff;box-shadow:0 6px 20px rgba(23,38,59,.06)}.person img{width:100%;aspect-ratio:4/3;object-fit:cover}.person>div{padding:14px}.person small,.principal small{color:#9a7429;font-size:.59rem;font-weight:700;text-transform:uppercase}.person h3,.principal h3{margin:4px 0;font-family:var(--font-display,serif)}.person p{color:#737b87;font-size:.7rem;line-height:1.5}.person.compact{display:grid;grid-template-columns:62px 1fr;align-items:center}.person.compact img{width:62px;height:62px;border-radius:50%;margin:10px}.principal{display:grid;grid-template-columns:minmax(220px,340px) 1fr;gap:30px;align-items:center;padding:22px;border:1px solid rgba(18,35,59,.1);border-radius:15px;background:#fff}.principal>img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:10px}.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.photo-grid button{position:relative;aspect-ratio:4/3;overflow:hidden;border:0;border-radius:11px;padding:0;background:#eee}.photo-grid img{width:100%;height:100%;object-fit:cover}.photo-grid span{position:absolute;left:0;right:0;bottom:0;padding:35px 12px 10px;background:linear-gradient(transparent,#0e2038dd);color:#fff;text-align:left;font-size:.68rem}.photo-grid small{position:absolute;top:9px;right:9px;padding:4px 7px;border-radius:99px;background:#142740dd;color:#f1d993}.contact>div{display:flex;flex-wrap:wrap;gap:10px 22px;padding:25px;border-radius:13px;background:#142740;color:#fff}.contact address{width:100%;font-style:normal}.contact a{color:#ead28d}.contact .map{margin-left:auto}@media(max-width:760px){.school-about,.principal{grid-template-columns:1fr}.people-grid,.teacher-grid,.photo-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:500px){.people-grid,.teacher-grid,.photo-grid{grid-template-columns:1fr}.school-about{padding:21px}.principal{padding:15px}}
</style>
