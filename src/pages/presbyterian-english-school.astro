---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProfileImage from '../components/ProfileImage.astro';
import { getEntry } from 'astro:content';
import { renderMarkdown } from '../lib/markdown';

const entry = await getEntry('settings', 'school');
const school = entry?.data as any;
const page = school.page;
const info = school.information;
const management = school.management;
const principal = school.principal;
const teachers = [...(school.teachers || [])].sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0));
const members = [...(management.members || [])].sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0));
const gallery = [...(school.gallery || [])].sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const person = (value: unknown, designation: string) => typeof value === 'string'
  ? { name: value, designation, photo: '' }
  : { name: (value as any)?.name || '', designation, photo: (value as any)?.photo || '' };
const leaders = [person(management.chairman, 'Chairman'), person(management.secretary, 'Secretary')].filter(item => item.name);
const years = [...new Set(gallery.map(item => String(item.year || '')).filter(Boolean))].sort((a, b) => Number(b) - Number(a));
const categories = [...new Set(gallery.map(item => String(item.category || '')).filter(Boolean))].sort();
const hasContact = Boolean(school.contact?.address || school.contact?.phone || school.contact?.email || school.contact?.google_map_link);
---
<BaseLayout title={page.seo_title} description={page.seo_description} activePage="presbyterian-english-school">
  <PageHero title={page.hero_title} subtitle={page.hero_subtitle} image={page.hero_background_image} eyebrow="Presbyterian English School, Sihphir" />
  <main class="school-page max-w-6xl mx-auto px-4 py-9 sm:py-12">
    <section class="school-about reveal">
      <div><span>About the School</span><h2>{info.school_name}</h2>{page.intro_text && <p>{page.intro_text}</p>}</div>
      <dl>
        {info.establishment_year && <div><dt>Established</dt><dd>{info.establishment_year}</dd></div>}
        {info.motto && <div><dt>Motto</dt><dd>{info.motto}</dd></div>}
        {info.address && <div><dt>Address</dt><dd>{info.address}</dd></div>}
        {info.website && <div><dt>Website</dt><dd><a href={info.website}>{info.website}</a></dd></div>}
      </dl>
    </section>

    {school.history && <section class="school-section reveal"><header><span>Our Story</span><h2>History</h2></header><div class="prose" set:html={renderMarkdown(school.history)}></div></section>}
    {school.vision_mission && <section class="school-section feature reveal"><header><span>Our Purpose</span><h2>Vision &amp; Mission</h2></header><div class="prose" set:html={renderMarkdown(school.vision_mission)}></div></section>}

    {(leaders.length > 0 || members.length > 0) && <section class="school-section reveal">
      <header><span>Leadership</span><h2>Management Committee</h2></header>
      <div class="people-grid">
        {leaders.map(item => <article class="person compact"><ProfileImage src={item.photo} alt={item.name} /><div><small>{item.designation}</small><h3>{item.name}</h3></div></article>)}
        {members.map(item => <article class="person compact"><ProfileImage src={item.photo} alt={item.name} /><div><small>{item.designation || 'Member'}</small><h3>{item.name}</h3></div></article>)}
      </div>
    </section>}

    {principal.name && <section class="school-section reveal">
      <header><span>School Leadership</span><h2>Headmaster / Principal</h2></header>
      <article class="principal"><ProfileImage src={principal.photo} alt={principal.name} /><div><small>{principal.designation}</small><h3>{principal.name}</h3>{principal.biography && <div class="prose" set:html={renderMarkdown(principal.biography)}></div>}</div></article>
    </section>}

    {teachers.length > 0 && <section class="school-section reveal">
      <header><span>Our Faculty</span><h2>Teachers</h2></header>
      <div class="teacher-grid">{teachers.map(teacher => <article class="person teacher"><ProfileImage src={teacher.photo} alt={teacher.name} /><div><small>{teacher.designation}{teacher.subject ? ` · ${teacher.subject}` : ''}</small><h3>{teacher.name}</h3>{teacher.biography && <p>{teacher.biography}</p>}</div></article>)}</div>
    </section>}

    {gallery.length > 0 && <section class="school-section gallery-section reveal">
      <header><span>School Life</span><h2>Gallery</h2></header>
      {years.length > 1 && <div class="gallery-filters" aria-label="Gallery filters"><button class="active" type="button" data-gallery-filter="all">All</button>{years.map(year => <button type="button" data-gallery-filter={year}>{year}</button>)}</div>}
      {categories.length > 0 && <label class="category-filter"><span>Category</span><select id="school-gallery-category"><option value="all">All categories</option>{categories.map(category => <option value={category}>{category}</option>)}</select></label>}
      <div class="photo-grid">{gallery.map(photo => <button type="button" data-school-photo data-year={String(photo.year || '')} data-category={photo.category || ''} data-lightbox-src={photo.image} data-lightbox-caption={photo.caption || ''}><img src={photo.image || '/images/profile-placeholder.svg'} alt={photo.caption || 'School gallery image'} loading="lazy" onerror="this.src='/images/profile-placeholder.svg';this.alt=''"/><span>{photo.caption}</span>{photo.year && <small>{photo.year}</small>}</button>)}</div>
    </section>}

    {hasContact && <section class="school-section contact reveal"><header><span>Get in Touch</span><h2>Contact</h2></header><div>{school.contact.address && <address>{school.contact.address}</address>}{school.contact.phone && <a href={`tel:${school.contact.phone}`}>{school.contact.phone}</a>}{school.contact.email && <a href={`mailto:${school.contact.email}`}>{school.contact.email}</a>}{school.contact.google_map_link && <a class="map" href={school.contact.google_map_link} target="_blank" rel="noopener">View on Google Maps →</a>}</div></section>}
  </main>
</BaseLayout>

<script>
  const yearButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]')];
  const category = document.querySelector<HTMLSelectElement>('#school-gallery-category');
  let selectedYear = 'all';
  const filterGallery = () => document.querySelectorAll<HTMLElement>('[data-school-photo]').forEach(item => {
    item.hidden = (selectedYear !== 'all' && item.dataset.year !== selectedYear) || (category?.value !== 'all' && item.dataset.category !== category?.value);
  });
  yearButtons.forEach(button => button.addEventListener('click', () => { selectedYear = button.dataset.galleryFilter || 'all'; yearButtons.forEach(item => item.classList.toggle('active', item === button)); filterGallery(); }));
  category?.addEventListener('change', filterGallery);
</script>

<style>
  .school-page{color:#172941}.school-about{display:grid;grid-template-columns:1.4fr 1fr;gap:35px;padding:30px;border:1px solid rgba(18,35,59,.1);border-radius:15px;background:#fffdf8;box-shadow:0 12px 35px rgba(20,36,58,.07)}header span,.school-about span{color:#9c7628;font-size:.57rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}h2{margin:5px 0 12px;font-family:var(--font-display,serif);font-size:1.65rem}.school-about p,.prose{color:#59677a;font-size:.82rem;line-height:1.75}.school-about dl{margin:0}.school-about dl div{padding:9px 0;border-bottom:1px solid rgba(18,35,59,.09)}dt{color:#8c6b29;font-size:.57rem;font-weight:700;text-transform:uppercase}dd{margin:3px 0 0;font-size:.78rem}.school-section{margin-top:44px}.school-section.feature{padding:30px;border-left:3px solid #b8953f;background:#fffdf8}.people-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.teacher-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.person{overflow:hidden;border:1px solid rgba(18,35,59,.1);border-radius:13px;background:#fff;box-shadow:0 6px 20px rgba(23,38,59,.06)}.person>img{width:100%;aspect-ratio:4/3;object-fit:cover}.person>div{padding:12px}.person small,.principal small{color:#9a7429;font-size:.59rem;font-weight:700;text-transform:uppercase}.person h3,.principal h3{margin:4px 0;font-family:var(--font-display,serif)}.person p{margin:7px 0 0;color:#737b87;font-size:.68rem;line-height:1.45}.person.compact{display:grid;grid-template-columns:62px 1fr;align-items:center}.person.compact>img{width:62px;height:62px;border-radius:50%;margin:10px}.teacher>img{aspect-ratio:4/3;max-height:155px}.teacher h3{font-size:.95rem}.principal{display:grid;grid-template-columns:200px minmax(0,1fr);gap:26px;align-items:center;padding:20px;border:1px solid rgba(18,35,59,.1);border-radius:15px;background:#fff}.principal>img{width:200px;max-height:250px;aspect-ratio:4/5;object-fit:cover;border-radius:10px}.photo-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}.photo-grid button{position:relative;aspect-ratio:4/3;overflow:hidden;border:0;border-radius:10px;padding:0;background:#eee;cursor:zoom-in}.photo-grid img{width:100%;height:100%;object-fit:cover}.photo-grid span{position:absolute;left:0;right:0;bottom:0;padding:30px 10px 8px;background:linear-gradient(transparent,#0e2038dd);color:#fff;text-align:left;font-size:.64rem}.photo-grid small{position:absolute;top:8px;right:8px;padding:3px 6px;border-radius:99px;background:#142740dd;color:#f1d993}.photo-grid button[hidden]{display:none}.gallery-filters{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}.gallery-filters button{border:1px solid rgba(18,35,59,.15);border-radius:99px;padding:6px 10px;background:#fff;color:#526178;font-size:.64rem}.gallery-filters button.active{border-color:#b8953f;background:#142740;color:#fff}.category-filter{display:grid;max-width:220px;gap:4px;margin:0 0 13px}.category-filter span{color:#7c8390;font-size:.56rem;font-weight:700;text-transform:uppercase}.category-filter select{border:1px solid rgba(18,35,59,.16);border-radius:8px;padding:8px;background:#fff}.contact>div{display:flex;flex-wrap:wrap;gap:10px 22px;padding:25px;border-radius:13px;background:#142740;color:#fff}.contact address{width:100%;font-style:normal}.contact a{color:#ead28d}.contact .map{margin-left:auto}@media(max-width:900px){.teacher-grid,.photo-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.school-about{grid-template-columns:1fr}.people-grid,.teacher-grid,.photo-grid{grid-template-columns:repeat(2,1fr)}.principal{grid-template-columns:180px 1fr}.principal>img{width:180px}}@media(max-width:520px){.people-grid,.teacher-grid,.photo-grid{grid-template-columns:1fr}.school-about{padding:21px}.principal{grid-template-columns:1fr;padding:15px}.principal>img{width:190px;margin:auto}.teacher{display:grid;grid-template-columns:110px 1fr;align-items:center}.teacher>img{width:110px;height:110px}.school-section{margin-top:36px}}
</style>
